 !NOGOBLINPOX!

 : Specialist's Mastery bonus :
 IF (Retort(W,Specialist)=0) THEN { GOTO "NOTSPECIALIST"; }

  IF ( (SPELLSTATE(W,SGaiaMastery)=2) %AND (GETSTAT(U,SRace,0)=RCNature) )
   %OR ( (SPELLSTATE(W,SAEtherMastery)=2) %AND (GETSTAT(U,SRace,0)=RCSorcery) )
   %OR ( (SPELLSTATE(W,SLifeMastery)=2) %AND ( (GETSTAT(U,SRace,0)=RCLife) %OR ( (GetEnchantmentFlag(U,EncSanctify,0)>0) %AND (GETSTAT(U,SCustomAttribute,1)=2) ) ) )
   %OR ( (SPELLSTATE(W,SChaosMastery)=2) %AND ( (GETSTAT(U,SRace,0)=RCChaos) %OR (GetEnchantmentFlag(U,EncCCBreath,0)>0) %OR (GetEnchantmentFlag(U,EncCCFlight,0)>0) %OR (GetEnchantmentFlag(U,EncCCArmor,0)>0) %OR ( (GetEnchantmentFlag(U,EncFieryFury,0)>0) %AND FANTASTIC(U) ) ) )
   %OR ( (SPELLSTATE(W,SDeathMastery)=2) %AND ( (GETSTAT(U,SRace,0)=RCDeath) %OR (GetEnchantmentFlag(U,EncUndead,0)>0) %OR (GetEnchantmentFlag(U,EncRevenant,0)>0) %OR (GetEnchantmentFlag(U,EncVampirism,0)>0) ) )
  THEN {
   SETSTAT( U,SToHit,0,(GetStat(U,SToHit,0)+10) );
   SETSTAT( U,SToDefend,0,(GetStat(U,SToDefend,0)+10) );
   SETSTAT( U,SResist,0,(GetStat(U,SResist,0)+2) );
   SETSTAT( U,SResistBuff,0,(GetStat(U,SResistBuff,0)+2) );
  }

 !NOTSPECIALIST!

 : Guardian's Lord Protector bonus :
 IF (Retort(W,Guardian)=0) THEN { GOTO "NOTGUARDIAN"; }

  IF (SPELLSTATE(W,SLordProtector)<>2)
   %OR ( OVERLANDACTIVEPLAYER = W )
  THEN { GOTO "NOTGUARDIAN"; }

   IF ( (C=0) %OR ( (C>0) %AND ( CITYRACE(C) <> HOMERACE(W) ) )
    %AND ( GETSTAT(U,SRace,1) = HOMERACE(W) )
   THEN {
    SETSTAT( U,SToHit,0,(GetStat(U,SToHit,0)+10) );
    SETSTAT( U,SToDefend,0,(GetStat(U,SToDefend,0)+10) );
    SETSTAT( U,SResist,0,(GetStat(U,SResist,0)+1) );
    SETSTAT( U,SResistBuff,0,(GetStat(U,SResistBuff,0)+1) );
   }

 !NOTGUARDIAN!

 : Effect of Lucky Star on other friendly units :
 IF (LUCKYSTAR=0) THEN { GOTO "NOLUCKYSTAR"; }

  SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+1));
  SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+1));
  SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+1));
  SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+1));
  SETSTAT(U,SDefense,0,(GetStat(U,SDefense,0)+1));
  SETSTAT(U,SDefenseBuff,0,(GetStat(U,SDefenseBuff,0)+1));
  SETSTAT(U,SResist,0,(GetStat(U,SResist,0)+1));
  SETSTAT(U,SResistBuff,0,(GetStat(U,SResistBuff,0)+1));

 !NOLUCKYSTAR!

 IF (C<1) THEN { GOTO "NOTCITY"; }

  IF (W=A) THEN { GOTO "NOTDEFENDER"; }

   : New effect of Dishearten Prophacy, city defender suffer -2 Resistance :
   IF (CITYENCHANT(C,CEDisheartenProphesy)>0) THEN {
    SETSTAT(U,SResist,0, GETSTAT(U,SResist,0) - 2 );
    SETSTAT(U,SResistPenalty,0, GETSTAT(U,SResistPenalty,0) + 2 );
   }

   : New effect of Wall of Fire, get old metal fire effect for defender, effect not stack with flame blade :
   IF (CITYENCHANT(C,CEWallofFire)<0) THEN { GOTO "NOWALLOFFIRE"; } 

    IF (BASEFANTASTIC(U)>0) THEN { GOTO "NOWALLOFFIRE"; }

     SETENCHANTMENTFLAG(U,EncMagic,0,1);
     SETSTAT(U,SAttack,0,((GetStat(U,SAttack,0))+1));
     SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+1));
     IF (GetStat(U,SRangedType,0)>0) %AND (GetStat(U,SRangedType,0)<30) THEN {
      SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+1));
      SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+1));
     }
     IF GETSTAT(U,SThrown,0)>0 THEN {
      SETSTAT(U,SThrown,0,(GetStat(U,SThrown,0)+1));
     }

   !NOWALLOFFIRE!

   : Effect of Gospel of Evangelism, -2% To-Hit and 0.4 Resistance for each unrest pop in the city. :
   IF (CITYENCHANT(C,CEGospelOfEvangelism)<>A) THEN { GOTO "NOTGOSPEL"; }

    GOSPELHIT=2*(GETCITYDATA(C,CDUNREST));
    GOSPELRESIST=%I(0.4*(GETCITYDATA(C,CDUNREST)));

    SETSTAT(U,SToHit,0, GETSTAT(U,SToHit,0) - GOSPELHIT );
    SETSTAT(U,SResist,0, GETSTAT(U,SResist,0) - GOSPELRESIST );
    SETSTAT(U,SResistPenalty,0, GETSTAT(U,SResistPenalty,0) + GOSPELRESIST );

   !NOTGOSPEL!

   : Debuff from Attacker's Lord Liberator :
   IF (SPELLSTATE(A,SLordLiberator)<>2) THEN { GOTO "NOLIBERATOR"; }

    GUARDIANSUBJECT=0;

    FOR CITY=1 TO MAXCITY();

     IF (CITYOWNER(CITY)=A) %AND ( CITYRACE(CITY) = CITYRACE(C) ) THEN { GUARDIANSUBJECT=GUARDIANSUBJECT+1; }

    NEXT CITY;

    IF ( CITYRACE(C) <> HOMERACE(A) ) %AND (GUARDIANSUBJECT=0) THEN { GOTO "NOLIBERATOR"; }

     SETSTAT( U,SAttack,0,(GetStat(U,SAttack,0)-1) );
     SETSTAT( U,SAttackPenalty,0,(GetStat(U,SAttackPenalty,0)+1) );
     SETSTAT( U,SRanged,0,(GetStat(U,SRanged,0)-1) );
     SETSTAT( U,SRangedPenalty,0,(GetStat(U,SRangedPenalty,0)+1) );
     SETSTAT( U,SDefense,0,(GetStat(U,SDefense,0)-1) );
     SETSTAT( U,SDefensePenalty,0,(GetStat(U,SDefensePenalty,0)+1) );
     SETSTAT( U,SResist,0,(GetStat(U,SResist,0)-1) );
     SETSTAT( U,SResistPenalty,0,(GetStat(U,SResistPenalty,0)+1) );

   !NOLIBERATOR!

  !NOTDEFENDER!

 !NOTCITY!

 : bonus below only for for tactical combat :
 IF (TACTICALCOMBAT=0) THEN { GOTO "NOTTACTICALCOMBAT"; }

  : Effect of score option "Gods Play Dices" :
  IF (SCORINGOPTION(SGodsPlayDices)=0) THEN { GOTO "GODNOTPLAYDICE"; }

   IF (GetCombatEnchantmentFlag(U,EncDICE1,0)>0) THEN {
    SETSTAT(U,SResist,0,(GETSTAT(U,SResist,0)-1);
    SETSTAT(U,SResistPenalty,0,(GETSTAT(U,SResistPenalty,0)+1);
   }
   IF (GetCombatEnchantmentFlag(U,EncDICE2,0)>0) THEN {
    SETSTAT(U,SResist,0,(GETSTAT(U,SResist,0)-2);
    SETSTAT(U,SResistPenalty,0,(GETSTAT(U,SResistPenalty,0)+2);
   }
   IF (GetCombatEnchantmentFlag(U,EncDICE3,0)>0) THEN {
    SETSTAT(U,SResist,0,(GETSTAT(U,SResist,0)+1);
    SETSTAT(U,SResistBuff,0,(GETSTAT(U,SResistBuff,0)+1);
   }
   IF (GetCombatEnchantmentFlag(U,EncDICE4,0)>0) THEN {
    SETSTAT(U,SResist,0,(GETSTAT(U,SResist,0)+2);
    SETSTAT(U,SResistBuff,0,(GETSTAT(U,SResistBuff,0)+2);
   }

  !GODNOTPLAYDICE!

  : Water Elemental and elementalist hero get buff on wet or water tile :
  IF (GETSTAT(U,STypeID,1)<>158) %AND (GETSTAT(U,STypeID,1)<>285) THEN { GOTO "NOTWATERELEMENTALTACTIC"; }

   IF (CT=CTIce)
    %OR (CT=CTSwamp)
    %OR (CT=CTFloating)
   THEN {
    SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+1));
    SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+1));
    SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+1));
    SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+1));
    GOTO "NOTWATERELEMENTALTACTIC";
   }

   IF (CT<>CTSea) THEN { GOTO "NOTWATERELEMENTALTACTIC"; }

    SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+2));
    SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+2));
    SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+2));
    SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+2));
    SETSTAT(U,SThrown,0, (GetStat(U,SThrown,0)+%I(GetStat(U,SRanged,0)/2) ));

  !NOTWATERELEMENTALTACTIC!

  : new effect of Inner Power, all units gain mountaineer in combat :
  IF (HASGLOBAL(W,GEInnerPower)=0) THEN { GOTO "NOINNERPOWER"; }

   IF (GetStat(U,AMountaineer,0)=0) THEN {
    SETSTAT(U,AMountaineer,0,1);
   }

  !NOINNERPOWER!

  : Effect of Eye of Storm on Other Units :
  IF (GETENCHANTMENTFLAG(U,EncEyeOfStorm,1)>0) THEN {
   SETSTAT(U,SLordOfStorm,0,1);
   SETSTAT(U,AColdImmunity,0,1);
  }

  : New unit enchantment "Revenant", gain death touch 0 (melee only), regeneration 1, and permanently become undead :
  IF (GetEnchantmentFlag(U,EncRevenant,0)=0) THEN { GOTO "NOTREVENANT"; }

   SETSTAT(U,AFDeathTouch,0,100,1);
   SETSTAT(U,AFDeathTouch,0,100,3);
   SETSTAT(U,AFDeathTouch,0,0,2);
   IF ((GetStat(U,SRegeneration,0))>-1) THEN { SETSTAT(U,SRegeneration,0,(GetStat(U,SRegeneration,0)+1)); }
   IF ((GetStat(U,SRegeneration,0))<=-1) THEN { SETSTAT(U,SRegeneration,0,1); }

  !NOTREVENANT!

  : Mariner Mastery bonus from waterwalking or swimming in combat get +1 movement :
  IF (HASGLOBAL(W,GEMarinerMastery)=0) THEN { GOTO "NOMARINERMASTERY"; }

   IF ( (GetStat(U,AWaterwalking,1)>0) %OR (GETENCHANTMENTFLAG(U,EncWaterWalking,0)>0) )
    %AND (GETTERRAIN(1,11,0)=CTSea)
   THEN {
    SETSTAT(U,SCombatMaxMoves,0,(GetStat(U,SCombatMaxMoves,0)+2));
    SETSTAT(U,SCombatMovesLeft,0,(GetStat(U,SCombatMovesLeft,0)+2));
   }

  !NOMARINERMASTERY!

  GOTO "ENDOFCOMBAT";

 !NOTTACTICALCOMBAT!

  : Water Elemental and elementalist hero get buff on wet or water terrain in strategic combat :
  IF (GETSTAT(U,STypeID,1)<>158) %AND (GETSTAT(U,STypeID,1)<>285) THEN { GOTO "NOTWATERELEMENTALAUTO"; }

   IF (LT=LTSwamp)
    %OR (LT=LTTundra)
    %OR (LT=LTRiver)
    %OR (LT=LTSorceryNode)
    %OR (LT=LTRiverStart)
   THEN {
    SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+1));
    SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+1));
    SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+1));
    SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+1));
    GOTO "NOTWATERELEMENTALAUTO";
   }

   IF (LT>3) THEN { GOTO "NOTWATERELEMENTALAUTO"; }

    SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+2));
    SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+2));
    SETSTAT(U,SRanged,0,(GetStat(U,SRanged,0)+2));
    SETSTAT(U,SRangedBuff,0,(GetStat(U,SRangedBuff,0)+2));
    SETSTAT(U,SThrown,0, (GetStat(U,SThrown,0)+%I(GetStat(U,SRanged,0)/2) ));

  !NOTWATERELEMENTALAUTO!

  IF ( (RETORT(W,Tactician)>0) %OR ( (SCORINGOPTION(SKhanTheConqueror)=1) %AND (W=NeutralPlayerID) ) THEN {
   SETSTAT(U,AFirstStrike,0,1);
   SETSTAT(U,SAttack,0,(GetStat(U,SAttack,0)+1));
   SETSTAT(U,SAttackBonus,0,(GetStat(U,SAttackBonus,0)+1));
   SETSTAT(U,SDefense,0,(GetStat(U,SDefense,0)+1));
   SETSTAT(U,SDefenseBuff,0,(GetStat(U,SDefenseBuff,0)+1));
  }

  : Check if strategic combat is siege or not :
  IF (C<1) THEN { GOTO "ENDOFCOMBAT"; }

   : bonus for fortification in strategic combat :
   IF (ISBUILT(C,BMoats)) %AND (W=D) THEN {
    SETSTAT(U,SDefense,0,(GetStat(U,SDefense,0)+4));
    SETSTAT(U,SDefenseBuff,0,(GetStat(U,SDefenseBuff,0)+4));
    IF (GETSTAT(U,ALargeShield,0)>0) THEN { SETSTAT(U,AMissileImmunity,0,1); } ELSE { SETSTAT(U,ALargeShield,0,1); }
   }

  : bonus for hillfort in strategic combat :
   IF (ISBUILT(C,BHillfort)) %AND (W=D) THEN {
    SETSTAT(U,SDefense,0,(GetStat(U,SDefense,0)+3));
    SETSTAT(U,SDefenseBuff,0,(GetStat(U,SDefenseBuff,0)+3));
    SETSTAT(U,AMissileImmunity,0,1);
   }


: End of Combat Part :
!ENDOFCOMBAT!

  : New combat enchantment "Eye of Heaven", all friendly units gain True Sight while enemy lose all gaze ability :
  IF (HASCOMBATGLOBAL(W,CGEyeOfHeaven,1)>0) THEN {
   SETENCHANTMENTFLAG(U,EncTrueSight,0,1);
  }

HALT;

: Below is only trigger outside combat :

!NOTCOMBAT!

: Remove strategic recall flag for Strategic Recall :
IF (GETOLENCHANTMENTFLAG(U,EncStrategicRecall,1)>0) THEN {
 SETOLENCHANTMENTFLAG(U,EncStrategicRecall,1,0);
}

: Plane carry is only planewalk for 1 turn :
IF (GETENCHANTMENTFLAG(U,EncPlaneCarry,1)=0) THEN { GOTO "NOTPLANECARRY"; }

 SETSTAT(U,APlaneShifting,0,1);

 IF ( OVERLANDACTIVEPLAYER = W ) THEN { GOTO "NOTPLANECARRY"; }

  SETENCHANTMENTFLAG(U,EncPlaneCarry,1,0);
  SETSTAT(U,APlaneShifting,0,0);

!NOTPLANECARRY!

: Content below only occur in their owner's turn :
IF ( OVERLANDACTIVEPLAYER <> W ) THEN { HALT; }

 : Fix Holy Mother in case she does not get Highwind walking, such as mercenary :
 IF (GetStat(U,STypeID,1)<>323) THEN { GOTO "NOTHOLYMOTHER"; }

  IF (GETENCHANTMENTFLAG(U,EncWindWalking,1)=0) THEN {
   SETENCHANTMENTFLAG(U,EncWindWalking,1,1);
   SETSTAT(U,SOLMovesLeft,1,(GetStat(U,SOLMovesLeft,1)+6));
  }
  HALT;

 !NOTHOLYMOTHER!

 : Fix Squires in case she does not get Caravan Logistic, such as mercenary :
 IF (GetStat(U,STypeID,1)<>212) THEN { GOTO "NOTSQUIRE"; }

  IF (GetStat(U,SCaravanLogistic,1)=0) THEN {
   SETSTAT(U,SCaravanLogistic,1,1)
   SETSTAT(U,SOLMaxMoves,1,(GetStat(U,SOLMaxMoves,1)+4));
   SETSTAT(U,SOLMovesLeft,1,(GetStat(U,SOLMovesLeft,1)+4));
  }
  HALT;

 !NOTSQUIRE!

 : Fix Glider in case she does not get guardian wind, such as mercenary  :
 IF (GetStat(U,STypeID,1)<>360) THEN { GOTO "NOTGLIDER"; }

  IF (GETENCHANTMENTFLAG(U,EncGuardianWind,1)=0)THEN {
   SETENCHANTMENTFLAG(U,EncGuardianWind,1,1)
  }
  HALT;

 !NOTGLIDER!


HALT;
