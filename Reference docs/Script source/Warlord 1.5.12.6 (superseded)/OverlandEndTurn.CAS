!NOTOUTLANDERWIZARD!

: Threat Perception Script :
: 4 levels of threat, 1=enemy only, 2=everyone without countermeasure, 3=indiscriminate, 4=indiscriminately severe :
THREATLVL1=3*( (HASGLOBAL(W,GESeismicMastery)) + (HASGLOBAL(W,GEGreatUnbinding)) + (HASGLOBAL(W,GEDeathReckoning)) );
THREATLVL2=5*( (HASGLOBAL(W,GECallTheWild)) + (HASGLOBAL(W,GEDivineOrder)) + (HASGLOBAL(W,GEEternalNight)) + (HASGLOBAL(W,GEKingOfUnderworld)) );
THREATLVL3=8*( (HASGLOBAL(W,GETimeStop)) + (HASGLOBAL(W,GEBlazingEyes)) + (HASGLOBAL(W,GEEvilOmens)) + (HASGLOBAL(W,GEDarkestHour)) + (HASGLOBAL(W,GEEnlightenment)) );
THREATLVL4=13*( (HASGLOBAL(W,GEIceAge)) + (HASGLOBAL(W,GEDoomsday)) + (HASGLOBAL(W,GEMeteorStorm)) + (HASGLOBAL(W,GEArmageddon)) );
GLOBALTHREAT=THREATLVL1 + THREATLVL2 + THREATLVL3 + THREATLVL4;
FAVORNATURE=(HASGLOBAL(W,GERootsofGenesis));
FAVORCHAOS=( (HASGLOBAL(W,GEChaosSurge)) + (HASGLOBAL(W,GEBlazingEyes)) );
FAVORLIFE=(HASGLOBAL(W,GEDivineOrder));
FAVORDEATH=(HASGLOBAL(W,GEEternalNight));

SETWIZARDDATA(W,WDGlobalThreat,GLOBALTHREAT);

IF GLOBALTHREAT=0 THEN { GOTO "NOTGLOBALTHREAT"; }

 FOR I=0 TO NOFWIZARDS();
 
  IF (I<>W) THEN {
 
   TT=GLOBALTHREAT-%I(( (BOOKS(I,1)*FAVORNATURE)+(BOOKS(I,3)*FAVORCHAOS)+(BOOKS(I,4)*FAVORLIFE)+(BOOKS(I,5)*FAVORDEATH) )/2);

   IF (RETORT(W,Charismatic)=1) THEN {
    IF (TT>0) THEN { TT=(TT/2); } ELSE { TT=(TT*2); }
   }

   IF (TT>0) THEN {
    DRWI=(GETDIPVAR(I,W,1))-%I(TT/2);
   } ELSE {
    DRWI=(GETDIPVAR(I,W,1))-%I(TT/10);
   }

   IF (DRWI>100) THEN { DRWI=100; }
   IF (DRWI<-100) THEN { DRWI=-100; }

   SETDIPVAR(I,W,1,DRWI);
   IF (TT>0) THEN {

    FOR J=0 TO NOFWIZARDS();

     IF (J<>W) %AND (J<>I) THEN {
      DRIJ=(GETDIPVAR(I,J,1))+%I(TT/10);
      IF (DRIJ>100) THEN { DRIJ=100; }
      IF (DRIJ<-100) THEN { DRIJ=-100; }
      SETDIPVAR(I,J,1,DRIJ);
     }

    NEXT J;
   }
   IF (TT>10) %AND ( (GETDIPVAR(I,W,2)<1) %OR (GETDIPVAR(I,W,2)>2) ) %AND (GETDIPVAR(I,W,3)<1) THEN {
    IF (RND(4)=3) THEN { SETDIPVAR( I,W,3,1 ); }
   }
   IF (TT>20) %AND ( (GETDIPVAR(I,W,2)<1) %OR (GETDIPVAR(I,W,2)>2) ) %AND (GETDIPVAR(I,W,3)<2) THEN {
    IF (RND(3)=2) THEN { SETDIPVAR( I,W,3,(GETDIPVAR(I,W,3)+1 ); }
   }
   IF (TT>30) %AND ( (GETDIPVAR(I,W,2)<1) %OR (GETDIPVAR(I,W,2)>2) ) %AND (GETDIPVAR(I,W,3)<3) THEN {
    IF (RND(2)=1) THEN { SETDIPVAR( I,W,3,(GETDIPVAR(I,W,3)+1 ); }
   }

  }

NEXT I;

!NOTGLOBALTHREAT!

: Overland active Turn record and Time Stop count :
IF (TIMESTOPCOUNT>0) THEN {
 IF HASGLOBAL(W,GETimeStop) THEN { MASTERVARSET TSTURNCOUNTING = TSTURNCOUNTING + 1; }
} ELSE {
 LOOP {
  B=1;
  IF (W=NeutralPlayerID)
   %OR (OVERLANDACTIVEPLAYER>=NOFWIZARDS())
  THEN {
   MASTERVARSET OVERLANDACTIVEPLAYER = 0;
  } ELSE {
   MASTERVARSET OVERLANDACTIVEPLAYER = OVERLANDACTIVEPLAYER + 1;
  }
  IF (DEFEATED(OVERLANDACTIVEPLAYER)=0) %OR (OVERLANDACTIVEPLAYER=0) THEN { B=0; }
 } ENDLP (B=0);
 DEBUGLOG "OVERLAND ACTIVE SIDE = " + STRS(OVERLANDACTIVEPLAYER);
}

: process end of the month at player turn due to it is only player that always active :
IF (W<>0) %OR (HASGLOBAL(W,GETimeStop)>0) THEN { GOTO "NOTENDOFMONTH"; }

DEBUGLOG "TRIGGER END OF MONTH SCRIPT";

: Remove marker global enchantment :
 IF HASGLOBAL(0,GENatureBookFound) THEN { SETGLOBAL(0,GENatureBookFound,0); }
 IF HASGLOBAL(0,GESorceryBookFound) THEN { SETGLOBAL(0,GESorceryBookFound,0); }
 IF HASGLOBAL(0,GEChaosBookFound) THEN { SETGLOBAL(0,GEChaosBookFound,0); }
 IF HASGLOBAL(0,GELifeBookFound) THEN { SETGLOBAL(0,GELifeBookFound,0); }
 IF HASGLOBAL(0,GEDeathBookFound) THEN { SETGLOBAL(0,GEDeathBookFound,0); }
 IF HASGLOBAL(0,GESpecialistLearned) THEN { SETGLOBAL(0,GESpecialistLearned,0); }

 : FOR I=0 TO NOFWIZARDS();

  IF HASGLOBAL(I,GECultRetribution) THEN { SETGLOBAL(I,GECultRetribution,0); }

 NEXT I; :

 DEBUGLOG "TRIGGER Mixed Stack Correction Script";

 : Mixed Stack correction script :
 FOR U=1 TO MAXUNIT();

  W=GetStat(U,SOwner,1);
  UP=GETSTAT(U,SPlane,1);
  UX=GETSTAT(U,SOLX,1);
  UY=GETSTAT(U,SOLY,1);
  UA=UNITONTILE(UP,UX,UY,1);
  C=CITYONTILE(U);

  IF (C<1) THEN { GOTO "NOTCITY"; }

   IF ( W = CITYOWNER(C) ) THEN { GOTO "NOTLOCATION"; }

    DEBUGLOG "Unit ID with wrong ownership: " + STRS(U) + ", P=" + STRS(UP) + ", X=" + STRS(UX) + ", Y=" + STRS(UY);
    DEBUGLOG "Previous owner: " + STRS(W) + ", " + WIZNAME(W);
    SETSTAT( U,SOwner,1,CITYOWNER(C) );
    DEBUGLOG "Current owner: " + STRS(CITYOWNER(C)) + ", " + WIZNAME(CITYOWNER(C));
    GOTO "NOTLOCATION";

  !NOTCITY!

  IF ( U = UA ) THEN { GOTO "NOTLOCATION"; }

   IF ( W = GETSTAT(UA,SOwner,1) ) THEN { GOTO "NOTLOCATION"; }

    DEBUGLOG "Unit ID with wrong ownership: " + STRS(U) + ", P=" + STRS(UP) + ", X=" + STRS(UX) + ", Y=" + STRS(UY);
    DEBUGLOG "Previous owner: " + STRS(W) + ", " + WIZNAME(W);
    SETSTAT( U,SOwner,1,GETSTAT(UA,SOwner,1) );
    DEBUGLOG "Current owner: " + STRS(GETSTAT(UA,SOwner,1)) + ", " + WIZNAME(GETSTAT(UA,SOwner,1));

  !NOTLOCATION!

 NEXT U;

: at the end of the month, forest/tundra tile in vincinity of the city own by wizard casting Root of Genesis has 0.5% chance to spawn wild game and river spawn nightshade :
: Gaia's Blessing has 10% chance of convert tundra into swamp each turn :
 C=0;
 FOR C=1 TO MAXCITY();

  IF (ICEAGECOUNT=0) %OR ( HASGLOBAL(CITYOWNER(C),GEIceAge) > 0 ) THEN { GOTO "NOTICEAGE"; }

   DEBUGLOG "TRIGGER Ice Age Conversion grassland, desert, swamp, and hill into tundra script";

   P=GETCITYDATA(C,CDCOLP);
   CONVERT=3*ICEAGECOUNT;

   FOR X=(GETCITYDATA(C,CDCOLX)-2) TO (GETCITYDATA(C,CDCOLX)+2);
   FOR Y=(GETCITYDATA(C,CDCOLY)-2) TO (GETCITYDATA(C,CDCOLY)+2);

    IF ( ( GETTERRAIN( X,Y,P ) ) < LTGrassland ) THEN { GOTO "NOTTURNTUNDRA"; }
    IF ( ( GETTERRAIN( X,Y,P ) ) > LTHill ) %AND ( ( GETTERRAIN( X,Y,P ) ) < LTDesert ) THEN { GOTO "NOTTURNTUNDRA"; }
    IF ( ( GETTERRAIN( X,Y,P ) ) > LTSwamp ) THEN { GOTO "NOTTURNTUNDRA"; }

     IF ( RND(100) > (99-CONVERT) ) THEN { SETTERRAIN(X,Y,P,LTTundra); }

    !NOTTURNTUNDRA!

   NEXT Y;
   NEXT X;

  !NOTICEAGE!

  IF ( HASGLOBAL(CITYOWNER(C),GERootsofGenesis) = 0 ) THEN { GOTO "NOROOTSOFGENESIS"; }

   DEBUGLOG "TRIGGER resource spawning from Roots of Genesis";

   P=GETCITYDATA(C,CDCOLP);

   FOR X=(GETCITYDATA(C,CDCOLX)-2) TO (GETCITYDATA(C,CDCOLX)+2);
   FOR Y=(GETCITYDATA(C,CDCOLY)-2) TO (GETCITYDATA(C,CDCOLY)+2);

    IF ( ( ( GETTERRAIN( X,Y,P ) ) > LTForest ) %OR ( ( GETTERRAIN( X,Y,P ) ) < LTRiver ) ) THEN { GOTO "NOTGAINRESOURCE1"; }

     IF ( ( GETTERRAIN( X,Y,(P+2) ) ) > 0 ) THEN { GOTO "NOTGAINRESOURCE1"; }

      RESOURCE=RND(200);
      IF (RESOURCE<199) THEN { GOTO "NOTGAINRESOURCE1"; }

       IF ( ( GETTERRAIN( X,Y,P ) ) = LTRiver ) THEN {
        SETTERRAIN(X,Y,(P+2),OreNightshade);
       } ELSE {
        SETTERRAIN(X,Y,(P+2),OreWildgame);
       }

    !NOTGAINRESOURCE1!

   NEXT Y;
   NEXT X;

  !NOROOTSOFGENESIS!

  IF ( HASGLOBAL(CITYOWNER(C),GEIceAge) = 0 ) THEN { GOTO "NOICEAGESPAWNING"; }

   DEBUGLOG "TRIGGER resource spawning from Ice Age";

   P=GETCITYDATA(C,CDCOLP);

   FOR X=(GETCITYDATA(C,CDCOLX)-2) TO (GETCITYDATA(C,CDCOLX)+2);
   FOR Y=(GETCITYDATA(C,CDCOLY)-2) TO (GETCITYDATA(C,CDCOLY)+2);

    IF ( ( GETTERRAIN( X,Y,P ) ) <> LTTundra ) THEN { GOTO "NOTGAINRESOURCE2"; }

     IF ( ( GETTERRAIN( X,Y,(P+2) ) ) > 0 ) THEN { GOTO "NOTGAINRESOURCE2"; }

      RESOURCE=RND(100);
      IF (RESOURCE<99) THEN { GOTO "NOTGAINRESOURCE2"; }

       IF ( ( GETTERRAIN( X,Y,P ) ) = LTTundra ) THEN {
        SETTERRAIN(X,Y,(P+2),OreWildgame);
       }

    !NOTGAINRESOURCE2!

   NEXT Y;
   NEXT X;

  !NOICEAGESPAWNING!

  IF ( CITYENCHANT(C,CEGaiasBlessing) < 0 ) THEN { GOTO "NOTUNDRASWAMP"; }

   DEBUGLOG "TRIGGER Gaia Conversion tundra into swamp script";

   P=GETCITYDATA(C,CDCOLP);

   FOR X=(GETCITYDATA(C,CDCOLX)-2) TO (GETCITYDATA(C,CDCOLX)+2);
   FOR Y=(GETCITYDATA(C,CDCOLY)-2) TO (GETCITYDATA(C,CDCOLY)+2);

    IF ( ( GETTERRAIN( X,Y,P ) ) <> LTTundra ) THEN { GOTO "NOTTUNDRA"; }

     IF (RND(100)>89) THEN { SETTERRAIN(X,Y,P,LTSwamp); }

    !NOTTUNDRA!

   NEXT Y;
   NEXT X;

  !NOTUNDRASWAMP!

  IF (BASETURN()<25) %OR (CLIMATE()<>CliDry) THEN { GOTO "NODRYMODIFY"; }

   IF ( (CITYENCHANT(C,CEDrought)>-1) %AND (CITYENCHANT(C,CEDrought)<NeutralPlayerID) ) THEN { GOTO "NODRYMODIFY"; }

    P=GETCITYDATA(C,CDCOLP);
    ARID=TERRAININRANGE(C,LTDesert)/2;
    ARIDSTR=RND(100);

    IF (CITYENCHANT(C,CEDrought)=NeutralPlayerID) THEN {
     IF (CITYOWNER(C)=NeutralPlayerID)
      %OR ( ARIDSTR > 90 )
     THEN {
      SETCITYENCHANTOWNER(C,CEDrought,-1);
     }
    } ELSE {
     IF (CITYOWNER(C)<NeutralPlayerID)
      %AND ( ARIDSTR < ARID )
     THEN {
      SETCITYENCHANTOWNER(C,CEDrought,NeutralPlayerID);
     }
    }

  !NODRYMODIFY!

 NEXT C;


: at the end of the month, 3% of corrupted land decay into wasteland :
: at the end of the month, Volcanic climate or Armageddon active would trigger volcanic eruption in hill or mountain tile at rate 1% per turn :

 DEBUGLOG "TRIGGER Corruption Decay";

 FOR P=1 TO 2;
 FOR X=0 TO PLANESIZEX(P);
 FOR Y=0 TO PLANESIZEY(P);

  IF ((GETTERRAIN(X,Y,P))<LTGrassland) THEN { GOTO "NOTERRAINCHANGE"; }
  IF ((GETTERRAIN(X,Y,P))>LTForest) THEN { GOTO "NOTERRAINCHANGE"; }

   IF ((GETTERRAIN(X,Y,P+4))=0) THEN { GOTO "NODECAY"; }
    IF ( ((GETTERRAIN(X,Y,P))>LTHill) %AND ((GETTERRAIN(X,Y,P))<>LTForest) ) THEN { GOTO "NODECAY"; }

     DECAY=RND(100);
     IF (DECAY<97) THEN { GOTO "NODECAY"; }

      IF ((GETTERRAIN(X,Y,P))=LTGrassland) THEN { SETTERRAIN(X,Y,P,LTDesert); }
      IF ((GETTERRAIN(X,Y,P))=LTHill) THEN { SETTERRAIN(X,Y,P,LTMountain); }
      IF ((GETTERRAIN(X,Y,P))=LTForest) THEN { SETTERRAIN(X,Y,P,LTSwamp); }

   !NODECAY!

   IF (ARMAGEDDONCOUNT=0) %AND (CLIMATE()<>CliVolcanic) THEN { GOTO "NOVOLCANICTRIGGER"; }

    IF ((GETTERRAIN(X,Y,P))=LTVolcano)
     %AND (RND(100)<3)
    THEN {
     SETTERRAIN(X,Y,P,LTMountain);
     GOTO "NOVOLCANICTRIGGER";
    }

    IF ((GETTERRAIN(X,Y,P))=LTMountain)
     %AND (RND(100)=99)
    THEN {
     SETTERRAIN(X,Y,P,LTVolcano);
    }

   !NOVOLCANICTRIGGER!

  !NOTERRAINCHANGE!

 NEXT Y;
 NEXT X;
 NEXT P;

!NOTENDOFMONTH!

DEBUGLOG "END OF END OF TURN SCRIPT";

HALT;
