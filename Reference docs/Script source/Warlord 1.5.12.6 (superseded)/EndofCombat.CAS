  SETSPELLDATA(I,SArmageddon,0);

  SETSPELLDATA(I,SWarpNode,0);
  SETSPELLDATA(I,SEvilPresence,0);
  SETSPELLDATA(I,SDrought,0);
  SETSPELLDATA(I,SPestilence,0);

  SETSPELLDATA(I,SDisillusionise,0);
  SETSPELLDATA(I,SAetherSink,0);

  SETSPELLDATA(I,SInquisition,0);

 NEXT I;

!NOEVERYTHINGNICE!

: Reset all variable at the end of combat :
: Reset tactical combat :
MASTERVARSET TACTICALCOMBAT = 0;

: Reset Combat turn :
MASTERVARSET COMBATTURN = 0;

: Reset Combat active side :
MASTERVARSET COMBATACTIVESIDE = 0;

: Reset sneak attack counter :
MASTERVARSET SNEAKATTACK = 0;

: Reset hill counter :
MASTERVARSET ROCKYHILLCOMBAT = 0;

: Reset river counter :
MASTERVARSET SWAMPYRIVERCOMBAT = 0;

: Reset wet grassland counter :
MASTERVARSET WETGRASSLANDCOMBAT = 0;

: Reset wet forest counter :
MASTERVARSET WETFORESTCOMBAT = 0;

: Reset icy sea counter :
MASTERVARSET ICYSEACOMBAT = 0;

: Reset icy mountain counter :
MASTERVARSET ICYMOUNTAINCOMBAT = 0;

: Reset green volcano counter :
MASTERVARSET GREENVOLCANOCOMBAT = 0;

: Reset deadly volcano counter :
MASTERVARSET DEADLYVOLCANOCOMBAT = 0;

: Reset winter forest counter :
MASTERVARSET WINTERFOREST = 0;

: Reset corrupt tile counter :
MASTERVARSET CORRUPTTILECOMBAT = 0;

: Reset moat counter :
MASTERVARSET MOATCOMBAT = 0;

: Reset hillfort counter :
MASTERVARSET HILLFORTCOMBAT = 0;

: Reset baray counter :
MASTERVARSET BARAYCOMBAT = 0;

DEBUGLOG "END OF END OF COMBAT SCRIPT";

HALT;
