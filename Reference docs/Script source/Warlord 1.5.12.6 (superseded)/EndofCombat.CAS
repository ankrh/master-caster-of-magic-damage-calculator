: INPUT - Endtype -	1 means a tie
		2 means someone won the battle
		3 means retreating exhausted
		4 means fleeing
	Winner - The wizard ID for the player who won the battle
	Loser  - Same for the loser.
  OUTPUT - None
		:

A=ATTACKER();
D=DEFENDER();
C=Cityontile(combatP(),combatX(),combatY());

DEBUGLOG "TRIGGER OF END OF COMBAT SCRIPT";

WANDERERA = 0;
WANDERERD = 0;

FOR U=1 TO MAXUNIT(); 
:Detect owner:
W=(GetStat(U,SOwner,0));

IF (GETSTAT(U,STypeID,1)=362) %AND ALIVE(U) THEN {
 IF W=A THEN { WANDERERA = WANDERERA + 1; }
 IF W=D THEN { WANDERERD = WANDERERD + 1; }
}

IF (GETENCHANTMENTFLAG(U,EncInCombat,1)=0) THEN { GOTO "JUMPOVERTHIS"; }

 SETENCHANTMENTFLAG(U,EncInCombat,1,0);
 SETENCHANTMENTFLAG(U,EncFrozen,1,0);

 IF (GETENCHANTMENTFLAG(U,EncTrapped,1)>0) THEN {
  SETENCHANTMENTFLAG( U,EncTrapped,1,0 );
  SETSTAT(U,SEnabler,1,0);
 }

 COUNTER=(GetStat(U,SRechargeCounter,1));
 IF (COUNTER>0) THEN {
  SETSTAT(U,SRechargeCounter,1,0);
 }

: Remove disrupt gains from city wall :
 IF (C>0) %AND (ISBUILT(C,BCityWalls)=1) THEN {
  IF (GETSTAT(U,SSpellAbility,1)=82)
   %AND (GETSTAT(U,SOwner,0)=D)
   %AND (GETSTAT(U,STypeID,1)<>52)
   %AND (GETSTAT(U,STypeID,1)<>110)
   %AND (GETSTAT(U,STypeID,1)<>117)
   %AND (GETSTAT(U,STypeID,1)<>144)
   %AND (GETSTAT(U,STypeID,1)<>292)
  THEN {
   SETSTAT(U,SSpellAbility,1,0);
   SETSTAT(U,SSpellCharges,0,0);
  }
 }

 IF (RETORT(Winner,Conjurer)=0) THEN { GOTO "NOTCONJURINGPACT"; }
  IF (SPELLSTATE(Winner,SConjuringPact)<>2) THEN { GOTO "NOTCONJURINGPACT"; }

   IF (TACTICALCOMBAT=0) THEN { GOTO "AUTOCONJURINGPACT"; }

    IF (W=Loser) THEN { GOTO "NOTCONJURINGPACT"; }
    IF (ALIVE(U)=0) THEN { GOTO "NOTCONJURINGPACT"; }
    IF (GETENCHANTMENTFLAG(U,EncConjuringPact,0)=0) THEN { GOTO "NOTCONJURINGPACT"; }

     GOTO "CONJURERLEARNSPELL"
  
   !AUTOCONJURINGPACT!

    IF (W=Winner) THEN { GOTO "NOTCONJURINGPACT"; }
    IF (ALIVE(U)>0) THEN { GOTO "NOTCONJURINGPACT"; }
    IF (BASEFANTASTIC(U)=0) THEN { GOTO "NOTCONJURINGPACT"; }
    IF (RND(5)=0) THEN { GOTO "NOTCONJURINGPACT"; }

  !CONJURERLEARNSPELL!

   IF (BOOKS(Winner,Nature)=0) THEN { GOTO "CONJURERNONATURE"; }

    IF (GETSTAT(U,STypeID,1)=152)
     %AND (BOOKS(Winner,Nature)>1)
     %AND (SPELLSTATE(Winner,SWildBoars)<>2)
    THEN {
     SETSPELLDATA(Winner,SWildBoars,2);
     GOTO "NOTCONJURINGPACT";
    }

    IF (GETSTAT(U,STypeID,1)=179)
     %AND (BOOKS(Winner,Nature)>1)
