      !NOCOMMONREWARD!      

      : Steal uncommon spells that not yet researched :
      IF (CLAIMUNCOMMON=0) THEN { GOTO "NOUNCOMMONREWARD"; }

       I=12;

       LOOP {

        IF ( (UNCOMMONREWARD1=0) %OR (SPELLSTATE(WINNER,UNCOMMONREWARD1)>0) )
         %AND ( (UNCOMMONREWARD2=0) %OR (SPELLSTATE(WINNER,UNCOMMONREWARD2)>0) )
         %AND ( (UNCOMMONREWARD3=0) %OR (SPELLSTATE(WINNER,UNCOMMONREWARD3)>0) )
