       CLAIMRARE=1;
       CLAIMVERYRARE=1;
      }
      IF (BOOKS(Winner,REWARDREALM)=8) THEN {
       CLAIMCOMMON=0;
       CLAIMUNCOMMON=2;
       CLAIMRARE=1;
       CLAIMVERYRARE=1;
      }
      IF (BOOKS(Winner,REWARDREALM)=9) THEN {
