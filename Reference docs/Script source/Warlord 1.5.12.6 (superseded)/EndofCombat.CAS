      !NOUNCOMMONREWARD!      

      : Steal rare spells that not yet researched :
      IF (CLAIMRARE=0) THEN { GOTO "NORAREREWARD"; }

       I=CLAIMRARE;

       LOOP {

        IF ( (RAREREWARD1=0) %OR (SPELLSTATE(WINNER,RAREREWARD1)>0) )
         %AND ( (RAREREWARD2=0) %OR (SPELLSTATE(WINNER,RAREREWARD2)>0) )
