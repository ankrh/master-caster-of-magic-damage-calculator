: This section is only for surviving unit :
 IF (ALIVE(U)=0) THEN { GOTO "DIEINCOMBAT"; }

: fix nohealing issue under State of Rot :
  IF (GETSTAT(U,ANoHealing,1)>0)
   %AND (GETSTAT(U,STypeID,1)<>165)
   %AND (GETSTAT(U,STypeID,1)<>174)
  THEN {
   IF (GetEnchantmentFlag(U,EncUndead,0)=0)
    %OR ( (GetEnchantmentFlag(U,EncUndead,0)>0) %AND (GETENCHANTMENTFLAG(U,EncDestiny,0)>0) )
   THEN {
    SETSTAT(U,ANoHealing,1,0);
   }
  }

 !DIEINCOMBAT!

 !JUMPOVERTHIS!

NEXT U;

IF RETORT(A,Channeler) THEN {
 IF ( WANDERERA = 0 )
  %AND (GETWIZARDDATA(A,WDMarionette)=1)
 THEN {
  SETWIZARDDATA(A,WDMarionette,2);
  SETSPELLDATA(A,SMarionetteSummon,2);
 }
}

IF RETORT(D,Channeler) THEN {
 IF ( WANDERERD = 0 )
  %AND (GETWIZARDDATA(D,WDMarionette)=1)
 THEN {
  SETWIZARDDATA(D,WDMarionette,2);
  SETSPELLDATA(D,SMarionetteSummon,2);
 }
}

IF (ROCKYHILLCOMBAT>0) THEN { MASTERVARSET ROCKYHILLCOMBAT = ROCKYHILLCOMBAT - 1; }

LOSERCITY=0;

FOR CITY=1 TO MAXCITY();

 IF (CITYOWNER(CITY)=Loser) THEN { LOSERCITY=LOSERCITY+1; }

NEXT;

: losing badly should want peace regardless how short the war is :
IF (LOSERCITY<3) THEN {

 FOR I=0 TO NOFWIZARDS();

  IF (GETDIPVAR(LOSER,I,2)=3) THEN {
   SETDIPVAR(LOSER,I,4,100);
   SETDIPVAR(LOSER,I,6,100);
  }

 NEXT I;

}

IF (C<1) THEN { GOTO "NOTCITY"; }

 IF (MOATCOMBAT>0) THEN { MASTERVARSET MOATCOMBAT = MOATCOMBAT - 1; }

 IF (HILLFORTCOMBAT>0) THEN { MASTERVARSET HILLFORTCOMBAT = HILLFORTCOMBAT - 1; }

 IF (BARAYCOMBAT>0) THEN { MASTERVARSET BARAYCOMBAT = BARAYCOMBAT - 1; }

: Mycelium regeneration script :
 IF (CITYRACE(C)<>RCGoblin) THEN { GOTO "NOTGOBLINCITY"; }

  IF (POPULATION(C)>1000) THEN {
   : Tricksters require forest :
   IF (TERRAININRANGE(C,LTGrassland)=0)
    %AND (TERRAININRANGE(C,LTDesert)=0)
    %AND (TERRAININRANGE(C,LTHill)=0)
   THEN {
    SETBUILDINGSTATE(C,BTricksterMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BTricksterMycelium,1);
   }
   : Rabblerousers require river :
   IF (TERRAININRANGE(C,LTRiver)=0)
    %AND (TERRAININRANGE(C,LTRiverStart)=0)
    %AND (TERRAININRANGE(C,LTDesert)=0)
    %AND (TERRAININRANGE(C,LTSorceryNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BRabblerouserMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BRabblerouserMycelium,1);
   }
   : Hexers require magical node :
   IF (TERRAININRANGE(C,LTChaosNode)=0)
    %AND (TERRAININRANGE(C,LTNatureNode)=0)
    %AND (TERRAININRANGE(C,LTSorceryNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BHexerMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BHexerMycelium,1);
   }
   : Arsonists require tundra or volcano or chaos node :
   IF (TERRAININRANGE(C,LTTundra)=0)
    %AND (TERRAININRANGE(C,LTVolcano)=0)
    %AND (TERRAININRANGE(C,LTChaosNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BArsonistMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BArsonistMycelium,1);
   }
   : Night Goblins requires hill or mountain :
   IF (TERRAININRANGE(C,LTHill)=0)
    %AND (TERRAININRANGE(C,LTMountain)=0)
    %AND (TERRAININRANGE(C,LTNatureNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BNightGoblinMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BNightGoblinMycelium,1);
   }
   : Mechaniacs requires river or mountain :
   IF (TERRAININRANGE(C,LTRiver)=0)
    %AND (TERRAININRANGE(C,LTRiverStart)=0)
    %AND (TERRAININRANGE(C,LTMountain)=0)
   THEN {
    SETBUILDINGSTATE(C,BMechaniacMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BMechaniacMycelium,1);
   }
   : Poxbearers require swamp or sorcery node :
   IF (TERRAININRANGE(C,LTSwamp)=0)
    %AND (TERRAININRANGE(C,LTSorceryNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BPoxbearerMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BPoxbearerMycelium,1);
   }
   : Spider Riders require swamp :
   IF (TERRAININRANGE(C,LTSwamp)=0)
    %AND (TERRAININRANGE(C,LTNatureNode)=0)
   THEN {
    SETBUILDINGSTATE(C,BSpiderRiderMycelium,0);
   } ELSE {
    SETBUILDINGSTATE(C,BSpiderRiderMycelium,1);
   }
  } ELSE {
   SETBUILDINGSTATE(C,BTricksterMycelium,0);
   SETBUILDINGSTATE(C,BRabblerouserMycelium,0);
   SETBUILDINGSTATE(C,BHexerMycelium,0);
   SETBUILDINGSTATE(C,BArsonistMycelium,0);
   SETBUILDINGSTATE(C,BNightGoblinMycelium,0);
   SETBUILDINGSTATE(C,BMechaniacMycelium,0);
   SETBUILDINGSTATE(C,BPoxbearerMycelium,0);
   SETBUILDINGSTATE(C,BSpiderRiderMycelium,0);
  }

 !NOTGOBLINCITY!

: Losing fortress :
 IF (ISFORTRESS(C)=0) THEN { GOTO "NOTFORTRESS"; }

  IF (CITYOWNER(C)<>D) %OR (D<>Loser) THEN { GOTO "NOTDEFENDERLOSE"; }

: set loser record to limbo :
   SETWIZARDDATA(D,WDFortressP,3);

: Score Modifier Book Collectors :
   IF (SCORINGOPTION(SBookCollectors)=0) THEN { GOTO "NOTABOOKWORM"; }

    WINNERBOOK=BOOKS(Winner,1)+BOOKS(Winner,2)+BOOKS(Winner,3)+BOOKS(Winner,4)+BOOKS(Winner,5);
    LOSERBOOK=BOOKS(Loser,1)+BOOKS(Loser,2)+BOOKS(Loser,3)+BOOKS(Loser,4)+BOOKS(Loser,5);

    IF (RETORT(Winner,Specialist)=0)
     %AND ((RETORT(Winner,1))+(RETORT(Winner,2))+(RETORT(Winner,3))+(RETORT(Winner,4))+(RETORT(Winner,5))+(RETORT(Winner,6))+(RETORT(Winner,7))+(RETORT(Winner,8))+(RETORT(Winner,9))+(RETORT(Winner,10))+(RETORT(Winner,11))+(RETORT(Winner,12))+(RETORT(Winner,13))+(RETORT(Winner,14))+(RETORT(Winner,15))+(RETORT(Winner,16))+(RETORT(Winner,17))+(RETORT(Winner,18)))<6)
    THEN { SR=0; } ELSE { SR=1; }

    IF (LOSERBOOK=0) %OR (WINNERBOOK>29) THEN { GOTO "NOTABOOKWORM"; }

    IF ( BOOKS(Winner,1)>11 )
     %AND ( BOOKS(Winner,2)>11 )
     %AND ( BOOKS(Winner,3)>11 )
     %AND ( BOOKS(Winner,4)>11 )
     %AND ( BOOKS(Winner,5)>11 )
     %AND (SR=1)
	THEN { GOTO "NOTABOOKWORM"; }

    REWARDREALM=0;

    IF (LOSERCITY<2) THEN { GOTO "BOOKLASTCITY"; }

     WINNERLUCK=2*(RND(7)-RND(7));

     IF (WINNERLUCK<1) THEN { GOTO "NOTABOOKWORM"; }

      LOOP {

       REALM=RND(5)+1;
       IF ( BOOKS(Loser,REALM)=0 ) THEN { GOTO "SKIPBOOK"; }

        WINNERLUCK=WINNERLUCK-1;

        IF ( BOOKS(Winner,REALM)<10 ) THEN {
         IF (RND(2)>0) THEN {
          SETBOOK Loser,REALM,((BOOKS(Loser,REALM)-1);
          SETBOOK Winner,REALM,((BOOKS(Winner,REALM)+1);
          REWARDREALM=REALM;
          WINNERLUCK=0;
          GOTO "SKIPBOOK";
         }
        } ELSE {
         IF (SR=0) THEN {
          SETRETORT(Winner,Specialist,1);
          IF (Winner=0) THEN { SETGLOBAL(0,GESpecialistLearned,1); }
          WINNERLUCK=0;
          GOTO "SKIPBOOK";
         }
         IF ( BOOKS(Winner,REALM)<12 ) THEN {
          IF (RND(2)>0) THEN {
           SETBOOK Loser,REALM,((BOOKS(Loser,REALM)-1);
           SETBOOK Winner,REALM,((BOOKS(Winner,REALM)+1);
           REWARDREALM=REALM;
           WINNERLUCK=0;
           GOTO "SKIPBOOK";
          }
         }
        }

       !SKIPBOOK!

      } ENDLP WINNERLUCK=0;

      GOTO "NOTABOOKWORM";

    !BOOKLASTCITY!

     WINNERLUCK=1;

     FOR REALM=1 TO 5;

      IF (WINNERLUCK=0) THEN { GOTO "SKIPBOOKFINAL"; }

       IF ( BOOKS(Loser,REALM)=0 ) THEN { GOTO "SKIPBOOKFINAL"; }

        IF ( BOOKS(Winner,REALM)<10 ) THEN {
         SETBOOK Loser,REALM,((BOOKS(Loser,REALM)-1);
         SETBOOK Winner,REALM,((BOOKS(Winner,REALM)+1);
         REWARDREALM=REALM;
         WINNERLUCK=0;
         GOTO "SKIPBOOKFINAL";
        } ELSE {
         IF (SR=0) THEN {
          SETRETORT(Winner,Specialist,1);
          IF (Winner=0) THEN { SETGLOBAL(0,GESpecialistLearned,1); }
          WINNERLUCK=0;
          GOTO "SKIPBOOKFINAL";
         }
         IF ( BOOKS(Winner,REALM)<12 ) THEN {
          SETBOOK Loser,REALM,((BOOKS(Loser,REALM)-1);
          SETBOOK Winner,REALM,((BOOKS(Winner,REALM)+1);
          REWARDREALM=REALM;
          WINNERLUCK=0;
          GOTO "SKIPBOOKFINAL";
         }
        }

      !SKIPBOOKFINAL!

     NEXT REALM;

     IF (REWARDREALM=0) THEN { GOTO "NOTABOOKWORM"; }

      IF (Winner=0) THEN { 
       IF (REWARDREALM=1) THEN { SETGLOBAL(0,GENatureBookFound,1); }
       IF (REWARDREALM=2) THEN { SETGLOBAL(0,GESorceryBookFound,1); }
       IF (REWARDREALM=3) THEN { SETGLOBAL(0,GEChaosBookFound,1); }
       IF (REWARDREALM=4) THEN { SETGLOBAL(0,GELifeBookFound,1); }
       IF (REWARDREALM=5) THEN { SETGLOBAL(0,GEDeathBookFound,1); }
      }

      : Claiming Spell :
      CLAIMCOMMON=0;
      CLAIMUNCOMMON=0;
      CLAIMRARE=0;
      CLAIMVERYRARE=0;

      IF (BOOKS(Winner,REWARDREALM)=1) THEN {
       CLAIMCOMMON=3;
       CLAIMUNCOMMON=1;
       CLAIMRARE=0;
       CLAIMVERYRARE=0;
      }
      IF (BOOKS(Winner,REWARDREALM)=2) THEN {
       CLAIMCOMMON=1;
       CLAIMUNCOMMON=3;
       CLAIMRARE=1;
       CLAIMVERYRARE=0;
      }
      IF (BOOKS(Winner,REWARDREALM)=3) THEN {
       CLAIMCOMMON=1;
