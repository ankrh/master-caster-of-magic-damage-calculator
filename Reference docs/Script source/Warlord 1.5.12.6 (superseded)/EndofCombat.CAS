      IF ( (COMMONREWARD1=0) %OR (SPELLSTATE(WINNER,COMMONREWARD1)>0) )
       %AND ( (COMMONREWARD2=0) %OR (SPELLSTATE(WINNER,COMMONREWARD2)>0) )
       %AND ( (COMMONREWARD3=0) %OR (SPELLSTATE(WINNER,COMMONREWARD3)>0) )
