      }
      IF (BOOKS(Winner,REWARDREALM)=11) THEN {
       CLAIMCOMMON=0;
       CLAIMUNCOMMON=0;
       CLAIMRARE=2;
       CLAIMVERYRARE=2;
      }
      IF (BOOKS(Winner,REWARDREALM)>11) THEN {
       CLAIMCOMMON=0;
       CLAIMUNCOMMON=0;
       CLAIMRARE=2;
       CLAIMVERYRARE=0;
      }

