         %AND ( (RAREREWARD18=0) %OR (SPELLSTATE(WINNER,RAREREWARD18)>0) )
        THEN {
         CLAIMRARE=0;
         I=0;
        } 

        RANDOMRARE=RND(18)+1;

        IF (I>0)
         %AND (RANDOMRARE=1)
         %AND (SPELLSTATE(LOSER,RAREREWARD1)=1)
         %AND (SPELLSTATE(WINNER,RAREREWARD1)=0)
        THEN {
         SETSPELLDATA(WINNER,RAREREWARD1,1);
         SETSPELLDATA(LOSER,RAREREWARD1,0);
         IF (CLAIMRARE>0) THEN { CLAIMRARE=CLAIMRARE-1; }
         IF (CLAIMRARE=0) THEN { I=0; }
         GOTO "RARESPELLSTOLEN";
        }
        IF (I>0)
         %AND (RANDOMRARE=2)
         %AND (SPELLSTATE(LOSER,RAREREWARD2)=1)
         %AND (SPELLSTATE(WINNER,RAREREWARD2)=0)
        THEN {
         SETSPELLDATA(WINNER,RAREREWARD2,1);
         SETSPELLDATA(LOSER,RAREREWARD2,0);
         IF (CLAIMRARE>0) THEN { CLAIMRARE=CLAIMRARE-1; }
         IF (CLAIMRARE=0) THEN { I=0; }
         GOTO "RARESPELLSTOLEN";
        }
        IF (I>0)
         %AND (RANDOMRARE=3)
         %AND (SPELLSTATE(LOSER,RAREREWARD3)=1)
         %AND (SPELLSTATE(WINNER,RAREREWARD3)=0)
        THEN {
         SETSPELLDATA(WINNER,RAREREWARD3,1);
         SETSPELLDATA(LOSER,RAREREWARD3,0);
         IF (CLAIMRARE>0) THEN { CLAIMRARE=CLAIMRARE-1; }
         IF (CLAIMRARE=0) THEN { I=0; }
         GOTO "RARESPELLSTOLEN";
        }
        IF (I>0)
         %AND (RANDOMRARE=4)
         %AND (SPELLSTATE(LOSER,RAREREWARD4)=1)
         %AND (SPELLSTATE(WINNER,RAREREWARD4)=0)
        THEN {
