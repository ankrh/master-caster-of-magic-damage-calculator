         SETSPELLDATA(LOSER,RAREREWARD4,0);
         IF (CLAIMRARE>0) THEN { CLAIMRARE=CLAIMRARE-1; }
         IF (CLAIMRARE=0) THEN { I=0; }
         GOTO "RARESPELLSTOLEN";
        }
