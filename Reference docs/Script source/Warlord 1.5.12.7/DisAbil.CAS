: new effect of Lava Smelter add effect of weapon and armor based on ore :
 IF (ISBUILT(CF,BLavaSmelter)>0) THEN {

  ACCESSMITHRIL=0;
  IF (OREINRANGE(C,OreMithril)>0)
   %OR ( (LOGISTIC>0) %AND (OWNMITHRIL>0) )
  THEN { ACCESSMITHRIL=1; }
  ACCESSADAMANTIUM=0;
  IF (OREINRANGE(C,OreAdamantium)>0)
   %OR ( (LOGISTIC>0) %AND (OWNADAMANTIUM>0) )
  THEN { ACCESSADAMANTIUM=1; }
  ACCESSORIHALCON=0;
  IF (OREINRANGE(C,OreOrihalcon)>0)
   %OR ( (LOGISTIC>0) %AND (OWNORIHALCON>0) )
  THEN { ACCESSORIHALCON=1; }
  ACCESSCRYSX=0;
  IF (OREINRANGE(C,OreCrysx)>0)
   %OR ( (LOGISTIC>0) %AND (OWNCRYSX>0) )
  THEN { ACCESSCRYSX=1; }

  IF (ACCESSMITHRIL>0) %AND (ACCESSADAMANTIUM>0) THEN {
   AddAbilityLine 0,9,"Weapon Immunity","+ Weapon Immunity";
  }
  IF (ACCESSMITHRIL>0) %AND (ACCESSCRYSX>0) THEN {
   AddAbilityLine 0,10,"Missile Immunity","+ Missile Immunity";
  }
  IF (ACCESSMITHRIL>0) %AND (ACCESSORIHALCON>0) THEN {
   AddAbilityLine 0,145,"Resist Elements","+ Resist Elements";
  }
  IF (ACCESSADAMANTIUM>0) %AND (ACCESSORIHALCON>0) THEN {
   AddAbilityLine 0,144,"Elemental Armor","+ Elemental Armor";
  }
  IF (ACCESSADAMANTIUM>0) %AND (ACCESSCRYSX>0) THEN {
   AddAbilityLine 0,315,"Flame Blade","+ Flame Blade";
  }

 }

