: Effect of Pillar of Faith, unit has chance 20% to get lucky upon unit creation :
 IF (CITYENCHANT(CF,CEPillarOfFaith)>-1) THEN {
  FAITH=0
  IF CITYENCHANT(CF,CEHeavenlyLight)>-1 THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BShrine) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BParthenon) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BWitchesConvent) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BCathedral) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BTemple) THEN { FAITH=FAITH+1; }
  IF HASGLOBAL(W,GEKingOfUnderworld) %AND ISBUILT(CF,BOracle) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BAltarOfStorm) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BAltarOfTheSun) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BAltarOfTheMoon) THEN { FAITH=FAITH+1; }
  IF ISBUILT(CF,BBasilica) THEN { FAITH=FAITH+1; }
  s$="";
  S$=S$+" "+STRS(FAITH);
  AddAbilityLine 0,223,"Power of Faith","+ Power of Faith"+S$);
  AddAbilityLine 0,124,"Lucky","+ Lucky Chance 20%";
 }

