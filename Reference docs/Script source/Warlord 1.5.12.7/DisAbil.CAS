IF (GETSTAT(U,SSpellAbility,0)=5)
THEN {
 s$="";
 IF INCOMBAT(U) THEN {
  S$=S$+" x"+STRS(CHARGE);
 } ELSE {
  S$=S$+" x"+STRS(CHARGEOL);
 }
 AddAbilityLine 0,53,"#Spell Web","Web"+S$); 
}

