IF (CF<1)
 %OR (GETENCHANTMENTFLAG(U,EncMagic,1)>0)
 %OR ( (GETSTAT(U,SRace,1)<>CITYRACE(CF)) %AND (GETSTAT(U,SRace,1)<>RCGeneric) )
 %OR (GETSTAT(U,ALevel,1)<>1)
 THEN { GOTO "NOTRECRUITMENTSCREEN" }

 LOGISTIC=0;
 OWNMITHRIL=0;
 OWNADAMANTIUM=0;
 OWNORIHALCON=0;
 OWNCRYSX=0;
 IF (SPELLSTATE(W,STStrategicLogistic)<>2) THEN { GOTO "NOLOGISTIC"; }
  LOGISTIC=1;

  FOR I=1 TO MAXCITY();

   IF (CITYOWNER(I)<>W) THEN { GOTO "NOTLINK"; }

    OWNMITHRIL=OWNMITHRIL+OREINRANGE(I,OreMithril);
    OWNADAMANTIUM=OWNADAMANTIUM+OREINRANGE(I,OreAdamantium);
    OWNORIHALCON=OWNORIHALCON+OREINRANGE(I,OreOrihalcon);
    OWNCRYSX=OWNCRYSX+OREINRANGE(I,OreCrysx);

   !NOTLINK!

  NEXT I;

 !NOLOGISTIC!

: Artificer retort upgrade :
 IF RETORT(W,Artificer) %AND (GetStat(U,SCustomAttribute,1)=1) THEN {
  AddAbilityLine 0,230,"Artificer Upgrade","+ Artificer Upgrade";
 }

: magical weapon upgrade :
 IF ( RETORT(W,Alchemist) %AND (CITYRACE(CF)<>RCBarbarian) )
  %OR ( (RETORT(W,Artificer)) %AND (GetStat(U,SCustomAttribute,1)=1) )
  %OR (CITYENCHANT(CF,CEMagicPerimeter)>-1)
  %OR ( (CITYENCHANT(CF,CEEvilPresence)=-1) %AND ( (ISBUILT(CF,BAlchemistGuild)) %OR (CITYENCHANT(CF,CESorcererStone)>-1) ) )
 THEN {
  AddAbilityLine 0,286,"Magical Weapon","+ Magical Weapon";
 }

 IF (CITYENCHANT(CF,CEEvilPresence)=-1)
  %AND ( (CITYENCHANT(CF,CESorcererStone)>-1) %OR (ISBUILT(CF,BAlchemistGuild)) )
 THEN {
  ORELEVEL=0;
  IF ( (OREINRANGE(CF,OreMithril)>0) %OR ( (LOGISTIC>0) %AND (OWNMITHRIL>0) ) THEN { ORELEVEL=1; }
  IF ( (OREINRANGE(CF,OreAdamantium)>0) %OR ( (LOGISTIC>0) %AND (OWNADAMANTIUM>0) ) THEN { ORELEVEL=2; }
  IF (ISBUILT(CF,BLavaSmelter)) THEN { ORELEVEL=ORELEVEL+1; }
  IF (ISBUILT(CF,BAlchemistGuild)) %AND (CITYENCHANT(CF,CESorcererStone)>-1) THEN { ORELEVEL=ORELEVEL+1; }

  IF (ORELEVEL=1) THEN { AddAbilityLine 0,287,"Mithril Upgrade","+ Mithril Upgrade"; }
  IF (ORELEVEL>1) THEN { AddAbilityLine 0,288,"Adamantium Upgrade","+ Adamantium Upgrade"; }
  IF (ORELEVEL>2)
   %OR (OREINRANGE(CF,OreOrihalcon)>0)
   %OR ( (LOGISTIC>0) %AND (OWNORIHALCON>0) )
  THEN { AddAbilityLine 0,161,"Orihalcon","+ Orihalcon"; }
 }

