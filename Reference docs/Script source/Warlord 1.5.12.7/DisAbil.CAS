 %AND (GETCOMBATENCHANTMENTFLAG(U,EncIronSkin,1)=0)
 %AND (GETOLENCHANTMENTFLAG(U,EncIronSkin,1)=0)
THEN {
 AddAbilityLine 0,72,"Iron Skin","Iron Skin";
