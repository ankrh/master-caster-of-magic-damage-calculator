: New global enchantment "Natural Selection", unit gain stats based on resouce in vincinity :
 IF (HASGLOBAL(W,GENaturalSelection)>0) THEN {
  OREPOWER=%I(((1*(OREINRANGE(CF,OreMithril))/2)+(2*(OREINRANGE(CF,OreAdamantium))/2)+(3*(OREINRANGE(CF,OreOrihalcon))/2)+(5*(OREINRANGE(CF,OreQuork))/2)+(10*(OREINRANGE(CF,OreCrysx))/2))/10)
  IF OREPOWER>0 THEN {
   s$="";
   S$=S$+" "+STRS(OREPOWER);
   AddAbilityLine 0,181,"Immunized Magic","+ Immunized Magic"+S$);
  }
  IF (OREINRANGE(CF,OreNightshade))>0 THEN {
   NS=(1*(OREINRANGE(CF,OreNightshade))
   s$="";
   S$=S$+" "+STRS(NS);
   AddAbilityLine 0,180,"Natural Resistance","+ Natural Resistance"+S$;
  }
  IF ( OREINRANGE(CF,OreWildgame) > 0 ) %AND ( (GETSTAT(U,SRanged,1)) > 0 ) THEN {
   AddAbilityLine 0,214,"Hunter","+ Hunter";
  }
  IF ( OREINRANGE(CF,OreWildgame) > 0 ) %AND ( (GETSTAT(U,AForester,1)) = 0 ) THEN { 
   AddAbilityLine 0,2,"Forester","+ Forester";
  }
  IF OREINRANGE(CF,OreCoal)>0 THEN { 
   AddAbilityLine 0,178,"Giant Strength","+ Giant Strength";
  }
  IF OREINRANGE(CF,OreIron)>0 THEN { 
   AddAbilityLine 0,179,"Tough Skin","+ Tough Skin";
  }
 }

