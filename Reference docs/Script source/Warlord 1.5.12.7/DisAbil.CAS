IF (GETSTAT(U,STypeID,1)=350)) THEN {

  GOBLIN=0;

  FOR N=1 TO NOFUNITSONTILE(combatP(),combatX(),combatY());

   UOT=UNITONTILE(combatP(),combatX(),combatY(),N);

   IF (GETSTAT(UOT,SOwner,0)<>W) THEN { GOTO "NOTCOUNTGOBLIN"; }

    : Counting Goblins :
    IF (GETSTAT(UOT,SRace,1)<>RCGoblin) THEN { GOTO "NOTCOUNTGOBLIN"; }

     GOBLIN=GOBLIN+3;

   !NOTCOUNTGOBLIN!

  NEXT N;

  IF (GOBLIN>20) THEN { GOBLIN=20; }

 s$="";
 S$=S$+"+"+STRS(GOBLIN)+"%";

 AddAbilityLine 0,279,"Goblin Horde","Goblin Horde"+S$);

}

