IF (RECHARGETURN>0) THEN {
 IF ( INCOMBAT(U) ) THEN {
  AddAbilityLine 0,53,"Ability Recharge","Recharge: "+STRS(RECHARGECOUNTER)+" Turns";
 } ELSE {
  AddAbilityLine 0,53,"Ability Recharge","Recharge: "+STRS(RECHARGETURN)+" Turns";
 }
}

IF (CURRENTFIG>0) THEN {
 S$="";
 S$=S$+STRS(MAXFIG);
 IF (CURRENTFIG=1) THEN {
  AddAbilityLine 0,257,"Figure","Figure: 1/"+S$; }
 IF (CURRENTFIG=2) THEN {
  AddAbilityLine 0,258,"Figure","Figure: 2/"+S$; }
