: outlander's mechanical upgrade :
 IF (GetStat(U,SCustomAttribute,1)=1) THEN {

  : effect of Heat Power Engine, give power engine to mechanical unit :
  IF (SPELLSTATE(W,STHeatPowerEngine)=2) THEN { 
   IF (SPELLSTATE(W,STMagitekPowerEngine)=2) THEN {
    AddAbilityLine 0,378,"Magitek Engine","+ Magitek Engine";
   } ELSE {
    AddAbilityLine 0,377,"Power Engine","+ Power Engine";
   }
   IF (SPELLSTATE(W,STMagitekAntiGravityDrive)=2)
    %AND (GETSTAT(U,ASailing,1)>0)
   THEN {
    AddAbilityLine 0,389,"Anti-Gravity Drive","+ Anti-Gravity Drive";
   }
  }

  : effect of Armorclad, give armorclad unit enchantment :
  IF (SPELLSTATE(W,STArmorClad)=2) THEN {
   AddAbilityLine 0,380,"Armorclad","+ Armorclad";
   IF (SPELLSTATE(W,STMagitekMaterialScience)=2) THEN {
    AddAbilityLine 0,146,"RESIST MAGIC","+ RESIST MAGIC";
   }
  }

 }

: == Unit bonus as unit's veterancy == :
 : Altar of Battle/War College/Barracks's unit veterancy :
 IF (RETORT(W,Warlord)>0) %AND (HASGLOBAL(W,GECrusade)) THEN {
  IF CITYENCHANT(CF,CEAltarofBattle)>-1 THEN {
   AddAbilityLine 0,104,"Unitlevel","+ Champion Level (180 EXP)";
  } ELSE { 
   IF ISBUILT(CF,BWarCollege) THEN {
    AddAbilityLine 0,103,"Unitlevel","+ Ultra Elite Level (80 EXP)";
   } ELSE {
    IF ISBUILT(CF,BBarracks) THEN {
     AddAbilityLine 0,102,"Unitlevel","+ Elite Level (30 EXP)";
    } ELSE {
     AddAbilityLine 0,101,"Unitlevel","+ Veteran Level (0 EXP)";
    }
   }
  }
 } ELSE {
  IF (RETORT(W,Warlord)>0) %OR (HASGLOBAL(W,GECrusade)) THEN {
   IF CITYENCHANT(CF,CEAltarofBattle)>-1 THEN {
    AddAbilityLine 0,103,"Unitlevel","+ Ultra Elite Level (180 EXP)";
   } ELSE { 
    IF ISBUILT(CF,BWarCollege) THEN {
     AddAbilityLine 0,102,"Unitlevel","+ Elite Level (80 EXP)";
    } ELSE {
     IF ISBUILT(CF,BBarracks) THEN {
      AddAbilityLine 0,101,"Unitlevel","+ Veteran Level (30 EXP)";
     } ELSE {
      AddAbilityLine 0,100,"Unitlevel","+ Regular Level (0 EXP)";
     }
    }
   }
  } ELSE {
   IF CITYENCHANT(CF,CEAltarofBattle)>-1 THEN {
    AddAbilityLine 0,102,"Unitlevel","+ Elite Level (180 EXP)";
   } ELSE { 
    IF ISBUILT(CF,BWarCollege) THEN {
     AddAbilityLine 0,101,"Unitlevel","+ Veteran Level (80 EXP)";
    } ELSE {
     IF ISBUILT(CF,BBarracks) THEN {
      AddAbilityLine 0,100,"Unitlevel","+ Regular Level (30 EXP)";
     } ELSE {
      AddAbilityLine 0,99,"Unitlevel","+ Recruit Level (0 EXP)";
     }
    }
   }
  }
 }

: end of Unit bonus given to unit :
!HASEVILPRESENCE!

: == Unit penalty given to unit permanently == :
: New effect of Drought, impaired newly trained units' attack and defense  :
IF ( GETCITYDATA(CF,CDFOOD) < 2*(POPUNITS(CF)) ) THEN {
 AddAbilityLine 0,184,"Malnourished","+ Malnourished";
}

: == Unit penalties as unit's enchantment == :
: New effect of Chaos Rift, curse unit with warp creature effects :
IF CITYENCHANT(CF,CEChaosRift)>-1 THEN { 
 AddAbilityLine 0,289,"Warp Creature","+ Warp Creature";
}

: == Unit from Necropolis becomes undead == :
IF (CITYENCHANT(CF,CENecropolis)>-1) THEN {
 AddAbilityLine 0,289,"Undead","+ Undead";
 AddAbilityLine 0,23,"Wraith Form","+ Wraith Form";
}

!NOTRECRUITMENTSCREEN!


IF (INCOMBAT(U)=0) THEN { GOTO "NOTCOMBAT"; }

!COMBATONLY!

 IF (ETERNALNIGHTCOUNT>0)
  %AND (HASGLOBAL(W,GEEternalNight)=0)
  %AND (GetStat(U,STypeID,1)<>356)
  %AND (GetStat(U,SRace,0)<>20)
  %AND (GetEnchantmentFlag(U,EncUndead,0)=0)
 THEN {
  AddAbilityLine 0,183,"Poor Vision","Poor Vision";
 }

 IF ((GETTERRAIN((GetStat(U,SCoX,1)),(GetStat(U,SCoY,1)),0))=CTSea) THEN {
  IF (GETSTAT(U,ASailing,0)=0)
   %AND (GETSTAT(U,AWaterwalking,0)=0)
   %AND (GETSTAT(U,AFlying,0)=0)
   %AND (GETSTAT(U,ANoncorporeal,0)=0)
  THEN {
   ROOTSTRANDING=0;

   FOR TU=1 TO MAXUNIT();

    TCBX=(GetStat(TU,SCoX,1));
    TCBY=(GetStat(TU,SCoY,1));

    IF (ROOTSTRANDING=1) THEN { GOTO "ALREADYBINDSTRANDED"; }

     IF ( INCOMBAT(TU) = 0 ) THEN { GOTO "NOTANGLINGBINDSTRANDED"; }

      IF (GetStat(TU,SOwner,0)=GetStat(U,SOwner,0)) THEN { GOTO "NOTANGLINGBINDSTRANDED"; }

      IF (GETSTAT(TU,SCustomAttribute,1)<>3) THEN { GOTO "NOTANGLINGBINDSTRANDED"; }

       IF (TCBX>CBX-2) %AND (TCBX<CBX+2)
        %AND (TCBY>CBY-2) %AND (TCBY<CBY+2)
       THEN {
        ROOTSTRANDING=1;
       }

    !NOTANGLINGBINDSTRANDED!

    !ALREADYBINDSTRANDED!

   NEXT TU;

   IF (ROOTSTRANDING=1) THEN {
    AddAbilityLine 0,320,"Roots Stranding","Roots Stranding";
   } ELSE {
    AddAbilityLine 0,226,"Stranded","Stranded";
   }
  }
 } ELSE {
  IF (GETSTAT(U,ASailing,0)>0)
   %AND (GETSTAT(U,AFlying,0)=0)
   %AND (GETSTAT(U,ANoncorporeal,0)=0)
  THEN {
   ROOTSTRANDING=0;

   FOR TU=1 TO MAXUNIT();

    TCBX=(GetStat(TU,SCoX,1));
    TCBY=(GetStat(TU,SCoY,1));

    IF (ROOTSTRANDING=1) THEN { GOTO "ALREADYBINDGROUNDED"; }

     IF ( INCOMBAT(TU) = 0 ) THEN { GOTO "NOTANGLINGBINDGROUNDED"; }

      IF (GetStat(TU,SOwner,0)=GetStat(U,SOwner,0)) THEN { GOTO "NOTANGLINGBINDGROUNDED"; }

      IF (GETSTAT(TU,SCustomAttribute,1)<>3) THEN { GOTO "NOTANGLINGBINDGROUNDED"; }

       IF (TCBX>CBX-2) %AND (TCBX<CBX+2)
        %AND (TCBY>CBY-2) %AND (TCBY<CBY+2)
       THEN {
        ROOTSTRANDING=1;
       }

    !NOTANGLINGBINDGROUNDED!

    !ALREADYBINDGROUNDED!

   NEXT TU;

   IF (ROOTSTRANDING=1) THEN {
    AddAbilityLine 0,320,"Roots Stranding","Roots Stranding";
   } ELSE {
    AddAbilityLine 0,225,"Grounded","Grounded";
   }
  }
 }

 IF (GetEnchantmentFlag(U,EncInCombat,0)=0) THEN {
  AddAbilityLine 0,284,"Reinforcement Unit","Reinforcement Unit";
 }

 IF (GetCombatEnchantmentFlag(U,EncDICE1,0)>0) THEN {
  AddAbilityLine 0,53,"GODS PLAY DICES","FATE-1";
 }

 IF (GetCombatEnchantmentFlag(U,EncDICE2,0)>0) THEN {
  AddAbilityLine 0,53,"GODS PLAY DICES","FATE-2";
