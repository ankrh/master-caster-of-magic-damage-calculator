 }

 IF (GetCombatEnchantmentFlag(U,EncDICE4,0)>0) THEN {
  AddAbilityLine 0,53,"GODS PLAY DICES","FATE+2";
 }


 IF ( (RETORT(W,Tactician)>0) %OR ( (SCORINGOPTION(SKhanTheConqueror)=1) %AND ( (W>(NOFWIZARDS()))=1) ) )
  %AND ( ( (GETSTAT(U,AForester,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTForest) %OR (GETTERRAIN(CBX,CBY,0)=CTPine) ) )
   %OR ( (GETSTAT(U,AMountaineer,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTRock2) %OR (GETTERRAIN(CBX,CBY,0)=CTMountain) ) )
   %OR ( (GETSTAT(U,AWaterwalking,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTIce) %OR (GETTERRAIN(CBX,CBY,0)=CTSwamp) ) ) ) )
 THEN {
  AddAbilityLine 0,246,"Tactical Advantage","Tactical Advantage";
 } ELSE {
  IF ( (RETORT(W,Tactician)=0) %OR ( (SCORINGOPTION(SKhanTheConqueror)=0) %AND ( (W>(NOFWIZARDS()))=1) ) )
   %AND ( ( (GETSTAT(U,AForester,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTForest) %OR (GETTERRAIN(CBX,CBY,0)=CTPine) ) )
    %OR ( (GETSTAT(U,AMountaineer,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTRock2) %OR (GETTERRAIN(CBX,CBY,0)=CTMountain) ) )
    %OR ( (GETSTAT(U,AWaterwalking,0)>0) %AND ( (GETTERRAIN(CBX,CBY,0)=CTIce) %OR (GETTERRAIN(CBX,CBY,0)=CTSwamp) ) ) ) )
  THEN {
   AddAbilityLine 0,246,"Terrain Advantage","Terrain Advantage";
  }
 }

