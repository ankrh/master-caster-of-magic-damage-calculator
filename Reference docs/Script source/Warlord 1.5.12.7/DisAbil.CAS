:
INPUT - U = the unit whose abilities are being listed

OUTPUT - None. Use the ADDABILITYLINE command to display abilities.
:

W=GETSTAT(U,SOwner,1);
A=ATTACKER();
D=DEFENDER();
CBX=(GetStat(U,SCoX,1));
CBY=(GetStat(U,SCoY,1));
OVERX=COMBATX();
OVERY=COMBATY();
PLANE=COMBATP();
CHARGEOL=GETSTAT(U,SSpellCharges,0);
CHARGE=GETSTAT(U,SChargesLeft,0);
RECHARGETURN=GETSTAT(U,SSpellRecharge,0);
RECHARGECOUNTER=GETSTAT(U,SRechargeCounter,0);
MAXFIG=(GETSTAT(U,SFigures,0));
CURRENTFIG=MAXFIG-%I( (GETDAMAGE(U,0))/(GETSTAT(U,SHP,0)) );
C=CITYONTILE(U);
CF=CityInFocus;

:IF (GetCombatEnchantmentFlag(U,EncStoneSkin,0)>0) %OR
(GetOLEnchantmentFlag(U,EncStoneSkin,0)>0)
THEN { AddAbilityLine 0,72,"Stone Skin","Stone Skin"; }
HALT;:

IF ( (GETENCHANTMENTFLAG(U,EncDisciplineOld,0)>0)
  %AND (GETCOMBATENCHANTMENTFLAG(U,EncDisciplineOld,1)=0)
  %AND (GETOLENCHANTMENTFLAG(U,EncDisciplineOld,1)=0) )
 %OR ( (GETENCHANTMENTFLAG(U,EncDiscipline,0)>0)
  %AND (GETCOMBATENCHANTMENTFLAG(U,EncDiscipline,1)=0)
  %AND (GETOLENCHANTMENTFLAG(U,EncDiscipline,1)=0) )
THEN {
 AddAbilityLine 0,410,"Discipline OL","Discipline";
}

