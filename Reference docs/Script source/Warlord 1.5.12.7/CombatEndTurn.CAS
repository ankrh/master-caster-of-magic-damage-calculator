: Input - Activeplayer - the player ID of the player whose turn is starting.
			the other player can be calculated as Attacker()+Defender()-Activeplayer.
  Output - None
:

A=ATTACKER();
D=DEFENDER();

: Poxbearer counter :
POXBEARERA=0;
POXBEARERD=0;

: Combat turn elipse :
MASTERVARSET COMBATTURN = COMBATTURN + 1;

: Active side Marker :
IF (Activeplayer=D) THEN { MASTERVARSET COMBATACTIVESIDE = 1; } ELSE { MASTERVARSET COMBATACTIVESIDE = 2; }

FOR U=1 TO MAXUNIT();

:Detect owner:
W=(GetStat(U,SOwner,0));

 IF ( INCOMBAT(U) = 0 ) THEN { GOTO "JUMPOVERTHIS"; }

 CBX=(GetStat(U,SCoX,1));
 CBY=(GetStat(U,SCoY,1));
 : Fairy Maze's Luck :
 MAZELUCK=RND(4);

 IF (ALIVE(U)=0) THEN { GOTO "JUMPOVERTHIS"; }

  IF (GETSTAT(U,STypeID,1)=358) THEN {
   IF (W=A) THEN { POXBEARERA=POXBEARERA+1; } ELSE { POXBEARERD=POXBEARERD+1; }
  }

  IF (GETSTAT(U,STypeID,1)<>357) %AND (GETSTAT(U,STypeID,1)<>363) %AND (GETHEAB(U,HAMechanicalMaster)<1) THEN { GOTO "CANNOTREPAIR"; }

   FOR I=1 TO MAXUNIT();

    IF ( INCOMBAT(I) = 0 ) THEN { GOTO "NOREPAIR"; }
     IF (GETSTAT(I,SOwner,0)<>W) THEN { GOTO "NOREPAIR"; }
      IF (GETSTAT(I,SCustomAttribute,1)<>1) THEN { GOTO "NOREPAIR"; }

       TRIGGERPOINT=%I((GETSTAT(I,SFigures,1))*(GETSTAT(I,SHP,0))/2);
       IF ((GETDAMAGE(I,0))>TRIGGERPOINT) THEN { COMBATHEAL(I,1,1,1); }

    !NOREPAIR!

   NEXT I;

  !CANNOTREPAIR!


  IF (W<>Activeplayer) THEN { GOTO "MYTURNEND"; }

   : At the start of my turn :

   : Outlander's damage control team :
   IF (SPELLSTATE(W,STMilitaryDrilling)<>2) THEN { GOTO "NODAMAGECONTROL"; }
    IF (GETSTAT(U,SCustomAttribute,1)<>1) THEN { GOTO "NODAMAGECONTROL"; }

     TRIGGERPOINT=%I((GETSTAT(U,SFigures,1))*(GETSTAT(U,SHP,0))/2);
     IF ((GETDAMAGE(U,0))>TRIGGERPOINT) THEN { COMBATHEAL(U,3,1,1); }

   !NODAMAGECONTROL!

   : Tabula Rasa has 1/3 chance to remove combat enchantment at the beginning of each turn :
   IF (HASCOMBATGLOBAL(W,CGTabulaRasa,1)=0) THEN { GOTO "NOTABULARASA"; }

    IF (HASCOMBATGLOBAL(W,CGCallLightning,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGCallLightning,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGEntangle,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGEntangle,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGFreezingRain,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGFreezingRain,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGHurricane,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGHurricane,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGForceOfNature,2)>0) THEN {
     IF (HASCOMBATGLOBAL(W,CGCallLightning,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGEntangle,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGFreezingRain,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGHurricane,2)=0)
     THEN {
      SETCOMBATGLOBAL(W,CGForceOfNature,2,0);
     }
    }

    IF (HASCOMBATGLOBAL(W,CGBlur,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGBlur,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGMassInvisibility,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGMassInvisibility,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGCounterMagic,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGCounterMagic,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGAetherSurge,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGAetherSurge,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGTemporalTwist,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGTemporalTwist,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGMysteryOfSorcery,2)>0) THEN {
     IF (HASCOMBATGLOBAL(W,CGBlur,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGMassInvisibility,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGCounterMagic,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGAetherSurge,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGTemporalTwist,2)=0)
     THEN {
      SETCOMBATGLOBAL(W,CGMysteryOfSorcery,2,0);
     }
    }

    IF (HASCOMBATGLOBAL(W,CGBlazingMarch,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGBlazingMarch,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGWarpReality,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGWarpReality,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGBreakthrough,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGBreakthrough,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGBeatOfSwiftness,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGBeatOfSwiftness,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGConduitOfChaos,2)>0) THEN {
     IF (HASCOMBATGLOBAL(W,CGBlazingMarch,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGWarpReality,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGBreakthrough,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGBeatOfSwiftness,2)=0)
     THEN {
      SETCOMBATGLOBAL(W,CGConduitOfChaos,2,0);
     }
    }

    IF (HASCOMBATGLOBAL(W,CGPrayer,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGPrayer,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGSupremeLight,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGSupremeLight,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGHighPrayer,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGHighPrayer,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGTrueLight,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGTrueLight,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGEyeOfHeaven,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGEyeOfHeaven,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGDayOfLife,2)>0) THEN {
     IF (HASCOMBATGLOBAL(W,CGPrayer,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGSupremeLight,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGHighPrayer,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGTrueLight,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGEyeOfHeaven,2)=0)
     THEN {
      SETCOMBATGLOBAL(W,CGDayOfLife,2,0);
     }
    }

    IF (HASCOMBATGLOBAL(W,CGDarkness,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGDarkness,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGManaLeak,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGManaLeak,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGTerror,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGTerror,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGGateOfHades,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGGateOfHades,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGBlackPrayer,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGBlackPrayer,2,0); }
    }
    IF HASCOMBATGLOBAL(W,CGNightOfDeath,2)>0) THEN {
     IF (HASCOMBATGLOBAL(W,CGDarkness,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGManaLeak,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGTerror,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGGateOfHades,2)=0)
      %OR (HASCOMBATGLOBAL(W,CGBlackPrayer,2)=0)
     THEN {
      SETCOMBATGLOBAL(W,CGNightOfDeath,2,0);
     }
    }

    IF (HASCOMBATGLOBAL(W,CGPlague,1)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGPlague,1,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGGoblinPox,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGGoblinPox,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGRally,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGRally,2,0); }
    }
    IF (HASCOMBATGLOBAL(W,CGTabulaRasa,2)>0) THEN {
     IF (RND(3)=0) THEN { SETCOMBATGLOBAL(W,CGTabulaRasa,2,0); }
    }

   !NOTABULARASA!

   :Trap expiration :
   IF (GETENCHANTMENTFLAG(U,EncTrapped,1)>0) THEN { GOTO "NOTINTRAP"; }

    SETSTAT( U,SEnabler,1,( GETSTAT(U,SEnabler,1)-1 ) );
    IF ((GETSTAT(U,SEnabler,1)<1) THEN {
     SETENCHANTMENTFLAG( U,EncTrapped,1,0);
    }

   !NOTINTRAP!

   :Fairy Maze expiration :
   IF (GETCOMBATENCHANTMENTFLAG(U,EncFairyMaze,1)=0) THEN { GOTO "NOTINMAZE"; }

    IF (MAZELUCK=3)
     %OR (GETSTAT(U,AForester,0)>0)
     %OR (GETSTAT(U,AFlying,0)>0)
    THEN {
     SETCOMBATENCHANTMENTFLAG( U,EncFairyMaze,1,0);
    }

   !NOTINMAZE!

   : Water Elemental and Elementalist hero recharge health and ammo on wet or water tile :
   IF (GETSTAT(U,STypeID,1)<>158) %AND (GETSTAT(U,STypeID,1)<>285) THEN { GOTO "NOTWATERELEMENTAL"; }

    IF (GETTERRAIN(CBX,CBY,0)<>CTSea)
     %AND (GETTERRAIN(CBX,CBY,0)<>CTFloating)
     %AND (GETTERRAIN(CBX,CBY,0)<>CTIce)
     %AND (GETTERRAIN(CBX,CBY,0)<>CTSwamp)
    THEN { GOTO "NOTWATERELEMENTAL"; }

    IF (GETTERRAIN(CBX,CBY,0)=CTSea) THEN {
     IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<LTGrassland) THEN {
      COMBATHEAL(U,8,0,1);
      IF (GETSTAT(U,SAmmo,1)<3) THEN {
       SETSTAT(U,SAmmo,1,GETSTAT(U,SAmmo,1)+2);
      } ELSE {
       SETSTAT(U,SAmmo,1,4);
      }
     } ELSE {
      COMBATHEAL(U,4,0,1);
      IF (GETSTAT(U,SAmmo,1)<4) THEN {
       SETSTAT(U,SAmmo,1,GETSTAT(U,SAmmo,1)+1);
      }
     }
     GOTO "NOTWATERELEMENTAL";
    }

     IF (GETTERRAIN(CBX,CBY,0)=CTFloating) THEN {
      IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<LTGrassland) THEN {
       COMBATHEAL(U,2,0,1);
       IF (GETSTAT(U,SAmmo,1)<4) THEN {
        SETSTAT(U,SAmmo,1,GETSTAT(U,SAmmo,1)+1);
       }
      } ELSE {
       COMBATHEAL(U,1,0,1);
      }
      GOTO "NOTWATERELEMENTAL";
     }

      IF (GETTERRAIN(CBX,CBY,0)=CTIce) THEN {
       IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<LTGrassland)
        %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTTundra)
        %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTRiver)
        %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTRiverStart)
       THEN {
        COMBATHEAL(U,2,0,1);
        IF (GETSTAT(U,SAmmo,1)<4) THEN {
         SETSTAT(U,SAmmo,1,GETSTAT(U,SAmmo,1)+1);
        }
       } ELSE {
        COMBATHEAL(U,1,0,1);
       }
       GOTO "NOTWATERELEMENTAL";
      }

       IF (GETTERRAIN(CBX,CBY,0)=CTSwamp) THEN {
        IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTSwamp)
         %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTRiver)
         %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTSorceryNode)
         %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTRiverStart)
        THEN {
         COMBATHEAL(U,2,0,1);
         IF (GETSTAT(U,SAmmo,1)<4) THEN {
          SETSTAT(U,SAmmo,1,GETSTAT(U,SAmmo,1)+1);
         }
        } ELSE {
         COMBATHEAL(U,1,0,1);
        }
        GOTO "NOTWATERELEMENTAL";
       }


   !NOTWATERELEMENTAL!

   : Recharge ability :
   IF ((GetStat(U,SSpellAbility,0))=0) THEN { GOTO "NORECHARGE"; }

    MAXCHARGE=(GetStat(U,SSpellCharges,0));
    CHARGELEFT=(GetStat(U,SChargesLeft,1));
    RECHARGEPOOL=(GetStat(U,SSpellRecharge,0));
    COUNTER=(GetStat(U,SRechargeCounter,1));

    IF (RECHARGEPOOL<1) THEN { GOTO "NORECHARGE"; }

     IF (MAXCHARGE<CHARGELEFT+1) THEN {
      IF (COUNTER<>RECHARGEPOOL) THEN {
       SETSTAT(U,SRechargeCounter,1,RECHARGEPOOL);
      }
      IF (MAXCHARGE<CHARGELEFT) THEN {
       SETSTAT(U,SChargesLeft,1,MAXCHARGE);
      }
     } ELSE {
      IF (COUNTER>0) THEN {
       SETSTAT(U,SRechargeCounter,1,COUNTER-1);
      }
      IF (COUNTER<1) THEN {
       SETSTAT(U,SRechargeCounter,1,RECHARGEPOOL);
       SETSTAT(U,SChargesLeft,1,CHARGELEFT+1);
      }
     }

   !NORECHARGE!

   : Aether Surge replenish 5 MP each turn :
   IF (HASCOMBATGLOBAL(W,CGAetherSurge,1)=0) THEN { GOTO "NOAETHERSURGE"; }

    IF (GetStat(U,SMaxMP,0)<1) THEN { GOTO "NOAETHERSURGE"; }

     IF ( (GetStat(U,SMP,0))<(GetStat(U,SMaxMP,0)-5) ) THEN {
      SETSTAT(U,SMP,1,(GetStat(U,SMP,0)+5));
     } ELSE {
      SETSTAT(U,SMP,1,(GetStat(U,SMaxMP,0)));
     }

   !NOAETHERSURGE!

   GOTO "JUMPOVERTHIS";

  !MYTURNEND!

  : At the end of my turn :

   : Step into deadly smog :
   IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<>LTVolcano)
    %AND (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<>LTChaosNode)
   THEN { GOTO "NOTDEATHSMOG" }

    IF (GETTERRAIN(CBX,CBY,0)<>CTFloating) THEN { GOTO "NOTDEATHSMOG"; }

     IF (GETSTAT(U,AFlying,0)>0) %OR (GETSTAT(U,AMountaineer,0)>0) THEN { GOTO "NOTDEATHSMOG"; }

      IF (GETSTAT(U,APoisonImmunity,0)>0) THEN { GOTO "NOTTOUCHPOISONFUME"; }

       CURRENTFIGURE=( GETSTAT(U,SFigures,1) - %I( (GETDAMAGE(U,0))/(GETSTAT(U,SHP,0)) ) );
       DAMAGE=1*CURRENTFIGURE;

       DEALCOMBATDAMAGE (U,DAMAGE,0,0);

      !NOTTOUCHPOISONFUME!

      IF (GETSTAT(U,AFireImmunity,0)>0) THEN { GOTO "NOTTOUCHLAVA"; }

       ATTACK=10;
       HIT=60;
       DAMAGE=0;
       DEFEND=( GetStat(U,SToDefend,0) );
       ARMOR=( GetStat(U,SDefense,0) );
        IF (GETENCHANTMENTFLAG(U,EncResistElements,0)>0) THEN { ARMOR=ARMOR+4; }
        IF (GETENCHANTMENTFLAG(U,EncElementalArmor,0)>0) THEN { ARMOR=ARMOR+12; }
        IF (GETENCHANTMENTFLAG(U,EncBless,0)>0) THEN { ARMOR=ARMOR+7; }

       : Make attack roll for 10 damage at 60% to-hit :
       LOOP{
        IF (ATTACK>0) THEN {
         ATTACK=(ATTACK-1);
         PERCENT=(RND(100));
         IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
        }
       }ENDLP (ATTACK=0);

       : Make defense roll with armor and to-defend :
       IF (DAMAGE>0) THEN { 
        LOOP{
         IF (ARMOR>0) THEN {
          ARMOR=(ARMOR-1);
          PERCENT=(RND(100));
          IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
         }
        }ENDLP (ARMOR=0);
        IF (DAMAGE>0) THEN { DEALCOMBATDAMAGE (U,DAMAGE,0,0); }
       }

      !NOTTOUCHLAVA!

   !NOTDEATHSMOG!

   : Step into the fairy maze :
   IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<>LTNatureNode) THEN { GOTO "NOTFAIRYMAZE"; }
    IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)>0) THEN { GOTO "NOTFAIRYMAZE"; }

     IF (MAZELUCK>0) THEN { GOTO "NOTFAIRYMAZE"; }

      IF (GETTERRAIN(CBX,CBY,0)<>CTForest)
       %AND (GETTERRAIN(CBX,CBY,0)<>CTPine)
      THEN { GOTO "NOTFAIRYMAZE"; }

       IF (GETSTAT(U,AForester,0)>0)
        %OR (GETSTAT(U,AFlying,0)>0)
        %OR (GETSTAT(U,SRace,0)=RCNature)
        %OR (GETCOMBATENCHANTMENTFLAG(U,EncFairyMaze,1)>0)
       THEN { GOTO "NOTFAIRYMAZE"; }

        SETCOMBATENCHANTMENTFLAG(U,EncFairyMaze,1,1);

   !NOTFAIRYMAZE!

   : Step into the trap :
   IF (GETTERRAIN(CBX,CBY,0)<CTTrap) THEN { GOTO "NOTTRAPTILE"; }

    IF (GETSTAT(U,AFlying,0)>0) THEN { GOTO "NOTTRAPTILE"; }
    IF (GETSTAT(U,ANoncorporeal,0)>0) THEN { GOTO "NOTTRAPTILE"; }

    IF (GETSTAT(U,SSpellAbility,0)=283)
     %OR (GETSTAT(U,STypeID,1)=8)
     %OR (GETSTAT(U,STypeID,1)=16)
     %OR (GETSTAT(U,STypeID,1)=135)
     %OR (GETSTAT(U,STypeID,1)=210)
    THEN { GOTO "NOTTRAPTILE"; }

     IF (GETTERRAIN(CBX,CBY,0)<25) %AND (W=A) THEN {

      ATTACK=5*( GetStat(U,SCombatMaxMoves,0) );
      IF (ATTACK<10) THEN { ATTACK=10; }
      HIT=60;
      ARMOR=( GetStat(U,SDefense,0) );
      DEFEND=( GetStat(U,SToDefend,0) );
      DAMAGE=0;

      : Make attack roll for 5x(maximum combat movement) damage at 60% to-hit :
      LOOP{
       IF (ATTACK>0) THEN {
        ATTACK=(ATTACK-1);
        PERCENT=(RND(100));
        IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
       }
      }ENDLP (ATTACK=0);

      : Make defense roll with armor and to-defend :
      IF (DAMAGE>0) THEN { 
       LOOP{
        IF (ARMOR>0) THEN {
         ARMOR=(ARMOR-1);
         PERCENT=(RND(100));
         IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
        }
       }ENDLP (ARMOR=0);
      }

      : If damage less that 0, set to 0 :
      IF (DAMAGE>0) THEN {
       DEALCOMBATDAMAGE (U,DAMAGE,0,0);
       SETENCHANTMENTFLAG(U,EncTrapped,1,1);
       SETSTAT( U,SEnabler,1,4 )
      }

      SETTERRAIN (CBX,CBY,0,GETTERRAIN(CBX,CBY,0)-12);
     }
     IF (GETTERRAIN(CBX,CBY,0)>24) %AND (W=D) THEN {

      ATTACK=5*( GetStat(U,SCombatMaxMoves,0) );
      IF (ATTACK<10) THEN { ATTACK=10; }
      HIT=60;
      ARMOR=( GetStat(U,SDefense,0) );
      DEFEND=( GetStat(U,SToDefend,0) );
      DAMAGE=0;

     : Make attack roll for 5x(maximum combat movement) damage at 60% to-hit :
      LOOP{
       IF (ATTACK>0) THEN {
        ATTACK=(ATTACK-1);
        PERCENT=(RND(100));
        IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
       }
      }ENDLP (ATTACK=0);

      : Make defense roll with armor and to-defend :
      IF (DAMAGE>0) THEN { 
       LOOP{
        IF (ARMOR>0) THEN {
         ARMOR=(ARMOR-1);
         PERCENT=(RND(100));
         IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
        }
       }ENDLP (ARMOR=0);
      }

      : If damage less that 0, set to 0 :
      IF (DAMAGE>0) THEN {
       DEALCOMBATDAMAGE (U,DAMAGE,0,0);
       SETENCHANTMENTFLAG(U,EncTrapped,1,1);
       SETSTAT( U,SEnabler,1,4 )
      }

      SETTERRAIN (CBX,CBY,0,GETTERRAIN(CBX,CBY,0)-24);
     }

   !NOTTRAPTILE!


   IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)=0) THEN { GOTO "NOCORRUPTIONCOMBAT"; }
    IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())>12)
     %AND (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<16)
    THEN { GOTO "NOCORRUPTIONCOMBAT"; }

     IF (GETSTAT(U,APoisonImmunity,0)>0) THEN { GOTO "NOCORRUPTIONCOMBAT"; }
     IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "NOCORRUPTIONCOMBAT"; }
     IF (GETSTAT(U,SCustomAttribute,0)=2) THEN { GOTO "NOCORRUPTIONCOMBAT"; }

      IF (GETTERRAIN(CBX,CBY,0)<>CTrock)
       %AND (GETTERRAIN(CBX,CBY,0)<>CTDesert)
       %AND (GETTERRAIN(CBX,CBY,0)<>CTSwamp)
      THEN { GOTO "NOCORRUPTIONCOMBAT"; }

       RE=(GETSTAT(U,SResist,0);
       RADIATE=1+RND(10);

       IF (RE>RADIATE) THEN { GOTO "NOCORRUPTIONCOMBAT"; }

        : CURRENTFIGURE = ( GETSTAT(U,SFigures,1) - %I( (GETDAMAGE(U,0))/(GETSTAT(U,SHP,0)) ) ); :
        DAMAGE = ( 1 );

        DEALCOMBATDAMAGE (U,DAMAGE,0,0);

   !NOCORRUPTIONCOMBAT!

   : Freezing Rain is randomly frozen enemy :
   IF (HASCOMBATGLOBAL(Activeplayer,CGFreezingRain,1)=0) THEN { GOTO "NOFREEZINGRAIN"; }

    IF (GETSTAT(U,AColdImmunity,0)>0) THEN { GOTO "NOFREEZINGRAIN"; }

     ATTACK=4;
     HIT=60;
     ARMOR=( GetStat(U,SDefense,0) );
     DEFEND=( GetStat(U,SToDefend,0) );
     DAMAGE=0;

     : Make attack roll for 4 damage at 60% to-hit :
     LOOP{
      IF (ATTACK>0) THEN {
       ATTACK=(ATTACK-1);
       PERCENT=(RND(100));
       IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
      }
     }ENDLP (ATTACK=0);

     : Make defense roll with armor and to-defend :
     IF (DAMAGE>0) THEN { 
      LOOP{
       IF (ARMOR>0) THEN {
        ARMOR=(ARMOR-1);
        PERCENT=(RND(100));
        IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
       }
      }ENDLP (ARMOR=0);
     }

     : If damage less that 0, set to 0 :
     IF (DAMAGE>0) THEN {
      DEALCOMBATDAMAGE (U,DAMAGE,0,0);
     }
     IF (GETSTAT(U,ANoncorporeal,0)=0) %AND (GETENCHANTMENTFLAG(U,EncImmolation,0)=0) THEN {
      FREEZE=RND(2);
      SETENCHANTMENTFLAG(U,EncFrozen,1,FREEZE);
     } ELSE { SETENCHANTMENTFLAG(U,EncFrozen,1,0); }

   !NOFREEZINGRAIN!

   : Death Reckoning deal 4 undead damage and 13% chance to black sleep :
   IF (HASGLOBAL(Activeplayer,GEDeathReckoning)=0) THEN { GOTO "NODEATHRECKONING"; }

    IF (GETSTAT(U,ADeathImmunity,0)=0) THEN {
     DDAMAGE=RND(4)+1;
     DEALCOMBATDAMAGE (U,0,DDAMAGE,0);
    }
    IF ( RND(100) < 13 )
     %AND (GETSTAT(U,AMagicImmunity,0)=0)
    THEN {
     IF (ISHERO(U)) %OR (BASEFANTASTIC(U)=0) THEN {
      SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
     } ELSE {
      SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
     }
    }

   !NODEATHRECKONING!


!JUMPOVERTHIS!

NEXT U;

IF (POXBEARERA=0) THEN {
 IF (HASCOMBATGLOBAL(A,CGGoblinPox,1)>0) THEN {
  SETCOMBATGLOBAL( A,CGGoblinPox,1,0 );
 }
} ELSE {
 IF (HASCOMBATGLOBAL(A,CGGoblinPox,1)=0) THEN {
  SETCOMBATGLOBAL( A,CGGoblinPox,1,1 );
 }
}

IF (POXBEARERD=0) THEN {
 IF (HASCOMBATGLOBAL(D,CGGoblinPox,1)>0) THEN {
  SETCOMBATGLOBAL( D,CGGoblinPox,1,0 );
 }
} ELSE {
 IF (HASCOMBATGLOBAL(D,CGGoblinPox,1)=0) THEN {
  SETCOMBATGLOBAL( D,CGGoblinPox,1,1 );
 }
}


: Terrain distortion in Sorcery node :
IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())<>LTSorceryNode) THEN { GOTO "NOTSORCERYNODE"; }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)>0) THEN { GOTO "NOTSORCERYNODE"; }

  IF (GETTERRAIN(1,12,0)<>CTSea) THEN { SETTERRAIN(1,12,0,CTSea); }

   FOR X=2 TO 20;
   FOR Y=2 TO 20;

    IF ( (X<>7) %OR (Y<>11) ) THEN {
     IF (Activeplayer=D) THEN {
      IF (GETTERRAIN(X,Y,0)=CTSwamp) %AND ((RND(5))>2) THEN { SETTERRAIN(X,Y,0,CTGrass); }
      IF (GETTERRAIN(X,Y,0)=CTCenter) %AND ((RND(5))>0) THEN { SETTERRAIN(X,Y,0,CTSwamp); }
     }
     IF (Activeplayer=A) THEN {
      IF (GETTERRAIN(X,Y,0)=CTSwamp) %AND ((RND(5))=0) THEN { SETTERRAIN(X,Y,0,CTCenter); }
      IF (GETTERRAIN(X,Y,0)=CTGrass) %AND ((RND(5))<2) THEN { SETTERRAIN(X,Y,0,CTSwamp); }
     }
    }

   NEXT Y;
   NEXT X;

!NOTSORCERYNODE!

HALT:
