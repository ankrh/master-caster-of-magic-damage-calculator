:	INPUT - None
	OUTPUT - None. Use the ADDABILITYLINE command to display abilities.
	(Unit aura and node information is still hardcoded.)
:

ETERNAL=0;
SURGE=0;
ORDER=0;
KING=0;

FOR J=0 TO NOFWIZARDS();
IF HASGLOBAL(J,GEEternalNight) THEN {IF ((J<>DEFENDER()) %AND (J<>ATTACKER())) THEN { ETERNAL=ETERNAL+1; }; };
IF HASGLOBAL(J,GEKingofUnderworld) THEN { IF ((J<>DEFENDER()) %AND (J<>ATTACKER())) THEN { KING=KING+1; }; };
IF (HASGLOBAL(J,GEChaosSurge)) THEN { SURGE=SURGE+1; };
IF (HASGLOBAL(J,GEDivineOrder)) THEN { ORDER=ORDER+1; };
NEXT J;

for J=1 to 2;
IF J=1 then { W=DEFENDER(); } ELSE { W=ATTACKER(); }
IF W<>NeutralplayerID  THEN {
IF HasGlobal(W,GEInnerPower) then { AddAbilityLine J,27,"Spell Inner Power","Inner Power"; };
IF HasGlobal(W,GEBlazingEyes) then { AddAbilityLine J,28,"Spell Blazing Eyes","Blazing Eyes"; };
IF HasGlobal(W,GERulerofHeaven) then { AddAbilityLine J,29,"Spell Ruler of Heaven","Ruler of Heaven"; };
IF HasGlobal(W,GEKingofUnderworld) then { AddAbilityLine J,30,"Spell Ruler of Underworld","Ruler of Underworld"; };
IF HasGlobal(W,GEReinforceMagic) then { AddAbilityLine J,31,"Spell Reinforce Magic","Reinforce Magic"; };
IF HasGlobal(W,GEWindMastery) then { AddAbilityLine J,32,"Spell Wind Mastery","Wind Mastery"; };
IF HasGlobal(W,GEFateMastery) then { AddAbilityLine J,33,"Spell Fate Mastery","Fate Mastery"; };
IF HasGlobal(W,GECrusade) then { AddAbilityLine J,1,"Spell Crusade","Crusade"; };
IF HasGlobal(W,GEZombieMastery) then { AddAbilityLine J,10,"Spell Zombie Mastery","Zombie Mastery"; };
IF HasGlobal(W,GEHolyArms) then { AddAbilityLine J,2,"Spell Holy Arms","Holy Arms"; };
IF HasGlobal(W,GEEternalNight) then { AddAbilityLine J,22,"Spell Eternal Night","Eternal Night"; };
IF HasGlobal(W,GEEvilOmens) then { AddAbilityLine J,23,"Spell Evil Omens","Evil Omens"; };
IF HasGlobal(W,GEAEtherBinding) then { AddAbilityLine J,24,"Spell AEther Binding","AEther Binding"; };
IF HasGlobal(W,GEHerbMastery) then { AddAbilityLine J,25,"Spell Herb Mastery","Herb Mastery"; };
IF HasGlobal(W,GESurvivalInstinct) then { AddAbilityLine J,26,"Spell Survival Instinct","Survival Instinct"; };
IF HasGlobal(W,GECharmOfLife) then { AddAbilityLine J,4,"Spell Charm of Life","Charm of Life"; };
};
NEXT J;

if Order>0 then {
S$="";
IF ORDER>1 THEN { S$=S$+" x"+STRS(Order); };
AddAbilityLine 3,20,"Spell Divine Order","Divine Order"+S$);
};

if Surge>0 then {
S$="";
IF Surge>1 THEN { S$=S$+" x"+STRS(Surge); };
AddAbilityLine 3,21,"Spell Chaos Surge","Chaos Surge"+S$);
};

if Eternal>0 then {
S$="";
IF Eternal>1 THEN { S$=S$+" x"+STRS(Eternal); };
AddAbilityLine 3,22,"Spell Eternal Night","Eternal Night"+S$);
};

if King>0 then {
AddAbilityLine 3,30,"Spell Ruler of Underworld","Ruler of Underworld";
};

C=Cityontile(combatP(),combatX(),combatY());

IF C>0 THEN {
IF CITYENCHANT(C,CENatureWard)>=0  THEN { AddAbilityLine 3,15,"Spell Spell Ward","Nature Ward"; };
IF CITYENCHANT(C,CESorceryWard)>=0  THEN { AddAbilityLine 3,16,"Spell Spell Ward","Sorcery Ward"; };
IF CITYENCHANT(C,CEChaosWard)>=0  THEN { AddAbilityLine 3,17,"Spell Spell Ward","Chaos Ward"; };
IF CITYENCHANT(C,CELifeWard)>=0  THEN { AddAbilityLine 3,18,"Spell Spell Ward","Life Ward"; };
IF CITYENCHANT(C,CEDeathWard)>=0  THEN { AddAbilityLine 3,19,"Spell Spell Ward","Death Ward"; };
IF CITYENCHANT(C,CEHeavenlyLight)>=0  THEN { AddAbilityLine 1,3,"Spell Heavenly Light","Heavenly Light"; };
IF CITYENCHANT(C,CECloudOfShadow)>=0  THEN { AddAbilityLine 1,9,"Spell Cloud of Shadow","Cloud of Shadow"; };
}


for J=1 to 2;
IF J=1 then { W=DEFENDER(); } ELSE { W=ATTACKER(); }
IF W<>NeutralplayerID  THEN {
:Debuglog "Info script W="+STRS(W);:
IF Retort(W,Specialist) THEN {
RE=PRIMARYREALM(W);
IF RE=1 THEN { AddAbilityLine J,-53,"Retort Specialist","Nature Specialist"; };
IF RE=2 THEN { AddAbilityLine J,-53,"Retort Specialist","Sorcery Specialist"; };
IF RE=3 THEN { AddAbilityLine J,-53,"Retort Specialist","Chaos Specialist"; };
IF RE=4 THEN { AddAbilityLine J,-53,"Retort Specialist","Life Specialist"; };
IF RE=5 THEN { AddAbilityLine J,-53,"Retort Specialist","Death Specialist"; };
};
IF Retort(W,Warlord) THEN { AddAbilityLine J,-53,"Retort Warlord","Warlord"; };
IF Retort(W,Alchemy) THEN { AddAbilityLine J,-53,"Retort Alchemy","Alchemy"; };
IF Retort(W,Tactician) THEN { AddAbilityLine J,-53,"Retort Tactician","Tactician"; };
IF Retort(W,Channeler) THEN { AddAbilityLine J,-53,"Retort Channeler","Channeler"; };
IF Retort(W,Runemaster) THEN { AddAbilityLine J,-53,"Retort Runemaster","Runemaster"; };
IF Retort(W,Conjurer) THEN { AddAbilityLine J,-53,"Retort Conjurer","Conjurer"; };
IF Retort(W,Astrologer) THEN { AddAbilityLine J,-53,"Retort Astrologer","Astrologer"; };
IF ((C>0) %AND (W=DEFENDER())) THEN { IF (Retort(W,Guardian)) THEN { AddAbilityLine J,-53,"Retort Guardian","Guardian"; }; };
};
NEXT J;

IF EventTurn(EvNatureC)>0 THEN {
AddAbilityLine 3,38,"Nature Conjunction","Nature Conjunction";
}

IF EventTurn(EvChaosC)>0 THEN {
AddAbilityLine 3,37,"Chaos Conjunction","Chaos Conjunction";
}

IF EventTurn(EvBadMoon)>0 THEN {
AddAbilityLine 3,34,"Bad Moon","Bad Moon";
}

IF EventTurn(EvGoodMoon)>0 THEN {
AddAbilityLine 3,35,"Good Moon","Good Moon";
}
