: Calculate the casting skill for a wizard.
INPUT W = the wizard to calculate
OUTPUT BASE = Base skill, COMBAT = combat skill, OVERLAND = Overland skill 

Avoid changing the way base skill is calculated at this time.
In the current version, the fractional skill gain shown on the Magic subscreen,
as well as the starting SP of each player assumes the Base Skill formula is Skill=Sqrt(SP)
:

IF W=0 THEN {
 MASTERVARSET CityInFocus = -1;
}

SP=GETSP(W);
C=0
FOR I=1 to 5;
IF BOOKS(W,I)<4 THEN {C=C+BOOKS(W,I); }
NEXT;

IF (RETORT(W,Archmage)>0) THEN { C=%I(3*C/2); }

SP=SP+C*32;

IF (GETWIZARDDATA(W,WDMuggleWizard)>0)
 %AND ( ( (W=0) %AND (SCORINGOPTION(SReturnOfTheMaster)=0) )
  %OR ( (W>0) %AND (GETWIZARDDATA(W,WDMasterWizard)<1) ) )
THEN { SP=%I(SP/2); }

IF ( (BOOKS(W,1)+BOOKS(W,2)+BOOKS(W,3)+BOOKS(W,4)+BOOKS(W,5))=0 ) THEN { SP=0; }

BASE=SQRT(SP);

TSEFFECT=TSTURNCOUNTING*3;
IF (TSEFFECT>90) THEN { TSEFFECT=90; }

: record Base Casting Skill for using by other files :
IF (W>-1) %AND (W<NOFWIZARDS()+1) THEN { SETWIZARDDATA(W,WDBaseSkill,BASE); }


: Combat skill start here :

: Combat skill from buildings :

CITYCS=0

CITYCS=CITYCS+(180*(BUILDINGSOWNED(W,BMonument,0)-(BUILDINGSOWNED(W,BMonument,CEAetherSink)/2)));
CITYCS=CITYCS+(1200*(BUILDINGSOWNED(W,BLinkingTower,0)-(BUILDINGSOWNED(W,BLinkingTower,CEAetherSink)/2)));

IF (SPELLSTATE(W,STMagitekTechnoGeomancy)=2) THEN { CITYCS=2*CITYCS; }

CITYCS=CITYCS+(360*(BUILDINGSOWNED(W,BMonument,CEMagicPerimeter)));
CITYCS=CITYCS+(1200*(BUILDINGSOWNED(W,BLinkingTower,CEMagicPerimeter)));

: Combat skill from Ruler of Heaven :

IF HasGlobal(W,GERulerOfHeaven) THEN {
 ROH=0
 ROH=ROH+(5*BUILDINGSOWNED(W,0,CEHeavenlyLight));
 ROH=ROH+(4*BUILDINGSOWNED(W,BShrine,0));
 ROH=ROH+(6*BUILDINGSOWNED(W,BParthenon,0));
 ROH=ROH+(8*BUILDINGSOWNED(W,BCathedral,0));
 ROH=ROH+(6*BUILDINGSOWNED(W,BTemple,0));
 IF HASGLOBAL(W,GEKingOfUnderworld) THEN {
  ROH=ROH+(6*BUILDINGSOWNED(W,BOracle,0));
 }
 CITYCS=CITYCS+(50*ROH);
}


: Combat skill from Power Link :

IF (HASGLOBAL(W,GEPowerLink)=0) THEN { GOTO "CONOPOWERLINK"; }

 PLSC=0
 FOR I=0 TO NOFWIZARDS();
 IF (I<>W) THEN {
  PLSC=PLSC+(180*(BUILDINGSOWNED(I,BMonument,0)));
  PLSC=PLSC+(1200*(BUILDINGSOWNED(I,BLinkingTower,0)));
 }
 NEXT;
 CITYCS=CITYCS+PLSC;

!CONOPOWERLINK!


: new effect of chaos procurator, more casting skill from city :

IF RETORT(W,Procurator) THEN {
 IF BOOKS(W,Chaos)>0 THEN {
  CITYCS=CITYCS+(%I((CITYCS*(((BOOKS(W,Chaos)-1)*3)+12))/100));
 }
}


: Final combat skill :

COMBAT=SQRT(SP+CITYCS);

: Initial Master Wizard combat casting skill bonus :
:
IF (GETWIZARDDATA(W,WDMasterWizard)>0)
 %AND (GETWIZARDDATA(W,WDMuggleWizard)<1)
THEN { COMBAT=COMBAT+10; }
:


: Overland skill start here :

: Initial overland penalty :

OVERLAND=BASE-%I((BOOKS(W,Life)+BOOKS(W,Death)+BOOKS(W,Chaos)+BOOKS(W,Sorcery)+BOOKS(W,Nature))/3);

: Initial Master Wizard overland casting skill bonus :
:
IF (GETWIZARDDATA(W,WDMasterWizard)>0)
 %AND (GETWIZARDDATA(W,WDMuggleWizard)<1)
THEN { OVERLAND=OVERLAND+10; }
:

: AI overland casting skill bonus :

IF (W>0) %AND (DIFFICULTY()>3) THEN { OVERLAND=OVERLAND+(%I(((DIFFICULTY()-3)*OVERLAND)/10); }

: Overland skill from buildings :

AMPTOWER=0

IF (SPELLSTATE(W,STMagitekTechnoGeomancy)=2) THEN {
 AMPTOWER=2*(%I(7*(BUILDINGSOWNED(W,BAmplifyingTower,0)-(BUILDINGSOWNED(W,BAmplifyingTower,CEAetherSink)/2))
} ELSE {
 AMPTOWER=(%I(7*(BUILDINGSOWNED(W,BAmplifyingTower,0)-(BUILDINGSOWNED(W,BAmplifyingTower,CEAetherSink)/2))
}

NOFPOWERLINK=0;

FOR I=0 TO NOFWIZARDs();

 IF (HASGLOBAL(I,GEPowerLink)>0) THEN { NOFPOWERLINK=NOFPOWERLINK+1; }

NEXT I;

AMPTOWER=AMPTOWER - ( 3 * NOFPOWERLINK * (BUILDINGSOWNED(W,BAmplifyingTower,0) );

OVERLAND=OVERLAND+AMPTOWER;
OVERLAND=OVERLAND+(1*BUILDINGSOWNED(W,BLibrary,CEUranusBless));
OVERLAND=OVERLAND+(1*BUILDINGSOWNED(W,BUniversity,CEUranusBless));
OVERLAND=OVERLAND+(2*BUILDINGSOWNED(W,BSagesGuild,CEUranusBless));
OVERLAND=OVERLAND+(1*BUILDINGSOWNED(W,BWizardsGuild,CEUranusBless));


: Overland skill from Pillar of Faith :
IF (SPELLSTATE(W,SPillarOfFaith)<>2) THEN { GOTO "NOPILLAROFFAITH"; }

 PILLAR=0;

 FOR C=1 TO MAXCITY();

   IF (CITYOWNER(C)=W) %AND (CITYENCHANT(C,CEPillarOfFaith)>-1) THEN {
    PILLAR=PILLAR+(GETCITYDATA(C,CDRELRED));
   }

 NEXT C;

 OVERLAND=OVERLAND+%I(PILLAR/2);

!NOPILLAROFFAITH!

: Overland skill from Fairy Ring :

IF HasGlobal(W,GEFairyRing) THEN {
 OVERLAND=OVERLAND+10+(1*BUILDINGSOWNED(W,BAnimistGuild,0));
}


: Overland skill from Power Link :

IF (HASGLOBAL(W,GEPowerLink)=0) THEN { GOTO "OLNOPOWERLINK"; }

 PLOVERLAND=0
 FOR I=0 TO NOFWIZARDS();

  PLOVERLAND=PLOVERLAND+(3*(BUILDINGSOWNED(I,BAmplifyingTower,0)));

 NEXT;
 OVERLAND=OVERLAND+PLOVERLAND;

!OLNOPOWERLINK!

OVERLAND=%I( OVERLAND*( (100-TSEFFECT)/100 ) );

IF (OVERLAND<1) THEN { OVERLAND=1; }

: not for gameplay, This setting is for optimization test by disable all overland spell casting :
:
OVERLAND=0;
:
