:
INPUT - W - The wizard who is casting the spell
        SP - The spell being cast
        REALM - The ream of the spell being cast
        PRIMARY - The primary realm of the wizard.
        GROUP - The spellgroup of the spell that determines the type of effects.
        CATEGORY - The displayed category of the spell in the spellbook.
OUTPUT - CM - The multiplier of the casing cost.       
:

CM=1;

: Retorts and Books - Wizard specific cost modifiers are not valid for the neutral player! :

:
DEBUGLOG "Input data"
DEBUGLOG STRS(W);
DEBUGLOG STRS(SP);
DEBUGLOG STRS(REALM);
DEBUGLOG STRS(GROUP);
DEBUGLOG STRS(CATEGORY); :

: Set Marionette back to castable range after prevent summon by Pandora Box :
IF (SP=SMarionetteSummon) THEN {
 IF (RETORT(W,Channeler)) %AND (ISCOMBAT()=0) THEN {
  CM=CM/100;
 }
}

: Scaling overland casting cost setting :

LANDSCALE=LANDSIZE()-3
IF (LANDSCALE<1) THEN { LANDSCALE=1; }

WIZARDSCALE=(NOFWIZARDS())-5
IF (WIZARDSCALE<1) THEN { WIZARDSCALE=1; }

IF ( (LANDSCALE=1) %AND (WIZARDSCALE=1) ) %OR (ISCOMBAT()=1) THEN { GOTO "NOOVERLANDSCALE"; }

 IF (GROUP=SGGlobalEnchantment)
   %AND (SP<>SNaturalSelection)
   %AND (SP<>SAuraofMajesty)
   %AND (SP<>SSpiritOfCommunity)
   %AND (SP<>SDetectMagic)
 THEN {
  CM=CM*(1 + (((LANDSCALE)*(WIZARDSCALE))/30) );
 }

 IF (SP=SDisjunction) THEN {
  CM=CM*(1 + (((LANDSCALE)*(WIZARDSCALE))/30) );
 }

 IF (SP=SFinalWave)
  %OR (SP=SGreatUnsummoning)
  %OR (SP=SSpellBinding)
  %OR (SP=SDivineJudgement)
 THEN {
  CM=CM*(1 + (((LANDSCALE)*(WIZARDSCALE))/30) );
 }

 IF (GROUP=SGUnitBuff)
  %OR (GROUP=SGUnitBuffNormalUnit)
  %OR (GROUP=SGUnitCurse)
  %OR (GROUP=SGUnitcurseNoSaves)
  %OR (GROUP=SGUnitCurseNormalUnit)
  %OR (GROUP=SGCityBuff)
  %OR (GROUP=SGCityCurse)
  %OR (GROUP=SGCityCurse)
  %OR (SP=SStoneGiant)
  %OR (SP=SGorgons)
  %OR (SP=SThunderbird)
  %OR (SP=SBehemoth)
  %OR (SP=SColossus)
  %OR (SP=SGreatWyrm)
  %OR (SP=SCloudGiant)
  %OR (SP=SKraken)
  %OR (SP=SDjinn)
  %OR (SP=SSkyDrake)
  %OR (SP=SChaosSpawn)
  %OR (SP=SEfreet)
  %OR (SP=SDoomBat)
  %OR (SP=SHydra)
  %OR (SP=SGreatDrake)
  %OR (SP=SValkyries)
  %OR (SP=SAngel)
  %OR (SP=SArchAngel)
  %OR (SP=SPhoenix)
  %OR (SP=SWraiths)
  %OR (SP=SSummonDemon)
  %OR (SP=SVampireLord)
  %OR (SP=SDeathKnights)
  %OR (SP=SDemonLord)
  %OR (SP=SEarthLore)
  %OR (SP=SChangeTerrain)
  %OR (SP=STransmute)
  %OR (SP=SBlizzard)
  %OR (SP=SEarthquake)
  %OR (SP=SStasis)
  %OR (SP=SDispellingWave)
  %OR (SP=SCorruption)
  %OR (SP=SRaiseVolcano)
  %OR (SP=SFireStorm)
  %OR (SP=SWarpNode)
  %OR (SP=SDisenchantArea)
  %OR (SP=SPlaneShift)
  %OR (SP=SDisillusionise)
 THEN {
  CM=CM*(1 - (((LANDSCALE)*(WIZARDSCALE))/150) );
 }

!NOOVERLANDSCALE!

: Evil Omens :
NOFOMENS=0;
FOR I=0 TO NOFWIZARDS();
IF (I<>W) %AND (HASGLOBAL(I,GEEvilOmens)) THEN { NOFOMENS=NOFOMENS+1; }
NEXT I;

IF (HASGLOBAL(W,GEEvilOmens)) THEN { GOTO "HASEVILOMEN"; }

 IF NOFOMENS>0 THEN { 
  CM=(CM*(100+(25*(1+NOFOMENS))))/100;
 } ELSE {
  CM=CM*1;
 }

!HASEVILOMEN!

: Events :
IF (EVENTTURN(EvFlux)>0) %AND (SP<>SSpellofMastery) THEN {
 CM=(CM*2)/3;
}

IF (EVENTTURN(EvGoodMoon)>0) %AND ((CATEGORY=4) %OR (REALM=4)) THEN {
 CM=(CM*2)/3; :Life or Unit Spell:
}

IF (EVENTTURN(EvBadMoon)>0) %AND ((CATEGORY=3) %OR (REALM=5)) THEN {
 CM=(CM*2)/3; :Death or City Spell:
}

IF (EVENTTURN(EvSorceryC)>0) %AND ((CATEGORY=2) %OR (REALM=2)) THEN {
 CM=(CM*2)/3; :Sorcery or Enchantment Spell:
}

IF (EVENTTURN(EvChaosC)>0) %AND ((CATEGORY=5) %OR (REALM=3) %OR (CATEGORY=0)) THEN {
 CM=(CM*2)/3; :Chaos, Special or Combat Spell:
}

IF (EVENTTURN(EvNatureC)>0) %AND ((CATEGORY=1) %OR (REALM=1)) THEN {
 CM=(CM*2)/3; :Nature or Summoning Spell:
}


: Divine Order :

NOFDIVORDER=0;

FOR I=0 TO NOFWIZARDS();
IF HASGLOBAL(I,GEDivineOrder) THEN { NOFDIVORDER=NOFDIVORDER+1; }
NEXT I;

IF (I>5) THEN { I=5; }

IF NOFDIVORDER=0 THEN { GOTO "NODIVINEORDER"; }

: this part effect everyone equally :
 IF (GROUP=SGUnitBuff)
  %OR (GROUP=SGUnitBuffNormalUnit)
  %OR (GROUP=SGCityBuff)
  %OR (SP=SNatureCures)
  %OR (SP=SHealing)
  %OR (SP=SExaltation)
  %OR (SP=SMassHealing)
  %OR (SP=SHeroicHeart)
  %OR (SP=SLycanthropy)
 THEN {
   CM=CM*(100-(12.5*(1+NOFDIVORDER)))/100;
 }

: this part effect effect own caster differently :
 IF (GROUP=SGGlobalEnchantment)
  %OR (GROUP=SGCombatGlobal)
 THEN {
  IF HASGLOBAL(W,GEDivineOrder) THEN {
   CM=CM*(100-(5*(1+NOFDIVORDER)))/100;
  } ELSE {
   CM=CM*(100+(5*(1+NOFDIVORDER)))/100;
  }
 }

 IF (GROUP=SGSummon)
  %OR (SP<>SSummonHero)
  %OR (SP<>SSummonchampion)
 THEN {
  IF HASGLOBAL(W,GEDivineOrder) THEN {
   CM=CM*1;
  } ELSE {
   CM=CM*(100+(5*(1+NOFDIVORDER)))/100;
  }
 }

 IF (GROUP=SGUnitCurse)
  %OR (GROUP=SGUnitcurseNoSaves)
  %OR (GROUP=SGUnitCurseNormalUnit)
  %OR (GROUP=SGCityCurse)
  %OR (GROUP=SGCombatSpell)
  %OR (GROUP=SGSaveorDie)
  %OR (SP=SCracksCall)
  %OR (SP=SEarthquake)
  %OR (SP=SStasis)
  %OR (SP=SGreatUnsummoning)
  %OR (SP=SMagicVortex)
  %OR (SP=SFlameStrike)
  %OR (SP=SApocalypse)
  %OR (SP=SCalltheVoid)
  %OR (SP=SHolyWord)
  %OR (SP=SMassacre)
  %OR (SP=SFinalWave)
  %OR (SP=SChainLightning)
 THEN {
  IF HASGLOBAL(W,GEDivineOrder) THEN {
   CM=CM*1;
  } ELSE {
   CM=CM*(100+(12.5*(1+NOFDIVORDER)))/100;
  }
 }

!NODIVINEORDER!

IF (W=NeutralPlayerID) THEN { GOTO "NOTWIZARD"; }

 BK=BOOKS(W,REALM);
 IF (REALM<>ARCANE) %AND (BK>6) THEN {
  CM=CM*(1-((3*(BK-6))/100));
 }

 IF (PRIMARY=REALM) %AND (RETORT(W,SPECIALIST)) THEN {
  SPMODIFIER=0.88;
  IF (REALM=Nature) %AND (SPELLSTATE(W,SGaiaMastery)=2) THEN { SPMODIFIER=SPMODIFIER-0.5; }
  IF (REALM=Sorcery) %AND (SPELLSTATE(W,SAEtherMastery)=2) THEN { SPMODIFIER=SPMODIFIER-0.5; }
  IF (REALM=Chaos) %AND (SPELLSTATE(W,SChaosMastery)=2) THEN { SPMODIFIER=SPMODIFIER-0.5; }
  IF (REALM=Life) %AND (SPELLSTATE(W,SLifeMastery)=2) THEN { SPMODIFIER=SPMODIFIER-0.5; }
  IF (REALM=Death) %AND (SPELLSTATE(W,SDeathMastery)=2) THEN { SPMODIFIER=SPMODIFIER-0.5; }
  CM=CM*SPMODIFIER;
 }

 IF (RETORT(W,ARTIFICER)) THEN {
  IF (GROUP=SGItemCreation) THEN {CM=CM*0.5;};
 }

 IF (GROUP=SGSummon) %AND (RETORT(W,CONJURER)) THEN {
  CM=CM*0.75;
 }

 IF (RETORT(W,RUNEMASTER)) THEN {
  IF ISCOMBAT() THEN {
   IF (REALM=ARCANE) THEN {
    CM=CM*0.75;
   }
  } ELSE {
   IF (GROUP<>SGItemCreation) THEN {
    IF (REALM=ARCANE)
     %AND (SP<>SMagicSpirit)
     %AND (SP<>SSummonHero)
     %AND (SP<>SSummonchampion)
    THEN {
     CM=CM*0.5;
    } ELSE {
     IF (GROUP<>SGSummon)
      %AND (GROUP<>SGUnitBuff)
      %AND (GROUP<>SGCityBuff)
      %AND (GROUP<>SGCityCurse)
      %AND (GROUP<>SGGlobalEnchantment)
      %AND (GROUP<>SGUnitBuffNormalUnit)
     THEN {
      CM=CM*0.75;
     }
    }
   }
  }
 }

 IF (RETORT(W,ENCHANTER)) %AND (GROUP=SGUnitBuff)
  %OR (GROUP=SGCityBuff)
  %OR (GROUP=SGCityCurse)
  %OR (GROUP=SGGlobalEnchantment)
  %OR (GROUP=SGCombatGlobal)
  %OR (GROUP=SGUnitCurse)
  %OR (GROUP=SGUnitcurseNoSaves)
  %OR (GROUP=SGUnitBuffNormalUnit)
  %OR (GROUP=SGUnitCurseNormalUnit)
 THEN {
  CM=CM*0.75;
 }

 IF (RETORT(W,Channeler))
  %AND (ISCOMBAT()) 
 THEN {
  CM=CM*0.88;
 }

!NOTWIZARD!

: Effect of Time Stop :
CM=CM*(1+(TSSPELLCOUNTING/50));

: Wave of Despair is unaffected by all cost modifiers :
IF SP=SWaveofDespair THEN { CM=1; };

: Outlander could cast Tree of Knowledge for free :
IF (GETWIZARDDATA(W,WDMuggleWizard)>0) %AND (SP=STreeOfKnowledge) THEN { CM=0; }
