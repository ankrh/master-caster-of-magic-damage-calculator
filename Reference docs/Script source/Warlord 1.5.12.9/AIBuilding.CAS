: INPUT C - The city being processed 
		J - The building being processed
		AIOwncities - how many cities are owned by the owner of this city.
		AIEnemyCities - Number of cities on the AI's continent owned by other players
		OWNSHIPS - Number of transport type units owned by the AI.
		CUNREST - The total unrest in the city (number of rebels)
		OVERLANDSKILL - The total overland skill the wizard has
 OUTPUT - PRIO - The calculated priority of the building. Highest will be built. Return -100 if the building is not allowed to be built at all.
:

PRIO=0;
W=CITYOWNER(C);
RACE=CITYRACE(C);
HAVEMITHRIL=OREINRANGE(C,OreMithril);
HAVEADAMANT=OREINRANGE(C,OreAdamantium);
HAVEORIHALCON=OREINRANGE(C,OreOrihalcon);
HAVEIRON=OREINRANGE(C,OreIron);
HAVECOAL=OREINRANGE(C,OreCoal);
MAGICIANSAVAILABLE=1;
IF (RACE=RCBarbarian)
 %OR (RACE=RCDwarf)
 %OR (RACE=RCGnoll)
 %OR (RACE=RCTroll)
 THEN { MAGICIANSAVAILABLE=0; }

IF (j=BWarCollege) %OR (j=BBarracks) THEN {
 CALL "MilitaryPrio";
 CALL "EXPPrio";
 IF CITYENCHANT(c,CEEvilPresence)>-1 THEN { Prio=PRIO-15; }
}

IF (j=BOracle) %AND (CITYENCHANT(c,CEEvilPresence)=-1) THEN { 
 CALL "UnrestPrio"; 
 IF HASGLOBAL(W,GEKingOfUnderworld) THEN { 
  CALL "PowerPrio";
  CALL "ReligionPrio";
 }
}

IF (j=BColosseum) THEN {
 CALL "EconomyPrio";
 CALL "UnrestPrio";
 IF (RACE=RCBarbarian) THEN { CALL "MilitaryPrio";}
 IF Objective(W)=Narcissist THEN { PRIO=PRIO-4; }
}

IF (j=BWarlordHold) THEN {
 CALL "UnrestPrio";
 CALL "MilitaryPrio";
 IF Objective(W)=Narcissist THEN { PRIO=PRIO-4; }
}

IF (J=BStables) %OR (J=BArmory) %OR (J=BFighterGuild) THEN { CALL "MilitaryPrio"; }

IF (j=BFantasticStables) %OR (j=BMaritimeGuild) THEN { 
 CALL "MilitaryPrio"; 
 IF (Objective(W)=Expansionist) THEN { PRIO=PRIO+6; }
}

IF (J=BArmorerGuild) THEN { 
 CALL "MilitaryPrio"; 
 IF (RACE<>RCHalfling) THEN { PRIO=PRIO+(%I((OVERLANDTURN())/12); }
}

IF (j=BAnimistGuild)THEN { 
 CALL "FoodPrio"; 
 IF HASGLOBAL(W,GECallTheWild)
  %OR (RACE=RCKlackon)
  %OR (RACE=RCBeastmen)
  %OR (RACE=RCHighElf)
 THEN { 
  CALL "MilitaryPrio";
 }
}

IF (J=BForesterGuild) THEN { 
 CALL "FoodPrio"; 
 IF (RACE=RCKlackon) %OR (RACE=RCBeastmen) %OR (RACE=RCHighElf) THEN { CALL "MilitaryPrio";}
}

IF (J=BBrewery) THEN { CALL "EconomyPrio"; }

IF (J=BFarmerMarket) THEN { CALL "EconomyPrio"; }

IF (j=BGranary) THEN { 
 CALL "FoodPrio"; 
 IF (RACE=RCKlackon) %OR (RACE=RCBeastmen) %OR (RACE=RCHighElf) THEN { CALL "MilitaryPrio";}
 IF (j=BGranary) %AND (Difficulty()>=DiffExpert) THEN { PRIO=PRIO+20; }
}

IF (j=BDock) THEN {
 CALL "FoodPrio"; 
 IF (OVERLANDTURN()<20) THEN { PRIO=-100; HALT; }
 IF Objective(W)=Expansionist THEN {PRIO=PRIO+6; }
 IF (SpellState(W,SFloatingIsland)<>SSKnown) %AND (ownships=0) THEN {
  Prio=(Prio+29)-(4*Landsize());
 }
 IF ISBUILT(C,BBuilderHall) THEN { 
  CALL "ProductionPrio";
  CALL "EconomyPrio";
 }
}

IF (j=BShipYard) THEN {
 IF (OVERLANDTURN()<20) THEN { PRIO=-100; HALT; }
 IF Objective(W)=Expansionist THEN {PRIO=PRIO+6; }
 IF (SpellState(W,SFloatingIsland)<>SSKnown) %AND (ownships=0) THEN {
  Prio=(Prio+29)-(4*Landsize());
 }
}

IF (j=BMagicMarket) THEN {
 PRIO=PRIO+27;
 CALL "PowerPrio";
 IF MAGICIANSAVAILABLE THEN { CALL "MilitaryPrio"; }
}
IF (j=BLibrary) THEN {
 PRIO=PRIO+20;
 CALL "ResearchPrio";
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { 
  Prio=Prio+3;
  CALL "PowerPrio";
 }
 IF ((HaveMithril+HaveAdamant+HaveOrihalcon)>0) %OR MAGICIANSAVAILABLE THEN {
  PRIO=PRIO+30;
  CALL "MilitaryPrio";
 }
}

IF (j=BSagesGuild) THEN { 
 CALL "ResearchPrio"; 
 IF MAGICIANSAVAILABLE THEN { CALL "MilitaryPrio"; }
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { 
  Prio=Prio+3;
  CALL "PowerPrio";
 }
}

IF (j=BAlchemistguild) THEN {
 CALL "MilitaryPrio";
 IF (HaveMithril+HaveAdamant+HaveOrihalcon)>0 THEN { PRIO=PRIO+30; }
 ELSE { IF Retort(W,Alchemist) THEN { PRIO=PRIO-5; }}
 IF (CITYENCHANT(C,CESorcererStone)>-1) THEN { CALL "EconomyPrio"; }
 CALL "Amplifier";
}

IF (j=BLavaSmelter) THEN {
 CALL "MilitaryPrio";
 IF ((HaveMithril)>0) THEN { PRIO=PRIO+30; }
 IF ((HaveAdamant+HaveOrihalcon)>0) %AND ((HaveOrihalcon)=0) THEN { PRIO=PRIO+30; }
 CALL "Amplifier";
}

IF (j=BMilitaryWorkshop) THEN {
 CALL "MilitaryPrio";
 CALL "Amplifier";
}

IF (j=BIdolOfHeavenlyBull) THEN {
 CALL "FoodPrio"; 
 IF ISBUILT(C,BAnimistGuild) THEN { PRIO=PRIO+10 }
 CALL "MilitaryPrio";
 CALL "Amplifier";
}

IF (j=BUniversity) THEN {
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { 
  Prio=Prio+3;
  CALL "PowerPrio";
 }
 CALL "ResearchPrio";
 IF (RACE<>RCKlackon) %AND (RACE<>RCDraconian) THEN { CALL "ProductionPrio"; }
 IF MAGICIANSAVAILABLE THEN { CALL "MilitaryPrio"; }
}

IF (j=BWizardsguild) THEN {
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { Prio=Prio+3; }
 CALL "ResearchPrio";
 CALL "PowerPrio";
 IF MAGICIANSAVAILABLE THEN { 
  CALL "MilitaryPrio"; 
  PRIO=PRIO+(%I((OVERLANDTURN())/12);
 }
}

IF (j=BAcademy) THEN {
 CALL "ResearchPrio";
 CALL "MilitaryPrio"; 
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { 
  Prio=Prio+3;
  CALL "PowerPrio";
 }
}

IF (j=BAgoge) THEN {
 CALL "ResearchPrio";
 CALL "MilitaryPrio"; 
 IF CITYENCHANT(C,CEUranusBless)>-1) THEN { 
  Prio=Prio+3;
  CALL "PowerPrio";
 }
}

IF  (j=BCathedral) %OR (J=BTemple) %OR (J=BParthenon) %OR (J=BShrine) THEN {
 IF CITYENCHANT(C,CEEvilPresence)>-1 THEN { PRIO=PRIO-10; }
 CALL "UnrestPrio";
 CALL "PowerPrio";
 CALL "ReligionPrio";
 IF (RACE=RCRakhshasa) THEN { CALL "MilitaryPrio"; }
}

IF  (j=BPoolOfRepentance) THEN {
 IF CITYENCHANT(C,CEEvilPresence)>-1 THEN { PRIO=PRIO-10; }
 CALL "UnrestPrio";
 CALL "ReligionPrio";
 CALL "ProductionPrio";
 CALL "MilitaryPrio";
}

IF  (j=BWitchesConvent) %OR (J=BAltarOfStorm) THEN {
 IF CITYENCHANT(C,CEEvilPresence)>-1 THEN { PRIO=PRIO-10; }
 CALL "PowerPrio";
 CALL "ReligionPrio";
 CALL "MilitaryPrio";
}

IF  (j=BAltarOfTheSun) THEN {
 CALL "EconomyPrio";
 CALL "MilitaryPrio";
}

IF  (j=BAltarOfTheMoon) %OR (J=BFrostClub) THEN {
 CALL "MilitaryPrio";
}

IF j=BAmplifyingTower THEN {
 IF OVERLANDTURN()<(70-(7*Difficulty())) THEN {PRIO=-100; HALT; }
 IF OVERLANDTURN()<(140-(10*Difficulty())) THEN {PRIO=PRIO-(14-Difficulty()-(%I(OVERLANDTURN()/10))); }
 CALL "Research2Prio";
 CALL "Amplifier";
}

IF j=BMonument THEN {
 IF CONTACT(W,0)
  %AND (TREATY(W,0)<>TSPact)
  %AND (TREATY(W,0)<> TSAlliance)
 THEN {
  PRIO=PRIO+20;
 }
 CALL "SkillPrio";
}

IF j=BLinkingTower THEN {
 CALL "SkillPrio";
}

IF j=BMarketplace THEN { PRIO=PRIO+20; }
IF (j=BMarketplace) %OR (J=BBank) %OR (J=BMerchantguild) THEN { CALL "EconomyPrio"; }
IF (j=BCaravanserai) THEN {
 CALL "EconomyPrio";
 CALL "MilitaryPrio";
}

IF j=BBuilderHall THEN { PRIO=PRIO+10; }
IF (j=BMinerGuild) %OR (j=BMechaGuild) THEN { CALL "ProductionPrio"; }
IF (j=BCityWalls) %OR (j=BHillfort) THEN {
 CALL "MilitaryPrio";
 IF AIowncities<=AIenemycities THEN { PRIO=PRIO+25; }
}

IF j=BTreeOfLife THEN {
 CALL "FoodPrio"; 
 CALL "UnrestPrio";
}

IF j=BTreeOfMagic THEN {
 CALL "PowerPrio"; 
 CALL "MilitaryPrio";
}

IF (j=BHiveNetwork) THEN { 
 IF (HOMERACE(W)=RCKlackon) THEN {
  CALL "EconomyPrio";
  CALL "MilitaryPrio";
 } ELSE { 
  PRIO=-100;
  HALT;
 }
}

IF (j=BBaray) THEN { 
 CALL "EconomyPrio";
 CALL "UnrestPrio";
 CALL "MilitaryPrio";
}

HALT;

: End of main script, functions below :

!MilitaryPrio!
Prio=Prio+2;
IF Objective(W)=Militarist THEN { Prio:=Prio+4;}
IF Objective(W)=Expansionist THEN { Prio:=Prio+2;}
IF HaveAdamant>0 THEN { prio=prio+7 } ELSE { IF HaveMithril>0 THEN {prio=prio+3; }; }
IF HaveOrihalcon>0 THEN { PRIO=PRIO+1; }
IF AIenemycities>=AIOwncities THEN {
 PRIO=PRIO+7;
 IF AIenemycities>=2*AIOwncities THEN { Prio=Prio+100; }
}
IF ScoringOption(STreeMastery) %AND ISFortress(c) THEN { Prio=Prio+20;}
RETURN;

!EconomyPrio!
IF Objective(W)=Perfectionist THEN { Prio=Prio+3; }
IF Objective(W)=Militarist THEN { Prio=Prio+1; }
IF Population(C)>=15000 THEN { Prio=Prio+3; }
IF Gold(W)<500 THEN { prio=prio+6; }
IF Gold(W)<100 THEN { prio=prio+14; }
RETURN;

!EXPPrio!
IF CITYENCHANT(C,CEAltarOfBattle)>-1 THEN { 
PRIO=0;
IF (j=BWarCollege) THEN { PRIO=-100; HALT; }
}
IF Objective(W)=Perfectionist THEN { Prio=Prio+3; }
IF Objective(W)=Militarist THEN { Prio=Prio+3; }
IF Objective(W)=Narcissist THEN { Prio=Prio-5; }
RETURN;

!FoodPrio!
IF Population(C)<=3999 THEN { Prio=Prio+2; }
IF (CITYENCHANT(C,CEDrought)>-1) %AND (Difficulty()>=DiffLunatic) THEN { Prio=Prio+20; }
IF Objective(W)=Pragmatist THEN { Prio=Prio+2; }
IF Objective(W)=Perfectionist THEN { Prio=Prio+3; }
RETURN;

!Research2Prio!
IF RESEARCHING(W)<>0 THEN {
 IF Retort(W,SageMaster) THEN { Prio=Prio+3; }
 IF Objective(W)=Theurgist THEN { Prio=Prio+4; }
}
RETURN;

!ResearchPrio!
IF RESEARCHING(W)<>0 THEN {
 IF AIStrategy(W,PDSResearchNeeded) THEN {PRIO=PRIO+4;}
 IF AISTRATEGY(W,PDSSomSerious)>0 THEN {PRIO=PRIO+20;}
 IF Retort(W,SageMaster) THEN { Prio=Prio+3; }
 IF Objective(W)=Theurgist THEN { Prio=Prio+4; }
}
RETURN;

!SkillPrio!
IF Retort(W,SageMaster) THEN { Prio=Prio-3; }
IF Objective(W)=Theurgist THEN { Prio=Prio-4; }
IF Objective(W)=Militarist THEN { Prio=Prio+4; }
IF Objective(W)=Expansionist THEN { Prio=Prio+2; }
IF Treaty(W,0)=TSWar THEN { Prio=Prio+3; }
IF ( Contact(W,0) = 0 ) THEN { Prio=Prio-3; }
IF Treaty(W,0)=TSPact THEN { Prio=Prio-3; }
IF Treaty(W,0)=TSAlliance THEN { Prio=Prio-7; }
IF AISTRATEGY(W,PDSSomSerious)>0 THEN { Prio=Prio-20; }
IF Retort(W,Channeler) THEN { prio=Prio+5; }
IF Retort(W,Archmage) THEN { prio=Prio-2; }
IF Objective(W)=Narcissist THEN { Prio=Prio+5; }
IF CityEnchant(c,CEMagicPerimeter)>-1 THEN { Prio=Prio+3; }
RETURN;

!PowerPrio!
Prio=Prio+2;
IF Objective(W)=Theurgist THEN { Prio=Prio+1; }
IF Objective(W)=Narcissist THEN { Prio=Prio+1; }
IF Researching(W)=SSpellofMastery THEN { Prio=Prio+3; }
IF Retort(W,Archmage) THEN { prio=Prio+1; }
IF AISTRATEGY(W,PDSCriticalLowMana)>0 %AND (Difficulty()>=DiffAdvanced) THEN { Prio=Prio+20; }
RETURN;

!ProductionPrio!
IF (HaveAdamant+HaveMithril+HaveOrihalcon+HaveIron+HaveCoal)>0 THEN { Prio=Prio+3; }
Prio=Prio+(Difficulty()-4);
IF Objective(W)=Perfectionist THEN { Prio=Prio+7; }
IF Race=RCDwarf THEN { Prio=Prio+7; }
IF CityEnchant(C,CEChaosRift)>-1 THEN { Prio=Prio+10; }
RETURN;

!UnrestPrio!
Prio=Prio+CUnrest;
RETURN;


!ReligionPrio!
IF Retort(W,CultLeader) THEN { Prio=Prio+4; }
IF CityEnchant(c,CEDarkRituals)>0 THEN { Prio=Prio+4; }
IF HASGlobal(W,GERulerofHeaven) THEN { PRIO=PRIO+2; }
RETURN;

!Amplifier!
IF CITYENCHANT(C,CEUranusBless)>-1 THEN { Prio=Prio+3;}
IF HASGLOBAL(W,GEAEtherBinding) THEN { Prio=Prio+3; }
IF Retort(W,Enchanter) THEN { prio=Prio+5; }
IF OVERLANDSKILL<(OVERLANDTURN()-30) THEN { Prio=Prio+7; }
IF Difficulty()>=DiffExpert THEN { Prio=Prio+3; }
IF Retort(W,Archmage) THEN { prio=Prio-2; }
IF Objective(W)=Narcissist THEN { Prio=Prio+4; }
RETURN;
