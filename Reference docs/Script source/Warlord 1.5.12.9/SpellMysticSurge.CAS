: Input - TU is the target unit's ID, Mystic Surge get buff as it move to Rare tier :
LOOP {
R=RND(46)+1;

: Bad
:

: Good
:
IF (R=1) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncResistElements,ABase,1); }
IF (R=2) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncHaste,ABase,1); }
IF (R=3) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncWaterWalking,ABase,1); }
IF (R=4) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncCloakofFear,ABase,1); }
IF (R=5) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncElementalArmor,ABase,1); }
IF (R=6) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncIronSkin,ABase,1); }
IF (R=7) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncDivineProtection,ABase,1); }
IF (R=8) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncRegeneration,ABase,1); }
IF (R=9) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncGuardianWind,ABase,1); }
IF (R=10) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncSpellLock,ABase,1); }
IF (R=11) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncFlight,ABase,1); }
IF (R=12) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncMagicImmunity,ABase,1); }
IF (R=13) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncWraithForm,ABase,1); }
IF (R=14) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncImmolation,ABase,1); }
IF (R=15) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncEndurance,ABase,1); }
IF (R=16) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncHolyArmor,ABase,1); }
IF (R=17) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncHolyWeapon,ABase,1); }
IF (R=18) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncHeroism,ABase,1); }
IF (R=19) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncTrueSight,ABase,1); }
IF (R=20) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncLionHeart,ABase,1); }
IF (R=21) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncInvulnerability,ABase,1); }
IF (R=22) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncLandLink,ABase,1); }
IF (R=23) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncFlameBlade,ABase,1); }
IF (R=24) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncBloodLust,ABase,1); }
IF (R=25) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncFocusMagic,ABase,1); }
IF (R=26) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncBless,ABase,1); }
IF (R=27) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncDiscipline,ABase,1); }
IF (R=28) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncZeal,ABase,1); }
IF (R=29) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncVenom,ABase,1); }
IF (R=30) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncColossalStrength,ABase,1); }
IF (R=31) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncInsulation,ABase,1); }
IF (R=32) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncBlazeOfGlory,ABase,1); }
IF (R=33) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncShadowStrike,ABase,1); }
IF (R=34) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncPlanewalking,ABase,1); }
IF (R=35) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncResistMagic,ABase,1); }
IF (R=36) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncBerserk,ABase,1); }

: Permanent
:
IF (R=37) THEN { SETENCHANTMENTFLAG(TU,EncCCBreath,ABase,1); }
IF (R=38) THEN { SETENCHANTMENTFLAG(TU,EncCCArmor,ABase,1); }
IF (R=39) THEN { SETENCHANTMENTFLAG(TU,EncCCFlight,ABase,1); }
IF (R=40) THEN { SETENCHANTMENTFLAG(TU,EncMithril,ABase,1); }
IF (R=41) THEN { SETENCHANTMENTFLAG(TU,EncAdamant,ABase,1); }
IF (R=42) THEN { SETENCHANTMENTFLAG(TU,EncOrihalcon,ABase,1); }
IF (R=43) THEN {
 SETENCHANTMENTFLAG(TU,EncSpiritLink,ABase,1);
 SETSTAT(TU,SResist,1,(GetStat(TU,SResist,1)+2));
 IF BASEFANTASTIC(TU) THEN {
  SETSTAT(TU,AFantastic,1,0);
  SETSTAT(TU,ALevel,1,1);
 }
}
IF (R=44) THEN {
 SETENCHANTMENTFLAG(TU,EncRebuild,ABase,1);
 IF (ISHERO(TU)=0) THEN {
  SETSTAT(TU,SCustomAttribute,1,1);
  SETSTAT(TU,SAttack,1,GETSTAT(TU,SAttack,1)+2);
  SETSTAT(TU,SDefense,1,GETSTAT(TU,SDefense,1)+2);
  SETSTAT(TU,AFArmorPiercing,1,1,1);
  SETSTAT(TU,AIllusionImmunity,1,1);
  SETSTAT(TU,ADeathImmunity,1,1);
 }
}
IF (R=45) THEN {
 SETENCHANTMENTFLAG(TU,EncVampirism,ABase,1);
 SETENCHANTMENTFLAG(TU,EncUndead,ABase,1);
}

} ENDLP (RND(100)>=77);

IF GETENCHANTMENTFLAG(TU,EncAdamant,ABase)
 %AND GETENCHANTMENTFLAG(TU,EncOrihalcon,ABase)
 %AND (GETENCHANTMENTFLAG(TU,EncTransmuteEquipment,ABase)=0)
THEN {
 SETENCHANTMENTFLAG(TU,EncTransmuteEquipment,ABase,1);
}

IF (HASGLOBAL( (GETSTAT(TU,SOwner,0)) ,GEDoomMastery)>0)
 %AND ( (GETENCHANTMENTFLAG(TU,EncCCArmor,ABase))
  %OR (GETENCHANTMENTFLAG(TU,EncCCFlight,ABase))
  %OR (GETENCHANTMENTFLAG(TU,EncCCBreath,ABase)) )
THEN {
 SETENCHANTMENTFLAG(TU,EncCCArmor,1,1);
 SETENCHANTMENTFLAG(TU,EncCCFlight,1,1);
 SETENCHANTMENTFLAG(TU,EncCCBreath,1,1);
}

:SETCOMBATENCHANTMENTFLAG(TU,EncNoHeal,ABase,1);:
