:
	  INPUT -   C - The id of the city where production happens
			    B - The id of the building being produced or the id of the unit type being produced+1000
	  OUTPUT - CR - The cost reduction in percentage 
:
	  
CR=0;
RACE=CITYRACE(C);
W=CITYOWNER(C);
LOGISTIC=0;
OWNIRON=0;
OWNCOAL=0;
OWNQUORK=0;
OWNCRYSX=0;
IF (SPELLSTATE(W,STStrategicLogistic)<>2) THEN { GOTO "NOLOGISTIC"; }
 LOGISTIC=1;

 FOR I=1 TO MAXCITY();

  IF (CITYOWNER(I)<>W) THEN { GOTO "NOTLINK"; }

   OWNIRON=OWNIRON+OREINRANGE(I,OreIron);
   OWNCOAL=OWNCOAL+OREINRANGE(I,OreCoal);
   OWNQUORK=OWNQUORK+OREINRANGE(I,OreQuork);
   OWNCRYSX=OWNCRYSX+OREINRANGE(I,OreCrysx);

  !NOTLINK!

 NEXT I;

!NOLOGISTIC!

IF (B>999) THEN { GOTO "ISUNIT"; }

: Buildings part :
 IF (SPELLSTATE(W,STConcrete)=2) THEN { CR=CR+20; }
 IF (SPELLSTATE(W,STStandardization)=2) THEN { CR=CR+10; }

 IF (RACE=RCHighMen) THEN { CR=CR+15; }

 IF (RETORT(W,Warlord)=0) THEN { GOTO "NOTWARLORD"; }

  IF (B=BBarracks)
   %OR (B=BWarCollege)
   %OR (B=BArmory)
   %OR (B=BFighterGuild)
   %OR (B=BArmorerGuild)
   %OR (B=BCityWalls)
   %OR (B=BMoats)
   %OR (B=BHillfort)
   %OR (B=BWarlordHold)
  THEN {
   CR=CR+15;
  }

!NOTWARLORD!

 IF (RETORT(W,SageMaster)=0) THEN { GOTO "NOTSAGEMASTER"; }

  IF (B=BLibrary)
   %OR (B=BUniversity)
   %OR (B=BSagesGuild)
   %OR (B=BAcademy)
   %OR (B=BAgoge)
  THEN {
   CR=CR+15;
  }

!NOTSAGEMASTER!

 IF (RETORT(W,Alchemist)=0) THEN { GOTO "NOTALCHEMIST"; }

  IF (B=BAlchemistguild)
  THEN {
   CR=CR+15;
  }

!NOTALCHEMIST!

 GOTO "PRODUCTIONCONCLUDE";

!ISUNIT!

: Unit part :
 MINERGUILD=0;
 ADVMINING=0;
 DWARVEN=0;
 ORE=0;
 IF (OREINRANGE(C,OreIron)>0) THEN {
  ORE=ORE+(5*OREINRANGE(C,OreIron));
 } ELSE {
  IF (LOGISTIC>0) %AND (OWNIRON>0) THEN { ORE=ORE+5; }
 }
 IF (OREINRANGE(C,OreCoal)>0) THEN {
  ORE=ORE+(10*OREINRANGE(C,OreCoal));
 } ELSE {
  IF (LOGISTIC>0) %AND (OWNCOAL>0) THEN { ORE=ORE+10; }
 }
 IF ISBUILT(C,BMinerGuild) THEN {
  IF (SPELLSTATE(W,STExplosive)=2) THEN { MINERGUILD=ORE; } ELSE { MINERGUILD=%I(ORE/2); }
 }
 IF (SPELLSTATE(W,STAdvancedMining)=2) THEN { ADVMINING=ORE; }
 IF RACE=RCDwarf THEN { DWARVEN=ORE; }

 ORE=ORE + MINERGUILD + ADVMINING + DWARVEN;

 CR=CR+ORE;

 IF (SPELLSTATE(W,STStandardization)=2) THEN { CR=CR+10; }
 IF (SPELLSTATE(W,STConscription)=2) THEN { CR=CR+20; }
 IF ISBUILT(C,BWarlordHold) THEN { CR=(CR+25); }

 IF (SCORINGOPTION(SPleasantville)>0) THEN { GOTO "NOTSETTLERS"; }
  IF (B<>1044) THEN { GOTO "NOTSETTLERS"; }
   OWN=0;

   FOR I=1 TO MAXCITY();

    IF (CITYOWNER(I)=W) THEN { OWN=OWN+1; }

   NEXT I;

   CR=( CR - (5*OWN) );

 !NOTSETTLERS!

 IF (RACE<>RCHighMen) THEN { GOTO "NOTHUMANSHIP"; }

  IF (B=1035)
   %OR (B=1036)
   %OR (B=1037)
   %OR (B=1038)
   %OR (B=1218)
   %OR (B=1257)
  THEN {
   CR=(CR+15);
  }

!NOTHUMANSHIP!

 IF (RACE<>RCDwarf) THEN { GOTO "NOTDWARFSHIP"; }

  IF (B=1035)
   %OR (B=1036)
   %OR (B=1037)
   %OR (B=1038)
   %OR (B=1218)
   %OR (B=1257)
  THEN {
   CR=(CR-25);
  }

!NOTDWARFSHIP!

 IF (RACE<>RCTroll) %AND (RACE<>RCRakhshasa) ) THEN { GOTO "NOTTROLLRAKHSHASASHIP"; }

  IF (B=1035)
   %OR (B=1036)
   %OR (B=1037)
   %OR (B=1038)
  THEN {
   CR=(CR-50);
  }

!NOTTROLLRAKHSHASASHIP!

 IF (ISBUILT(C,BAcademy)=0) THEN { GOTO "NOTACADEMY"; }

  IF (B=1035)
   %OR (B=1036)
   %OR (B=1037)
   %OR (B=1038)
   %OR (B=1218)
   %OR (B=1257)
  THEN {
   CR=(CR+25);
  }

!NOTACADEMY!

: AI's unit discount bonus :
 IF (W=0) THEN { GOTO "NOTAI"; }

  IF ( (DIFFICULTY())>DiffExpert ) THEN {
   CR=CR+(10*((DIFFICULTY())-6));
   IF (CR>80) THEN { CR=80; }
   GOTO "COMMONUNITCONCLUDED";
  }

!NOTAI!

  IF (CR>60) THEN { CR=60; }

!COMMONUNITCONCLUDED!

: Goblin cost manipulation is independent of capping system :
: Crysx engine units has their cost reduced by Crysx and Quork ore :
 IF (B<>1359) %AND (B<>1361) ) THEN { GOTO "NOCRYSXENGINE"; }

  ACCESSCRYSX=0;
  IF (OREINRANGE(C,OreCrysx)>0)
   %OR ( (LOGISTIC>0) %AND (OWNCRYSX>0) )
  THEN { ACCESSCRYSX=1; }
  ACCESSQUORK=0;
  IF (OREINRANGE(C,OreQuork)>0)
   %OR ( (LOGISTIC>0) %AND (OWNQUORK>0) )
  THEN { ACCESSQUORK=1; }

  IF (ACCESSCRYSX>0) %AND (ACCESSQUORK>0) THEN { CR=100-%I((4/10)*(100-CR)); }
  IF (ACCESSCRYSX>0) %AND (ACCESSQUORK=0) THEN { CR=100-%I((6/10)*(100-CR)); }
  IF (ACCESSCRYSX=0) %AND (ACCESSQUORK>0) THEN { CR=100-%I((8/10)*(100-CR)); }

!NOCRYSXENGINE!

!PRODUCTIONCONCLUDE!

: Production Cost must not below zero :
IF (CR>95) THEN { CR=95; }

HALT;
