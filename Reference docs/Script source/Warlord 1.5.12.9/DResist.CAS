:
INPUT - W - The wizard who is casting the spell
        SP - The spell being dispelled
        REALM - The ream of the spell being cast
        PRIMARY - The primary realm of the wizard.
        GROUP - The spellgroup of the spell that determines the type of effects.
        CATEGORY - The displayed category of the spell in the spellbook.
OUTPUT - DR - The multiplier of the dispel resistance (in percentages)
:

DR=100;

: Spell Lock has a cost of 100 but a base resistance of 150. :
IF (SP=SSpellLock) Then { DR=DR+%I(DR/2); }

: Necropolis has a cost of 222 but a base resistance of 888. :
IF (SP=SNecropolis) Then { DR=4*DR; }

: Gospel of Evangelism has 300% base resistance :
IF (SP=SGospelOfEvangelism) Then { DR=3*DR; }

IF (EVENTTURN(EvSorceryC)>0) THEN { DR=DR+100; }

IF W=NeutralPlayerID THEN { GOTO "NOTWIZARD"; }

 IF (Retort(W,Specialist)) THEN {
  IF (PRIMARY=REALM) THEN { DR=DR+50; };
  IF (REALM=Nature) %AND (SPELLSTATE(W,SGaiaMastery)=2) THEN { DR=DR+100; }
  IF (REALM=Sorcery) %AND (SPELLSTATE(W,SAEtherMastery)=2) THEN { DR=DR+100; }
  IF (REALM=Chaos) %AND (SPELLSTATE(W,SChaosMastery)=2) THEN { DR=DR+100; }
  IF (REALM=Life) %AND (SPELLSTATE(W,SLifeMastery)=2) THEN { DR=DR+100; }
  IF (REALM=Death) %AND (SPELLSTATE(W,SDeathMastery)=2) THEN { DR=DR+100; }
 }
 IF Retort(W,Enchanter) THEN { DR=DR+150; };
 IF (HasGlobal(W,GEDarkestHour)) %AND ((GROUP=SGCityBuff) %OR (GROUP=SGCityCurse)) THEN { DR=DR+100; }
 IF HasGLobal(W,GERulerofHeaven) THEN { DR=DR+100; }

: Resistance of global enchantment depending on aether fabric meddling :
 IF (GROUP<>SGGlobalEnchantment) THEN { GOTO "NOTGLOBALENCHANTMENT"; }

  OWNGE=0;
  OTHERGE=0;
  SURVIVINGOPPONENT=0;

  IF HASGLOBAL(W,GENaturalSelection) THEN { OWNGE=OWNGE+1; }
  IF HASGLOBAL(W,GESurvivalInstinct) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GECallTheWild) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEFairyRing) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GESeismicMastery) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEHerbMastery) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEClairvoyance) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GERootsofGenesis) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEIceAge) THEN { OWNGE=OWNGE+4; }

  IF HASGLOBAL(W,GEAuraofMajesty) THEN { OWNGE=OWNGE+1; }
  IF HASGLOBAL(W,GEAEtherBinding) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GEMarinerMastery) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GEMagocracy) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GEReinforceMagic) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GETimeStop) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEWindMastery) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEPowerLink) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEGreatUnbinding) THEN { OWNGE=OWNGE+4; }

  IF HASGLOBAL(W,GEInnerPower) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEBloodAndIron) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEChaosSurge) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEDoomMastery) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEDoomsday) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEMeteorStorm) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEArmageddon) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEBlazingEyes) THEN { OWNGE=OWNGE+4; }

  IF HASGLOBAL(W,GEJustCause) THEN { OWNGE=OWNGE+1; }
  IF HASGLOBAL(W,GESpiritOfCommunity) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GEHolyArms) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEDivineOrder) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEHeartOfSolidarity) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEAngelicGuardians) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEEnlightenment) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GELifeForce) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GECrusade) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GECharmofLife) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GERulerofHeaven) THEN { OWNGE=OWNGE+4; }

  IF HASGLOBAL(W,GEZombieMastery) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEFateMastery) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEStateOfRot) THEN { OWNGE=OWNGE+3; }
  IF HASGLOBAL(W,GEEternalNight) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEEvilOmens) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEDarkestHour) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEKingOfUnderworld) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEDeathReckoning) THEN { OWNGE=OWNGE+4; }

  IF HASGLOBAL(W,GEDetectMagic) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GEArcaneConference) THEN { OWNGE=OWNGE+2; }
  IF HASGLOBAL(W,GERuneArray) THEN { OWNGE=OWNGE+4; }
  IF HASGLOBAL(W,GEDomainOfEnchanter) THEN { OWNGE=OWNGE+4; }

  FOR I=0 TO NOFWIZARDS();
  
   IF (I<>W) THEN {

    IF (DEFEATED(I)=0) THEN { SURVIVINGOPPONENT = SURVIVINGOPPONENT + 1; }

    IF HASGLOBAL(I,GENaturalSelection) THEN { OTHERGE=OTHERGE+1; }
    IF HASGLOBAL(I,GESurvivalInstinct) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GECallTheWild) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEFairyRing) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GESeismicMastery) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEHerbMastery) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEClairvoyance) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GERootsofGenesis) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEIceAge) THEN { OTHERGE=OTHERGE+4; }

    IF HASGLOBAL(I,GEAuraofMajesty) THEN { OTHERGE=OTHERGE+1; }
    IF HASGLOBAL(I,GEAEtherBinding) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GEMarinerMastery) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GEMagocracy) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GEReinforceMagic) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GETimeStop) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEWindMastery) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEPowerLink) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEGreatUnbinding) THEN { OTHERGE=OTHERGE+4; }

    IF HASGLOBAL(I,GEInnerPower) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEBloodAndIron) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEChaosSurge) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEDoomMastery) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEDoomsday) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEMeteorStorm) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEArmageddon) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEBlazingEyes) THEN { OTHERGE=OTHERGE+4; }

    IF HASGLOBAL(I,GEJustCause) THEN { OTHERGE=OTHERGE+1; }
    IF HASGLOBAL(I,GESpiritOfCommunity) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GEHolyArms) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEDivineOrder) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEHeartOfSolidarity) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEAngelicGuardians) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEEnlightenment) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GELifeForce) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GECrusade) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GECharmofLife) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GERulerofHeaven) THEN { OTHERGE=OTHERGE+4; }

    IF HASGLOBAL(I,GEZombieMastery) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEFateMastery) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEStateOfRot) THEN { OTHERGE=OTHERGE+3; }
    IF HASGLOBAL(I,GEEternalNight) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEEvilOmens) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEDarkestHour) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEKingOfUnderworld) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEDeathReckoning) THEN { OTHERGE=OTHERGE+4; }

    IF HASGLOBAL(I,GEDetectMagic) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GEArcaneConference) THEN { OTHERGE=OTHERGE+2; }
    IF HASGLOBAL(I,GERuneArray) THEN { OTHERGE=OTHERGE+4; }
    IF HASGLOBAL(I,GEDomainOfEnchanter) THEN { OTHERGE=OTHERGE+4; }

   }
  
  NEXT;

  DR=DR-%I(OWNGE+(OTHERGE/SURVIVINGOPPONENT));

 !NOTGLOBALENCHANTMENT!

: Domain of Enchanter make resistance to dispel twice as strong :
 IF HASGLOBAL(W,GEDomainOfEnchanter) THEN { DR=2*DR; }

: Banish halved city curses resistance :
 IF Banished(W) %AND (GROUP=SGCityCurse) THEN { DR=%I(DR/2); }

: bonus to guerentee ability to disjunct global enchantment for ai wizard :
 IF (W>0) %AND (GROUP=SGGlobalEnchantment) THEN { DR=%I(DR/10); }

!NOTWIZARD!

IF (DR<1) THEN { DR=1; }
