:
INPUT -    W - The wizard who is casting the spell
        BASE - The base strength of dispel
OUTPUT - STR - The final dispel strength of the spell
:

BASE=STR;

IF (W=NeutralPlayerID) THEN { GOTO "NOMODIFY"; }

 IF RETORT(W,Runemaster) THEN { STR=STR+BASE; }
 IF HASGLOBAL(W,GEAetherBinding) THEN { STR=STR+(%I(BASE/2)); }
 IF HASGLOBAL(W,GEPowerLink) THEN { STR=STR+BASE; }

: bonus to guerentee ability to disjunct global enchantment for ai wizard :
 IF (W>0) %AND (CASTING(W)=SDisjunction) THEN { STR=STR*10; }

!NOMODIFY!

HALT;
