: INPUT, U - the unit on the targeted tile :

RANDOMA=RND(101);
RANDOMB=RND(101);
RANDOMC=RND(101);
RANDOMD=RND(101);
OWNER=GETSTAT(U,SOwner,1);
CASTER=( ATTACKER() + DEFENDER() ) - OWNER;

IF (GETSTAT(U,AMERGING,ACURR))
 %OR (GETSTAT(U,AFLYING,ACURR))
 %OR (GETSTAT(U,ANONCORPOREAL,ACURR))
THEN { GOTO "END"; }

 BURIED=(4*(GETSTAT(U,SDEFENSE,ACURR)));
 :IF (BURIED>75) THEN { BURIED=75 }:
 IF (RANDOMA<BURIED) THEN { SETCOMBATENCHANTMENTFLAG(U,EncBuried,ABase,1); }

 IF (GETENCHANTMENTFLAG(U,EncBuried,ACURR)=0) THEN { GOTO "NOTBURIED"; }

  IF (RANDOMC<25) THEN {
   DEALCOMBATDAMAGE U,0,0,4;
   IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
    DEALCOMBATDAMAGE U,0,0,2;
   }
  }
  IF (RANDOMD>75) THEN {
   DEALCOMBATDAMAGE U,0,0,4;
   IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
    DEALCOMBATDAMAGE U,0,0,2;
   }
  }

!NOTBURIED!

 IF (RANDOMB>26) %AND (RANDOMB<70) THEN { 
  DEALCOMBATDAMAGE U,0,0,4;
  IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
   DEALCOMBATDAMAGE U,0,0,2;
  }
  GOTO "END";
 }
 IF (RANDOMB>5) %AND (RANDOMB<27) THEN { 
  DEALCOMBATDAMAGE U,0,0,8;
  IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
   DEALCOMBATDAMAGE U,0,0,4;
  }
  GOTO "END";
 }
 IF (RANDOMB>0) %AND (RANDOMB<6) THEN { 
  DEALCOMBATDAMAGE U,0,0,12;
  IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
   DEALCOMBATDAMAGE U,0,0,6;
  }
  GOTO "END";
 }
 IF (RANDOMB=0) THEN { 
  DEALCOMBATDAMAGE U,0,0,16;
  IF (SPELLSTATE(CASTER,STMagitekMagicalPhysics)=2) THEN {
   DEALCOMBATDAMAGE U,0,0,8;
  }
  GOTO "END";
 }

!END!

HALT;
