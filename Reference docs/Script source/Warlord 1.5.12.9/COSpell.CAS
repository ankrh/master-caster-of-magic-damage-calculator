  IF ( INCOMBAT(AU) = 0 ) THEN { GOTO "NOTFORICECOMET"; }

   IF (GetStat(AU,SCoX,1)>(CBX-2))
    %AND (GetStat(AU,SCoX,1)<(CBX+2))
    %AND (GetStat(AU,SCoY,1)>(CBY-2))
    %AND (GetStat(AU,SCoY,1)<(CBY+2))
   THEN {
    IF (GETSTAT(AU,AColdImmunity,0)=0)
     %AND (GETSTAT(AU,ANoncorporeal,0)=0)
     %AND (GETENCHANTMENTFLAG(AU,EncImmolation,0)=0)
