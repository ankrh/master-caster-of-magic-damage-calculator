}

IF (SP<>SPersuasiveWhisperer) THEN { GOTO "NOTPERSUASIVE"; }

 : Reset blank combat global flag :
 SETCOMBATGLOBAL(W,CGTrap,1,0);

  : save penalty :
  CHARISMA=0;
  CASTERU=0;
  IF (CASTER<0) %AND (CASTER>-999999) THEN { CASTERU=-CASTER; }
  IF (CASTER<-999998) THEN { CASTERU=-(CASTER+999999); }

  IF (CASTER=W) %AND (RETORT(W,Charismatic))
   %OR ( (CASTER<0) %AND ( GETHEAB( CASTERU , HACharmed ) > 0 )
  THEN { CHARISMA=2; }

  FIRSTSAVE=0+CHARISMA;
  SECONDSAVE=1+CHARISMA;

  FOR U=1 TO MAXUNIT();

   IF (INCOMBAT(U)=0) THEN { GOTO "NOTPERSUASIVEUNIT"; }
    IF (GETSTAT(U,SOwner,1)=W) THEN { GOTO "NOTPERSUASIVEUNIT"; }

     : using resistance roll :
     FIRSTROLL=RND(10);
     SECONDROLL=RND(10);
     PWRESIST=(GETSTAT(U,SResist,0));

     IF ( (PWRESIST-FIRSTSAVE)<(FIRSTROLL) ) THEN {
      IF FANTASTIC(U) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncCreatureBinding,1,1);
       GOTO "NOTPERSUASIVEUNIT";
      } ELSE {
       SETCOMBATENCHANTMENTFLAG(U,EncPossession,1,1);
       GOTO "NOTPERSUASIVEUNIT";
      }
     } ELSE {
      IF ( (PWRESIST-SECONDSAVE)<(SECONDROLL) ) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncConfusion,1,1);
       GOTO "NOTPERSUASIVEUNIT";
      }
     }

   !NOTPERSUASIVEUNIT!

  NEXT U;

  GOTO "ENDOFCOSPELL";

!NOTPERSUASIVE!

IF (SP<>SHierophany) THEN { GOTO "NOTHIEROPHANY"; }

 : using resistance roll :
 FIRSTROLL=RND(10);
 SECONDROLL=RND(10);
 HRESIST=(GETSTAT(TU,SResist,0));
 IF (GETENCHANTMENTFLAG(TU,EncUndead,1)>0) THEN { HRESIST=((HRESIST)/3); } ELSE { HRESIST=((HRESIST)/2); }
 IF ( (HRESIST)>(FIRSTROLL) )
  %AND ( (HASGLOBAL(W,GEFateMastery)=0) %OR ( (HRESIST)>(SECONDROLL) ) )
 THEN {
  SETCOMBATENCHANTMENTFLAG(TU,EncHierophany,1,0);
  GOTO "ENDOFCOSPELL";
 }
 GOTO "ENDOFCOSPELL";

!NOTHIEROPHANY!

: new unit curse "Rust" unit lose magical weapons and armor if unit have them :
IF (SP<>SRust) THEN { GOTO "NOTRUST"; }

 FIRSTROLL=RND(10);
 SECONDROLL=RND(10);
 HRESIST=(GETSTAT(TU,SResist,0)-3);
 IF ( (HRESIST)<(FIRSTROLL) )
  %OR ( (HASGLOBAL(W,GEFateMastery)) %AND ( (HRESIST)<(SECONDROLL) ) )
 THEN {
  SETENCHANTMENTFLAG(TU,EncMagic,1,0);
  SETENCHANTMENTFLAG(TU,EncMithril,1,0);
  SETENCHANTMENTFLAG(TU,EncAdamant,1,0);
  SETENCHANTMENTFLAG(TU,EncOrihalcon,1,0);
  SETENCHANTMENTFLAG(TU,EncTransmuteEquipment,1,0);
  SETENCHANTMENTFLAG(TU,EncResistElements,1,0)
  SETENCHANTMENTFLAG(TU,EncElementalArmor,1,0)
  SETENCHANTMENTFLAG(TU,EncFlameBlade,1,0)
  SETENCHANTMENTFLAG(TU,EncGuardianWind,1,0)
  GOTO "ENDOFCOSPELL";
 }
 GOTO "ENDOFCOSPELL";

!NOTRUST!

IF (SP<>SFairyDust) THEN { GOTO "NOTFAIRYDUST"; }

 IF (GETSTAT(TU,AColdImmunity,0)=0) %AND (GETSTAT(TU,ANoncorporeal,0)=0) %AND (GETENCHANTMENTFLAG(TU,EncImmolation,0)=0) THEN {
  FREEZE=RND(3);
  IF (FREEZE>1) THEN { SETCOMBATENCHANTMENTFLAG(TU,EncFrozen,1,1); }
 }

 IF (SPELLSTATE(W,STMagitekMagicalPhysics)=2) THEN {
  IF (GETSTAT(TU,AColdImmunity,0)=0) THEN {
   FIGURE=(GetStat(TU,SFigures,1)) - %I( GETDAMAGE(TU,0)/GetStat(TU,SHP,0) );
   ATTACK=%I( (6*0.5) * FIGURE );
   HIT=30;
   DAMAGE=0;
   DEFEND=( GetStat(TU,SToDefend,0) );
   ARMOR=( GetStat(TU,SDefense,0) );
    IF (GETENCHANTMENTFLAG(TU,EncResistElements,0)>0) THEN { ARMOR=ARMOR+4; }
    IF (GETENCHANTMENTFLAG(TU,EncElementalArmor,0)>0) THEN { ARMOR=ARMOR+12; }
    IF (GETENCHANTMENTFLAG(TU,EncBless,0)>0) THEN { ARMOR=ARMOR+7; }
   : Armor Piercing :
   ARMOR=%I(ARMOR/2);

   : Make attack roll for 10 damage at 60% to-hit :
   LOOP{
    IF (ATTACK>0) THEN {
     ATTACK=(ATTACK-1);
     PERCENT=(RND(100));
     IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
    }
   }ENDLP (ATTACK=0);

   : Make defense roll with armor and to-defend :
   IF (DAMAGE>0) THEN { 
    LOOP{
     IF (ARMOR>0) THEN {
      ARMOR=(ARMOR-1);
      PERCENT=(RND(100));
      IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
     }
    }ENDLP (ARMOR=0);
    DEALCOMBATDAMAGE (TU,DAMAGE,0,0);
   }
  }
 }

 GOTO "ENDOFCOSPELL";

!NOTFAIRYDUST!

IF (SP<>SReaperSlash) THEN { GOTO "NOTREAPERSLASH"; }

 IF (SPELLSTATE(W,STMagitekMagicalPhysics)=2) THEN {
  IF (GETSTAT(TU,AColdImmunity,0)=0) THEN {

   ATTACK=%I( 22*0.5 );
   HIT=60;
