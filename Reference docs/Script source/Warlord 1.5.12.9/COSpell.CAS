!NOTCORROSIVEBLAST!

: Self-destruction protocol :
IF (SP<>SRedBotton) THEN { GOTO "SELFPRESERVE"; }

 : Reset blank combat global flag :
 SETCOMBATGLOBAL(W,CGTrap,1,0);

 CBX=(GetStat(ABS(Caster+999999),SCoX,1));
 CBY=(GetStat(ABS(Caster+999999),SCoY,1));

 FOR AU=1 TO MAXUNIT();

  IF ( INCOMBAT(AU) = 0 ) THEN { GOTO "NOTFORSELFDESTRUCT"; }

   IF (GetStat(AU,SCoX,1)>(CBX-2))
    %AND (GetStat(AU,SCoX,1)<(CBX+2))
    %AND (GetStat(AU,SCoY,1)>(CBY-2))
    %AND (GetStat(AU,SCoY,1)<(CBY+2))
   THEN {
    DEALCOMBATDAMAGE (AU,4*( (GETSTAT(AU,SFigures,0))-%I( (GETDAMAGE(AU,0))/(GETSTAT(AU,SHP,0)) ) ),0,0);
   }

  !NOTFORSELFDESTRUCT!

 NEXT;

 DEALCOMBATDAMAGE (ABS(Caster+999999),0,0,999);

 GOTO "ENDOFCOSPELL";

!SELFPRESERVE!

: Tactical Retreat! :
IF (SP<>STacticalRetreat) THEN { GOTO "RETREATISCOWARD"; }

 SETCOMBATENCHANTMENTFLAG(ABS(Caster+999999),EncSupremeLightRegen,ABase,1);
 SETCOMBATENCHANTMENTFLAG(ABS(Caster+999999),EncTacticalRetreat,ABase,1);
 GOTO "ENDOFCOSPELL";

!RETREATISCOWARD!

: Tactical Retreat! :
IF (SP<>STacticalRecall) THEN { GOTO "NORECALL"; }

 SETCOMBATENCHANTMENTFLAG(TU,EncSupremeLightRegen,ABase,1);
 SETCOMBATENCHANTMENTFLAG(TU,EncTacticalRetreat,ABase,1);
 GOTO "ENDOFCOSPELL";

!NORECALL!

IF (SP<>SRaiseDead) %AND (SP<>SAnimateDead) THEN { GOTO "NOABILITYRECHECK"; }

 FOR U=1 TO MAXUNIT();
 
  IF ( INCOMBAT(U) = 0 ) THEN { GOTO "SKIPTHISUNIT"; }
  IF ( ALIVE(U) = 0 ) THEN { GOTO "SKIPTHISUNIT"; }

  : Counting Goblins :
  IF (GETSTAT(U,SRace,1)=RCGoblin) THEN {
   IF (GETSTAT(U,SOwner,0)=A) THEN { GOBLINA=GOBLINA+1; } ELSE { GOBLIND=GOBLIND+1; }
   IF (GETSTAT(U,STypeID,1)=350) THEN {
    IF (GETSTAT(U,SOwner,0)=A) THEN { WARBOSSA=WARBOSSA+1; } ELSE { WARBOSSD=WARBOSSD+1; }
   }
  }

  : Counting Mechanics :
  IF (GETSTAT(U,SHeroID,1)=1)
   %OR (GETSTAT(U,STypeID,1)=52)
   %OR (GETSTAT(U,STypeID,1)=78)
   %OR (GETSTAT(U,STypeID,1)=110)
   %OR (GETSTAT(U,STypeID,1)=117)
   %OR (GETSTAT(U,STypeID,1)=144)
   %OR (GETSTAT(U,STypeID,1)=292)
   %OR (GETSTAT(U,STypeID,1)=357)
  THEN {
   IF (GETSTAT(U,SOwner,0)=A) THEN { ENGINEERA=ENGINEERA+1; } ELSE { ENGINEERD=ENGINEERD+1; }
  }

  : Counting Heroes :
  IF (ISHERO(U)>0) THEN {
   IF (GETSTAT(U,SOwner,0)=A) THEN { HEROA=HEROA+1; } ELSE { HEROD=HEROD+1; }
  }

  !SKIPTHISUNIT!
 
 NEXT;

 : Record counting variable :
 IF (GOBLINA>0) THEN {
  MASTERVARSET GOBLINCOMBATA = GOBLINA;
  MASTERVARSET WARBOSSCOMBATA = WARBOSSA;
 } ELSE {
  MASTERVARSET GOBLINCOMBATA = 0;
  MASTERVARSET WARBOSSCOMBATA = 0;
 }

 IF (GOBLIND>0) THEN {
  MASTERVARSET GOBLINCOMBATD = GOBLIND;
  MASTERVARSET WARBOSSCOMBATD = WARBOSSD;
 } ELSE {
  MASTERVARSET GOBLINCOMBATD = 0;
  MASTERVARSET WARBOSSCOMBATD = 0;
 }

 IF (ENGINEERA>0) THEN {
  MASTERVARSET MECHANICCOMBATA = ENGINEERA;
 } ELSE {
  MASTERVARSET MECHANICCOMBATA = 0;
 }

 IF (ENGINEERD>0) THEN {
  MASTERVARSET MECHANICCOMBATD = ENGINEERD;
 } ELSE {
  MASTERVARSET MECHANICCOMBATD = 0;
 }

 IF (HEROA>0) THEN {
  MASTERVARSET HEROINCOMBATA = HEROA;
 } ELSE {
  MASTERVARSET HEROINCOMBATA = 0;
 }

 IF (HEROD>0) THEN {
  MASTERVARSET HEROINCOMBATD = HEROD;
 } ELSE {
  MASTERVARSET HEROINCOMBATD = 0;
 }

!NOABILITYRECHECK!

!ENDOFCOSPELL!

HALT;
