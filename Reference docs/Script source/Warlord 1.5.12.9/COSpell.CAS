: Install a canny trap for your foes! :
IF (SP=SInstallTrap) THEN {

 : Reset blank combat global flag :
 SETCOMBATGLOBAL(W,CGTrap,1,0);

 CBX=(GetStat(ABS(Caster+999999),SCoX,1));
 CBY=(GetStat(ABS(Caster+999999),SCoY,1));
 IF (MAINCASTER=D) THEN {
  SETTERRAIN (CBX,CBY,0,GETTERRAIN(CBX,CBY,0)+12);
  GOTO "ENDOFCOSPELL";
 } ELSE {
  SETTERRAIN (CBX,CBY,0,GETTERRAIN(CBX,CBY,0)+24);
  GOTO "ENDOFCOSPELL";
 }
}

: Disrupt now deal 10 damage with proper defense roll :
IF (SP=SDisrupt) THEN {
 FOR DU=1 TO MAXUNIT();
 
 CBX=(GetStat(DU,SCoX,1));
 CBY=(GetStat(DU,SCoY,1));

 IF ( INCOMBAT(DU) = 0 ) THEN { GOTO "NOTFORDISRUPT"; }

  IF (CBX=SpellTargetX)
   %AND (CBY=SpellTargetY)
   %AND ( GetStat(DU,SOwner,1)<>MAINCASTER )
  THEN {
   ATTACK=10;
   HIT=60;
   ARMOR=( GetStat(DU,SDefense,0) );
   DEFEND=( GetStat(DU,SToDefend,0) );
   DAMAGE=0;

   : Make attack roll for 10 damage at 60% to-hit :
   LOOP{
    IF (ATTACK>0) THEN {
     ATTACK=(ATTACK-1);
     PERCENT=(RND(100));
     IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
    }
   }ENDLP (ATTACK=0);

   : Make defense roll with armor and to-defend :
   IF (DAMAGE>0) THEN { 
    LOOP{
     IF (ARMOR>0) THEN {
      ARMOR=(ARMOR-1);
      PERCENT=(RND(100));
      IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
     }
    }ENDLP (ARMOR=0);
    DEALCOMBATDAMAGE (DU,DAMAGE,0,0);
   }
  }

 !NOTFORDISRUPT!
   
 NEXT;
 GOTO "ENDOFCOSPELL";
}

