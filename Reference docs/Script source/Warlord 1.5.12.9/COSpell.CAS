IF (SP<>SFlameStrike) THEN { GOTO "NOTFLAMESTRIKE"; }

 IF (SPELLSTATE(W,STMagitekMagicalPhysics)<>2) THEN { GOTO "NOPHYSICSFLAMESTRIKE"; }
  FOR U=1 TO MAXUNIT();
 
   OLX=(GetStat(U,SOLX,1));
   OLY=(GetStat(U,SOLY,1));
   PLANE=(GetStat(U,SPlane,1));
   OWNER=(GetStat(U,SOwner,1));

   IF ( INCOMBAT(U) = 0 ) THEN { GOTO "SKIPPHYSICSFLAMESTRIKE"; }
   IF ( ALIVE(U) = 0 ) THEN { GOTO "SKIPPHYSICSFLAMESTRIKE"; }

    IF (OWNER=OPPONENT) THEN {
     IF (OLX=COMBATX())
      %AND (OLY=COMBATY())
      %AND (PLANE=COMBATP())
     THEN {
      IF (GETSTAT(U,AFireImmunity,0)=0) THEN {
       ATTACK=%I( (16*0.5) );
       HIT=60;
       DAMAGE=0;
       DEFEND=( GetStat(U,SToDefend,0) );
       ARMOR=( GetStat(U,SDefense,0) );
        IF (GETENCHANTMENTFLAG(U,EncResistElements,0)>0) THEN { ARMOR=ARMOR+4; }
        IF (GETENCHANTMENTFLAG(U,EncElementalArmor,0)>0) THEN { ARMOR=ARMOR+12; }
        IF (GETENCHANTMENTFLAG(U,EncBless,0)>0) THEN { ARMOR=ARMOR+7; }

       : Make attack roll for 10 damage at 60% to-hit :
       LOOP{
        IF (ATTACK>0) THEN {
         ATTACK=(ATTACK-1);
         PERCENT=(RND(100));
         IF ( (PERCENT) < (HIT+1) ) THEN { DAMAGE=DAMAGE+1; }
        }
       }ENDLP (ATTACK=0);

       : Make defense roll with armor and to-defend :
       IF (DAMAGE>0) THEN { 
        LOOP{
         IF (ARMOR>0) THEN {
          ARMOR=(ARMOR-1);
          PERCENT=(RND(100));
          IF ( PERCENT < (DEFEND+1) ) THEN { DAMAGE=(DAMAGE-1); }
         }
        }ENDLP (ARMOR=0);
        DEALCOMBATDAMAGE(U,DAMAGE,0,0);
       }
      }
     }
    }

   !SKIPPHYSICSFLAMESTRIKE!

  NEXT;

 !NOPHYSICSFLAMESTRIKE!

 GOTO "ENDOFCOSPELL";

