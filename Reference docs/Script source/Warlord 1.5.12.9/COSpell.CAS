: INPUT - SP - The spell being cast.
	CASTER - The caster of the spell.
		0 or higher means a wizard is casting.
		-1 or lower means a unit is casting. Unit ID equals (-Caster).
		-999999 or lower means the unit's item is casting. Unit ID equals -(Caster+999999).
	MAINCASTER - The wizard casting the spell or owning the unit who casts the spell.
	SpellTargetCity,SpellTargetPlane,SpellTargetX,SpellTargetY,
	SpellTargetUnit,SpellTargetPlayer - The target of the spell. Only the variable(s) applicable for the spell's targeting type are set.
  OUTPUT - None
  
  Please note that existing spell effects are hardcoded. To change them, create a duplicate of the spell and code the new effect in this script.
  
  :
  
W=MAINCASTER;
TU=SpellTargetUnit;
A=ATTACKER();
D=DEFENDER();
OPPONENT=(A+D)-W;
NEWU=MAXUNIT();

: spell casting count during Time Stop :
IF HASGLOBAL(W,GETimeStop)
 %OR (TIMESTOPCOUNT>0)
THEN {
 MASTERVARSET TSSPELLCOUNTING = TSSPELLCOUNTING + 1;
}

IF (SP<SBuddingSpearmen) %OR (SP>SBuddingHobgoblins) THEN { GOTO "NOTBUDDING"; }

 NU=MAXUNIT();

 SETSTAT(NU,AFantastic,1,0);
 SETSTAT(NU,SRace,1,RCGoblin);
 SETSTAT(NU,SChargesLeft,1,0);

 IF (CASTER>-999999) THEN {
  PANDORA=RND(3);
  SETSTAT(NU,ALevel,ABase,3);
  SETENCHANTMENTFLAG(NU,EncMagic,1,1);
  IF (PANDORA=0) THEN {
   SETOLENCHANTMENTFLAG(NU,EncCCBreath,1,1);
  } ELSE {
   IF (PANDORA=1) THEN {
    SETOLENCHANTMENTFLAG(NU,EncCCArmor,1,1);
   } ELSE {
    SETOLENCHANTMENTFLAG(NU,EncCCFlight,1,1);
   }
  }
  GOTO "ENDOFCOSPELL";
 }

  OU=ABS(Caster+999999);

  : check if original unit has Children of the Mother bonus or not :
  IF GETSTAT(OU,SMultiLabel,1)=12) THEN {
   SETSTAT(NU,SMultiLabel,1,12);
   SETSTAT(NU,SToDefend,1,(GETSTAT(NU,SToDefend,1)+10)
   SETSTAT(NU,SAttack,1,(GETSTAT(NU,SAttack,1)+2)
   IF (GetStat(NU,SRanged,1)>0) THEN {
    SETSTAT(NU,SRanged,1,(GetStat(NU,SRanged,1)+2));
   }
   IF (GetStat(NU,SSpellCharges,1)>0) THEN {
    SETSTAT( NU,SSpellCharges,1,(GetStat(NU,SSpellCharges,1)*2) );
   }
   IF (GetStat(NU,AFPoison,1,1)<>100) THEN { SETSTAT(NU,AFPoison,1,(GetStat(NU,AFPoison,1,1))+1,1); } ELSE { SETSTAT(NU,AFPoison,1,1,1); }
  }

  : Guiled :
  IF (GETSTAT(OU,SGuiled,1)>0) THEN {
   SETSTAT( NU,SToDefend,1,( (GETSTAT(NU,SToDefend,ABase))+(GETSTAT(OU,SGuiled,1)) ) );
   SETSTAT( NU,SGuiled,1,(GETSTAT(OU,SGuiled,1)) );
  }

  : Immunized :
  IF (GETSTAT(OU,SImmunized,1)>0) THEN {
   SETSTAT( NU,SResist,1,( (GETSTAT(NU,SResist,ABase))+(GETSTAT(OU,SImmunized,1)) ) );
   SETSTAT( NU,SImmunized,1,(GETSTAT(OU,SImmunized,1)) );
  }

  : Nightshade :
  IF (GETSTAT(OU,SNaturalResist,1)>0) THEN {
   SETSTAT( NU,SResist,1,( (GETSTAT(NU,SResist,1))+(GETSTAT(OU,SNaturalResist,1)) ) );
   SETSTAT( NU,SNaturalResist,1,(GETSTAT(OU,SNaturalResist,1)) );
  }

  : Wild Games :
  IF (GETSTAT(OU,SHunter,1)>0) THEN {
   SETSTAT( NU,SRanged,1,( (GETSTAT(NU,SRanged,1))+1 ) );
   SETSTAT( NU,SHunter,1,1 );
  }
  IF (GETSTAT(OU,AForester,1)>0) THEN {
   SETSTAT( NU,AForester,1,1 );
  }

  : Giant Strength :
  IF (GETSTAT(OU,SGiantStrength,1)>0) THEN {
   SETSTAT( NU,SAttack,1,( (GETSTAT(NU,SAttack,1))+1 ) );
   SETSTAT( NU,SGiantStrength,1,1 );
  }

  : Tough Skin :
  IF (GETSTAT(OU,SToughSkin,1)>0) THEN {
   SETSTAT( NU,SDefense,1,( (GETSTAT(NU,SDefense,1))+1 ) );
   SETSTAT( NU,SToughSkin,1,1 );
  }

  : Power of Faith :
  IF (GETSTAT(OU,SPowerOfFaith,1)>0) THEN {
   SETSTAT( NU,SResist,1,( (GETSTAT(NU,SResist,1))+(GETSTAT(OU,SPowerOfFaith,1)) ) );
   SETSTAT( NU,SPowerOfFaith,1,(GETSTAT(OU,SPowerOfFaith,1)) );
  }
  IF (GETSTAT(OU,ALucky,1)>0) THEN {
   SETSTAT( NU,ALucky,1,1 );
  }

  : Disciplined :
  IF (GETENCHANTMENTFLAG(OU,EncDiscipline,1)>0) THEN { SETENCHANTMENTFLAG(NU,EncDiscipline,1,1); }

  : Chaos Channels :
  IF (GETENCHANTMENTFLAG(OU,EncCCBreath,0)>0) THEN { SETOLENCHANTMENTFLAG(NU,EncCCBreath,1,1); }
  IF (GETENCHANTMENTFLAG(OU,EncCCArmor,0)>0) THEN { SETOLENCHANTMENTFLAG(NU,EncCCArmor,1,1); }
  IF (GETENCHANTMENTFLAG(OU,EncCCFlight,0)>0) THEN { SETOLENCHANTMENTFLAG(NU,EncCCFlight,1,1); }

  : Warp Creatures :
  IF (GETENCHANTMENTFLAG(OU,EncWarpAttack,0)>0) THEN { SETENCHANTMENTFLAG(NU,EncWarpAttack,1,1); }
  IF (GETENCHANTMENTFLAG(OU,EncWarpDefense,0)>0) THEN { SETENCHANTMENTFLAG(NU,EncWarpDefense,1,1); }
  IF (GETENCHANTMENTFLAG(OU,EncWarpResist,0)>0) THEN { SETENCHANTMENTFLAG(NU,EncWarpResist,1,1); }

  : transfer Undead :
  IF (GETENCHANTMENTFLAG(OU,EncUndead,1)>0) THEN { SETENCHANTMENTFLAG(NU,EncUndead,1,1); }

  : transfer Vampirism :
  IF (GETENCHANTMENTFLAG(OU,EncVampirism,0)>0) THEN { SETENCHANTMENTFLAG(NU,EncVampirism,1,1); }

  : transfer Apotheosis :
  IF (GETENCHANTMENTFLAG(OU,EncDestiny,0)>0) THEN { SETOLENCHANTMENTFLAG(NU,EncDestiny,1,1); }

  : reduce health of unit according to original host :
  TRANSFERDAMAGE=%I( ( (GETSTAT(NU,SHP,0))*(GETSTAT(OU,SFigures,0)) )*(GETDAMAGE(OU,0))/( (GETSTAT(OU,SHP,0))*(GETSTAT(OU,SFigures,0)) ) );
  IF (TRANSFERDAMAGE<1) THEN { GOTO "ENDOFCOSPELL"; }
  IF ( TRANSFERDAMAGE>( ( (GETSTAT(NU,SHP,0))*(GETSTAT(OU,SFigures,0)) )-1 ) ) THEN { DEALCOMBATDAMAGE(NU,0,0,( ( (GETSTAT(NU,SHP,0))*(GETSTAT(OU,SFigures,0)) )-1 ) ); } ELSE { DEALCOMBATDAMAGE(NU,0,0,TRANSFERDAMAGE); }

 GOTO "ENDOFCOSPELL";

!NOTBUDDING!

IF (SP<>SEarthElemental) THEN { GOTO "NOTEARTHELEMENTAL"; }

 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreAdamantium) THEN {
  SETENCHANTMENTFLAG(NEWU,EncAdamant,1,1);
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreMithril) THEN {
  SETENCHANTMENTFLAG(NEWU,EncMithril,1,1);
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreOrihalcon) THEN {
  SETENCHANTMENTFLAG(NEWU,EncOrihalcon,1,1);
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreIron) THEN {
  SETENCHANTMENTFLAG(NEWU,EncIronSkin,1,1);
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreCoal) THEN {
  SETENCHANTMENTFLAG(NEWU,EncImmolation,1,1);
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreNightshade) THEN {
  SETSTAT(NEWU,SResist,1,(GETSTAT(NEWU,SResist,1))+3 );
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreCrysx) THEN {
  SETSTAT(NEWU,SResist,1,(GETSTAT(NEWU,SResist,1))+2 );
 }
 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+2)=OreQuork) THEN {
  SETSTAT(NEWU,SResist,1,(GETSTAT(NEWU,SResist,1))+1 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTGrass) THEN {
  SETSTAT(NEWU,SResist,1,(GETSTAT(NEWU,SResist,1))+4 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTSea) THEN {
  SETSTAT(NEWU,AFireImmunity,1,1 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTFloating) THEN {
  SETSTAT(NEWU,ALightningResistance,1,1 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTIce) THEN {
  SETSTAT(NEWU,AColdImmunity,1,1 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTForest)
  %OR (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTPine)
 THEN {
  SETSTAT(NEWU,SCustomAttribute,1,3 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTrock)
  %OR (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTRock2)
  %OR (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTMountain)
 THEN {
  SETSTAT(NEWU,SDefense,1,(GETSTAT(NEWU,SDefense,1))+3 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTDesert) THEN {
  SETSTAT(NEWU,ANoncorporeal,1,1 );
 }
 IF (GETTERRAIN(SpellTargetX,SpellTargetY,0)=CTSwamp) THEN {
  SETSTAT(NEWU,SDefense,1,(GETSTAT(NEWU,SDefense,1))-2 );
  SETSTAT(NEWU,AMerging,1,1 );
 }
 GOTO "ENDOFCOSPELL";

!NOTEARTHELEMENTAL!

IF (SP<>STAirSupportDoctrine) THEN { GOTO "NOTAIRSUPPORT"; }

 SETENCHANTMENTFLAG(NEWU,EncSpiritLink,1,1);
 IF BASEFANTASTIC(NEWU) THEN {
  SETSTAT(NEWU,AFantastic,1,0);
  SETSTAT(NEWU,ALevel,1,1);
 }

 : new effect of Artificer retort, mechanical units gain magic weapon, +1 resistance, and land mechanical units get +1 movement :
 IF RETORT(W,Artificer) %AND (GetStat(NEWU,SCustomAttribute,1)=1) THEN {
  SETENCHANTMENTFLAG(NEWU,EncMagic,1,1);
  SETSTAT(NEWU,SAttack,1,(GetStat(NEWU,SAttack,0)+1));
  SETSTAT(NEWU,SRanged,1,(GetStat(NEWU,SRanged,1)+1));
  SETSTAT(NEWU,SDefense,1,(GetStat(NEWU,SDefense,1)+1));
  SETSTAT(NEWU,SResist,1,(GetStat(NEWU,SResist,1)+2));
  SETSTAT(NEWU,SOLMaxMoves,1,(GetStat(NEWU,SOLMaxMoves,1)+2));
  SETSTAT(NEWU,SOLMovesLeft,1,(GetStat(NEWU,SOLMovesLeft,1)+2));
  SETSTAT(NEWU,SCombatMaxMoves,1,(GetStat(NEWU,SCombatMaxMoves,1)+2));
  SETSTAT(NEWU,SCombatMovesLeft,1,(GetStat(NEWU,SCombatMovesLeft,1)+2));
 }

 IF HASGLOBAL(W,GEEnlightenment)
  %OR (SPELLSTATE(W,STMilitaryDrilling)=2)
 THEN { 
  SETENCHANTMENTFLAG(NEWU,EncDiscipline,1,1);
 }

 IF (SPELLSTATE(W,STHeatPowerEngine)=2) THEN {
  SETENCHANTMENTFLAG(NEWU,EncPowerEngine,1,1);
  SETSTAT(NEWU,SOLMaxMoves,1,(GetStat(NEWU,SOLMaxMoves,1)+2));
  SETSTAT(NEWU,SCombatMaxMoves,1,(GetStat(NEWU,SCombatMaxMoves,1)+2));
 }

 IF (SPELLSTATE(W,STArmorClad)=2) THEN {
  SETENCHANTMENTFLAG(NEWU,EncArmorClad,1,1);
  SETSTAT(NEWU,SDefense,1,(GetStat(NEWU,SDefense,1)+6));
  IF (SPELLSTATE(W,STMagitekMaterialScience)=2) THEN {
   SETENCHANTMENTFLAG(NEWU,EncResistMagic,1,1);
  }
 }

 IF (SPELLSTATE(W,STRocketry)=2) THEN {
  SETSTAT(NEWU,SBlackpowderUpgrade,1,1);
  IF (GetStat(NEWU,AFPoison,1,1)<>100) THEN { SETSTAT(NEWU,AFPoison,1,(GetStat(NEWU,AFPoison,1,1))+1,1); } ELSE { SETSTAT(NEWU,AFPoison,1,1,1); }
  IF (GetStat(NEWU,AFArmorPiercing,1,1)=0) %AND (GetStat(NEWU,AFDoom,1,1)=0) THEN {
   SETSTAT(NEWU,AFArmorPiercing,1,1,1);
  } ELSE {
   IF (GetStat(NEWU,SRanged,1)>0) THEN { SETSTAT(NEWU,SRanged,1,(GetStat(NEWU,SRanged,1)+2)); }
   IF (GetStat(NEWU,SThrown,1)>0) THEN { SETSTAT(NEWU,SThrown,1,(GetStat(NEWU,SThrown,1)+4)); }
  }
 }

 : Mariner Mastery bonus is removable by end turn script if global enchantment is removed :
 : all units originally have have sail movement :
 IF (HASGLOBAL(W,GEMarinerMastery)=0) THEN { GOTO "NOOUTLANDERMARINERMASTERY"; }
  IF (GetStat(NEWU,SMMastery,1)>0) %OR (GetStat(NEWU,ASailing,1)=0) THEN { GOTO "NOOUTLANDERMARINERMASTERY"; }

   SETSTAT(NEWU,SOLMaxMoves,1,(GetStat(NEWU,SOLMaxMoves,1)+4));
   SETSTAT(NEWU,SOLMovesLeft,1,(GetStat(NEWU,SOLMovesLeft,1)+4));
   SETSTAT(NEWU,SCombatMaxMoves,1,(GetStat(NEWU,SCombatMaxMoves,1)+4));
   SETSTAT(NEWU,SCombatMovesLeft,1,(GetStat(NEWU,SCombatMovesLeft,1)+4));
   SETSTAT(NEWU,SMMastery,1,1);

 !NOOUTLANDERMARINERMASTERY!

 HQ=CITYONTILE( GETWIZARDDATA(W,WDFortressP),GETWIZARDDATA(W,WDFortressX),GETWIZARDDATA(W,WDFortressY) );

 IF BANISHED(W) %OR (HQ=0) %OR ( (HQ>0) %AND (CITYENCHANT(HQ,CEEvilPresence)>-1) ) THEN { GOTO "NOHQ"; }

  IF (CITYENCHANT(HQ,CEMagicPerimeter)>-1) THEN {
   SETENCHANTMENTFLAG(NEWU,EncMagic,1,1);
  }

  LOGISTIC=0;
  OWNMITHRIL=0;
  OWNADAMANTIUM=0;
  OWNORIHALCON=0;
  OWNCRYSX=0;

  IF (SPELLSTATE(W,STStrategicLogistic)=2) THEN {
   LOGISTIC=1;

   FOR I=1 TO MAXCITY();

    IF (CITYOWNER(I)=W) THEN {
     OWNMITHRIL=OWNMITHRIL+OREINRANGE(I,OreMithril);
     OWNADAMANTIUM=OWNADAMANTIUM+OREINRANGE(I,OreAdamantium);
     OWNORIHALCON=OWNORIHALCON+OREINRANGE(I,OreOrihalcon);
     OWNCRYSX=OWNCRYSX+OREINRANGE(I,OreCrysx);
    }

   NEXT I;

  } ELSE {
   OWNMITHRIL=OWNMITHRIL+OREINRANGE(HQ,OreMithril);
   OWNADAMANTIUM=OWNADAMANTIUM+OREINRANGE(HQ,OreAdamantium);
   OWNORIHALCON=OWNORIHALCON+OREINRANGE(HQ,OreOrihalcon);
   OWNCRYSX=OWNCRYSX+OREINRANGE(HQ,OreCrysx);
  }

  IF (ISBUILT(HQ,BAlchemistguild)=0)
   %AND ( (LOGISTIC=0) %OR (BUILDINGSOWNED(W,BAlchemistguild,0)=0) )
  THEN { GOTO "NOOUTLANDERWEAPON"; }

   SETENCHANTMENTFLAG(NEWU,EncMagic,1,1);

   ORELEVEL=0;
   IF (OWNMITHRIL>0) THEN { ORELEVEL=1; }
   IF (OWNADAMANTIUM>0) THEN { ORELEVEL=2; }
   IF (BUILDINGSOWNED(W,BLavaSmelter,0)>0) THEN { ORELEVEL=ORELEVEL+1; }
   IF (BUILDINGSOWNED(W,BAlchemistGuild,CESorcererStone)>0) THEN { ORELEVEL=ORELEVEL+1; }

   IF ( (ORELEVEL>2) %OR (OWNORIHALCON>0) )
    %AND (GETENCHANTMENTFLAG(NEWU,EncOrihalcon,1)=0)
   THEN {
    SETENCHANTMENTFLAG(NEWU,EncOrihalcon,1,1);
    : give transmutes equipment flag to any unit with both adamantium and orihalcon to prevent redundent enchantment :
    IF GETENCHANTMENTFLAG(NEWU,EncAdamant,ABase)
     %AND GETENCHANTMENTFLAG(NEWU,EncOrihalcon,ABase)
    THEN {
     SETENCHANTMENTFLAG(NEWU,EncTransmuteEquipment,1,1);
    }
   }
   IF (GETENCHANTMENTFLAG(NEWU,EncAdamant,1)>0) THEN { GOTO "NOOUTLANDERWEAPON"; }
    IF (ORELEVEL>1) THEN {
     SETENCHANTMENTFLAG(NEWU,EncAdamant,1,1);
     IF (GETENCHANTMENTFLAG(NEWU,EncMithril,1)>0) THEN {
      SETENCHANTMENTFLAG(NEWU,EncMithril,1,0);
     }
     : give transmutes equipment flag to any unit with both adamantium and orihalcon to prevent redundent enchantment :
     IF GETENCHANTMENTFLAG(NEWU,EncAdamant,1)
      %AND GETENCHANTMENTFLAG(NEWU,EncOrihalcon,1)
     THEN {
      SETENCHANTMENTFLAG(NEWU,EncTransmuteEquipment,1,1); 
     }
    } ELSE {
     IF (GETENCHANTMENTFLAG(NEWU,EncMithril,1)>0) THEN { GOTO "NOOUTLANDERWEAPON"; }
      IF (ORELEVEL=1) THEN {
       SETENCHANTMENTFLAG(NEWU,EncMithril,1,1);
      }
    }

  !NOOUTLANDERWEAPON!

  : Effect of Pillar of Faith, unit has chance 20% to get lucky upon unit creation :
  IF (CITYENCHANT(HQ,CEPillarOfFaith)=-1) THEN { GOTO "NOPILLAROFFAITH"; }
   FAITH=0
   LUCK=RND(5)+1;
   RESIST=GETSTAT(NEWU,SResist,1);

   IF CITYENCHANT(HQ,CEHeavenlyLight)>-1 THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BShrine) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BParthenon) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BWitchesConvent) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BCathedral) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BTemple) THEN { FAITH=FAITH+1; }
   IF HASGLOBAL(W,GEKingOfUnderworld) %AND ISBUILT(HQ,BOracle) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BAltarOfStorm) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BAltarOfTheSun) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BAltarOfTheMoon) THEN { FAITH=FAITH+1; }
   IF ISBUILT(HQ,BBasilica) THEN { FAITH=FAITH+1; }
   SETSTAT(NEWU,SPowerOfFaith,1,FAITH);
   SETSTAT(NEWU,SResist,1,RESIST+FAITH);
   IF (GETSTAT(NEWU,ALucky,1)=0) %AND (LUCK=5) THEN { 
    SETSTAT(NEWU,ALucky,1,1);
   }

  !NOPILLAROFFAITH!

  : New effect of Nature Embrace, Animist's Guild enchant unit with Resist Elements (not permanent) :
  IF HASGLOBAL(W,GECallTheWild) %AND ISBUILT(HQ,BAnimistGuild) THEN {
   IF (SPELLSTATE(W,STattooMagic)=2) THEN {
    SETENCHANTMENTFLAG(NEWU,EncResistElements,ABase,1);
   } ELSE {
    SETOLENCHANTMENTFLAG(NEWU,EncResistElements,ABase,1);
   }
  }

  : New effect of Consecration, Temple/Cathedral enchant unit with Bless (not permanent) :
  IF (CITYENCHANT(HQ,CEConsecration)>-1)
   %AND ( (ISBUILT(HQ,BCathedral)) %OR (ISBUILT(HQ,BTemple)) )
  THEN {
   IF (SPELLSTATE(W,STattooMagic)=2) THEN {
    SETENCHANTMENTFLAG(NEWU,EncBless,1,1);
   } ELSE {
    SETOLENCHANTMENTFLAG(NEWU,EncBless,1,1);
   }
  }

  : New effect of Crusade allow city with armorer guild + cathedral/temple to give permanent holy armor enchantment) :
  IF HASGLOBAL(W,GECrusade) %AND ISBUILT(HQ,BArmorerGuild)
   %AND ( (ISBUILT(HQ,BCathedral)) %OR (ISBUILT(HQ,BTemple)) )
  THEN {
   IF (SPELLSTATE(W,STattooMagic)=2) THEN {
    SETENCHANTMENTFLAG(NEWU,EncDummyArmor,1,1);
   } ELSE {
    SETOLENCHANTMENTFLAG(NEWU,EncHolyArmor,1,1);
   }
  }

  IF ( (ISBUILT(HQ,BLavaSmelter)=0) )
   %AND ( (LOGISTIC=0) %OR (BUILDINGSOWNED(W,BLavaSmelter,0)=0) )
  THEN { GOTO "NOLAVASMELTER"; }

   IF (GETSTAT(NEWU,AWeaponImmunity,1)>0) THEN { GOTO "OUTLANDERSKIPWEAPONIMMUNE"; }

    IF (OWNMITHRIL>0) %AND (OWNADAMANTIUM>0) THEN { SETSTAT(NEWU,AWeaponImmunity,1,1); }

   !OUTLANDERSKIPWEAPONIMMUNE!

   IF (GETSTAT(NEWU,AMissileImmunity,1)>0) THEN { GOTO "OUTLANDERSKIPMISSILEIMMUNE"; }

    IF (OWNMITHRIL>0) %AND (OWNCRYSX>0) THEN { SETSTAT(NEWU,AMissileImmunity,1,1); }

   !OUTLANDERSKIPMISSILEIMMUNE!

   IF (GETENCHANTMENTFLAG(NEWU,EncResistElements,1)>0) THEN { GOTO "OUTLANDERSKIPRESISTELEMENT"; }

    IF (OWNMITHRIL>0) %AND (OWNORIHALCON>0) THEN { SETENCHANTMENTFLAG(NEWU,EncResistElements,1,1); }

   !OUTLANDERSKIPRESISTELEMENT!

   IF (GETENCHANTMENTFLAG(NEWU,EncElementalArmor,1)>0) THEN { GOTO "OUTLANDERSKIPELEMENTALARMOR"; }

    IF (OWNADAMANTIUM>0) %AND (OWNORIHALCON>0) THEN { SETENCHANTMENTFLAG(NEWU,EncElementalArmor,1,1); }

   !OUTLANDERSKIPELEMENTALARMOR!

   IF (GETENCHANTMENTFLAG(NEWU,EncFlameBlade,1)>0) THEN { GOTO "OUTLANDERSKIPFLAMEBLADE"; }

    IF (OWNADAMANTIUM>0) %AND (OWNCRYSX>0) THEN { SETENCHANTMENTFLAG(NEWU,EncFlameBlade,1,1); }

   !OUTLANDERSKIPFLAMEBLADE!

  !NOLAVASMELTER!

  : Outlander unit gains Mariner from Baray through upgrade protocol :
  IF ( (ISBUILT(HQ,BBaray)=0) )
   %AND ( (LOGISTIC=0) %OR (BUILDINGSOWNED(W,BBaray,0)=0) )
  THEN { GOTO "NOOUTLANDERBARAY"; }

   IF (GETSTAT(NEWU,SMariner,1)=0) THEN {
    SETSTAT(NEWU,SMariner,1,1)
   }

  !NOOUTLANDERBARAY!

  : Effect of Chaos' Blessing and/or Doom Mastery :
  IF (CITYENCHANT(HQ,CEChaosBless)>-1) %AND (HASGLOBAL(W,GEDoomMastery)) THEN { 
   SETENCHANTMENTFLAG(NEWU,EncCCBreath,1,1);
   SETENCHANTMENTFLAG(NEWU,EncCCArmor,1,1);
   SETENCHANTMENTFLAG(NEWU,EncCCFlight,1,1);
   :Apply chaos channel:
   APPLYCHAOSCHANNEL NEWU;
  } ELSE {
   IF (CITYENCHANT(HQ,CEChaosBless)>-1) %OR (HASGLOBAL(W,GEDoomMastery)) THEN { APPLYCHAOSCHANNEL(NEWU); }
  }

  : == Unit bonus as unit's veterancy == :
  : Altar of Battle/War College/Barracks's unit veterancy :
  IF CITYENCHANT(HQ,CEAltarofBattle)>-1 THEN {
   SETSTAT(NEWU,ALevel,1,4);
  } ELSE { 
   IF ISBUILT(HQ,BWarCollege) THEN {
    SETSTAT(NEWU,ALevel,1,3); 
   } ELSE {
    IF ISBUILT(HQ,BBarracks) THEN { SETSTAT(NEWU,ALevel,1,2); }
   }
  }

  : special, unit from Necropolis becomes Undead :
  IF (CITYENCHANT(HQ,CENecropolis)>-1) THEN {
   SETENCHANTMENTFLAG(NEWU,EncUndead,1,1);
   SETENCHANTMENTFLAG(NEWU,EncWraithForm,1,1);
   IF (SPELLSTATE(W,STMagitekPneumaReactor)=2) THEN {
    SETENCHANTMENTFLAG(NEWU,EncFrenzy,1,1);
   }
  }

 !NOHQ!

 IF (SPELLSTATE(W,STMagitekAntiGravityDrive)<>2) THEN { GOTO "NOANTIGRAVITY"; }

  IF (GETENCHANTMENTFLAG(NEWU,EncPowerEngine,1)>0) THEN {
   SETENCHANTMENTFLAG(NEWU,EncHaste,ABase,1);
   IF (GETSTAT(NEWU,ASailing,1)>0) THEN {
    SETSTAT(NEWU,AFlying,1,1);
    SETSTAT(NEWU,AIllusionImmunity,1,1);
   }
  }

 !NOANTIGRAVITY!

 IF (SPELLSTATE(W,STMagitekBeamWeapon)<>2) THEN { GOTO "NOBEAMCANNON"; }
  IF (GETSTAT(NEWU,SRangedType,1)=40) THEN { GOTO "NOBEAMCANNON"; }

   IF (GETENCHANTMENTFLAG(NEWU,EncPowerEngine,1)>0)
    %AND (GETSTAT(NEWU,SMaxAmmo,1)>0)
   THEN {
    SETSTAT(NEWU,SRangedType,1,40);
    SETSTAT(NEWU,SRanged,1,GETSTAT(NEWU,SRanged,1)+%I(GETSTAT(NEWU,SRanged,1)/2));
    SETSTAT(NEWU,AFDoom,1,1,3);
   }

