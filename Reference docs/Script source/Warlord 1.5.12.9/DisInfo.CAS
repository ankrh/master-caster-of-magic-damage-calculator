:	INPUT - None
	OUTPUT - None. Use the ADDABILITYLINE command to display abilities.
	(Unit aura and node information is still hardcoded.)
:
DEBUGLOG "Display Info";

ETERNAL=0;
SURGE=0;
ORDER=0;
KING=0;
ICEAGE=0;
A=ATTACKER();
D=DEFENDER();

FOR J=0 TO NOFWIZARDS();

 IF (J<>D) %AND (J<>A) THEN {
  IF HASGLOBAL(J,GEEternalNight) THEN { ETERNAL=ETERNAL+1; }
  IF HASGLOBAL(J,GEKingofUnderworld) THEN { KING=KING+1; }
 }
 IF (HASGLOBAL(J,GEChaosSurge)) THEN { SURGE=SURGE+1; }
 IF (HASGLOBAL(J,GEDivineOrder)) THEN { ORDER=ORDER+1; }
 IF (HASGLOBAL(J,GEIceAge)) THEN { ICEAGE=ICEAGE+1; }
  
NEXT J;

FOR J=1 to 2;
 IF J=1 THEN { W=D; } ELSE { W=A; }
 IF (W<>NeutralplayerID) THEN {
  IF (SPELLSTATE(W,STXenopsychology)=2) THEN { AddAbilityLine J,-382,"Spell Xenopsychology","Xenopsychology"; }
  IF (SPELLSTATE(W,STRadio)=2) THEN { AddAbilityLine J,-383,"Spell Radio","Radio"; }
  IF (SPELLSTATE(W,STNursingAndSurgery)=2) THEN { AddAbilityLine J,-381,"Spell Hospital & Surgery","Hospital & Surgery"; }
  IF (SPELLSTATE(W,STExplosive)=2) THEN { AddAbilityLine J,-375,"Spell Explosive","Explosive"; }
  IF (SPELLSTATE(W,STBallisticsTraining)=2) THEN { AddAbilityLine J,-384,"Spell Ballistics Training","Ballistics Training"; }
  IF (SPELLSTATE(W,STMilitaryDrilling)=2) THEN { AddAbilityLine J,-385,"Spell Military Drilling","Military Drilling"; }

  IF (SPELLSTATE(W,STMagitekMagicalPhysics)=2) THEN { AddAbilityLine J,-386,"Spell Magical Physics","Magical Physics"; }
  IF (SPELLSTATE(W,STMagitekMaterialScience)=2) THEN { AddAbilityLine J,-387,"Spell Magitek Science","Magitek Science"; }
  IF (SPELLSTATE(W,STMagitekPowerEngine)=2) THEN { AddAbilityLine J,-378,"Spell Magitek Engineering","Magitek Engineering"; }
  IF (SPELLSTATE(W,STMagitekXenoveterinary)=2) THEN { AddAbilityLine J,-388,"Spell Xenoveterinary","Xenoveterinary"; }
  IF (SPELLSTATE(W,STMagitekAntiGravityDrive)=2) THEN { AddAbilityLine J,-389,"Spell Temporal Engineering","Temporal Engineering"; }
  IF (SPELLSTATE(W,STMagitekBeamWeapon)=2) THEN { AddAbilityLine J,-390,"Spell Energy Beam Weapons","Energy Beam Weapons"; }
  IF (SPELLSTATE(W,STMagitekPsycheForceConverter)=2) THEN { AddAbilityLine J,-391,"Spell Psycho Converter","Psycho Converter"; }
  IF (SPELLSTATE(W,STMagitekPneumaReactor)=2) THEN { AddAbilityLine J,-392,"Spell Pneuma Reactor","Pneuma Reactor"; }

  IF HasGlobal(W,GEHerbMastery) THEN { AddAbilityLine J,-237,"Spell Herb Mastery","Herb Mastery"; }
  IF HasGlobal(W,GESurvivalInstinct) THEN { AddAbilityLine J,26,"Spell Survival Instinct","Survival Instinct"; }
  IF HasGlobal(W,GEAEtherBinding) THEN { AddAbilityLine J,24,"Spell AEther Binding","AEther Binding"; }
  IF HasGlobal(W,GEMarinerMastery) THEN { AddAbilityLine J,-194,"Spell Mariner Mastery","Mariner Mastery"; }
  IF HasGlobal(W,GEReinforceMagic) THEN { AddAbilityLine J,31,"Spell Reinforce Magic","Reinforce Magic"; }
  IF HasGlobal(W,GETimeStop) THEN { AddAbilityLine J,-276,"Spell Time Stop","Time Stop"; }
  IF HasGlobal(W,GEWindMastery) THEN { AddAbilityLine J,32,"Spell Wind Mastery","Wind Mastery"; }
  IF HasGlobal(W,GEPowerLink) THEN { AddAbilityLine J,24,"Spell Power Link","Power Link"; }
  IF HasGlobal(W,GEGreatUnbinding) THEN { AddAbilityLine J,-314,"Spell Great Unbinding","Great Unbinding"; }
  IF HasGlobal(W,GEInnerPower) THEN { AddAbilityLine J,27,"Spell Inner Power","Inner Power"; }
  IF HasGlobal(W,GEMeteorStorm) THEN { AddAbilityLine J,-200,"Spell Meteor Storm","Meteor Storm"; }
  IF HasGlobal(W,GEBlazingEyes) THEN { AddAbilityLine J,28,"Spell Chaos Embrace","Chaos Embrace"; }
  IF HasGlobal(W,GEBloodAndIron) THEN { AddAbilityLine J,-200,"Spell Blood and Iron","Blood and Iron"; }
  IF HasGlobal(W,GEJustCause) THEN { AddAbilityLine J,-342,"Spell Just Cause","Just Cause"; }
  IF HasGlobal(W,GEHolyArms) THEN { AddAbilityLine J,2,"Spell Holy Arms","Holy Arms"; }
  IF HasGlobal(W,GECrusade) THEN { AddAbilityLine J,1,"Spell Crusade","Crusade"; }
  IF HasGlobal(W,GECharmOfLife) THEN { AddAbilityLine J,4,"Spell Charm of Life","Charm of Life"; }
  IF HasGlobal(W,GEAngelicGuardians) THEN { AddAbilityLine J,-233,"Spell Angelic Guardians","Angelic Guardians"; }
  IF HasGlobal(W,GERulerofHeaven) THEN { AddAbilityLine J,29,"Spell Ruler of Heaven","Ruler of Heaven"; }
  IF HasGlobal(W,GEKingofUnderworld) THEN { AddAbilityLine J,30,"Spell Ruler of Underworld","Ruler of Underworld"; }
  IF HasGlobal(W,GEFateMastery) THEN { AddAbilityLine J,-236,"Spell Dance of Death","Dance of Death"; }
  IF HasGlobal(W,GEZombieMastery) THEN { AddAbilityLine J,10,"Spell Zombie Mastery","Zombie Mastery"; }
  IF HasGlobal(W,GEEternalNight) THEN { AddAbilityLine J,22,"Spell Eternal Night","Eternal Night"; }
  IF HasGlobal(W,GEEvilOmens) THEN { AddAbilityLine J,23,"Spell Evil Omens","Evil Omens"; }
  IF HasGlobal(W,GEStateOfRot) THEN { AddAbilityLine J,-234,"Spell State of Rot","State of Rot"; }
  IF HasGlobal(W,GEDeathReckoning) THEN { AddAbilityLine J,-313,"Spell Death Reckoning","Death Reckoning"; }
  IF HasGlobal(W,GEDomainOfEnchanter) THEN { AddAbilityLine J,-356,"Spell Domain of Enchanter","Domain of Enchanter"; }
 }
NEXT J;

IF Order=0 THEN { GOTO "NOORDER"; }

 S$="";
 IF ORDER>1 THEN { S$=S$+" x"+STRS(Order); }
 AddAbilityLine 3,20,"Spell Divine Order","Divine Order"+S$);

!NOORDER!

IF Surge=0 THEN { GOTO "NOOSURGE"; }

 S$="";
 IF Surge>1 THEN { S$=S$+" x"+STRS(Surge); }
 AddAbilityLine 3,21,"Spell Chaos Surge","Chaos Surge"+S$);

!NOOSURGE!

IF Eternal=0 THEN { GOTO "NOETERNAL"; }

 S$="";
 IF Eternal>1 THEN { S$=S$+" x"+STRS(Eternal); }
 AddAbilityLine 3,22,"Spell Eternal Night","Eternal Night"+S$);

!NOETERNAL!

IF King>0 THEN { AddAbilityLine 3,30,"Spell Ruler of Underworld","Ruler of Underworld"; }

IF ICEAGE>0 THEN { AddAbilityLine J,-317,"Spell Ice Age","Ice Age"; }


C=Cityontile(combatP(),combatX(),combatY());

IF C=0 THEN { GOTO "NOTSIEGE"; }

 IF CITYENCHANT(C,CEPestilence)>=0 %OR ((EVENTVAL(EvPlague))=C)  THEN { AddAbilityLine 1,-113,"Spell PLAGUE","Plague"; }
 IF CITYENCHANT(C,CENatureWard)>=0  THEN { AddAbilityLine 3,15,"Spell Spell Ward","Nature Ward"; }
 IF CITYENCHANT(C,CESorceryWard)>=0  THEN { AddAbilityLine 3,16,"Spell Spell Ward","Sorcery Ward"; }
 IF CITYENCHANT(C,CEChaosWard)>=0  THEN { AddAbilityLine 3,17,"Spell Spell Ward","Chaos Ward"; }
 IF CITYENCHANT(C,CELifeWard)>=0  THEN { AddAbilityLine 3,18,"Spell Spell Ward","Life Ward"; }
 IF CITYENCHANT(C,CEDeathWard)>=0  THEN { AddAbilityLine 3,19,"Spell Spell Ward","Death Ward"; }
 IF CITYENCHANT(C,CEGospelOfEvangelism)>=0  THEN { AddAbilityLine 3,-354,"Spell Gospel of Evangelism","Gospel of Evangelism"; }
 IF CITYENCHANT(C,CEDisheartenProphesy)>=0  THEN { AddAbilityLine 3,-355,"Spell Dishearten Prophesy","Dishearten Prophesy"; }
 IF CITYENCHANT(C,CEHeavenlyLight)>=0  THEN { AddAbilityLine 1,3,"Spell Heavenly Light","Heavenly Light"; }
 IF CITYENCHANT(C,CECloudOfShadow)>=0  THEN { AddAbilityLine 1,9,"Spell Cloud of Shadow","Cloud of Shadow"; }
 IF CITYENCHANT(C,CENecropolis)>=0  THEN { AddAbilityLine 1,-310,"Spell Necropolis","Necropolis"; }
 IF CITYENCHANT(C,CEChaosBless)>=0  THEN { AddAbilityLine 1,-235,"Spell Chaos' Blessing","Chaos' Blessing"; }
 IF ISBUILT(C,BHillfort)>0 THEN { AddAbilityLine 1,-160,"B HILLFORT","Hillfort"; }
 IF ISBUILT(C,BMoats)>0 THEN { AddAbilityLine 1,-160,"B FORTIFICATION","Fortification"; }
 IF ISBUILT(C,BLavaSmelter)>0 THEN { AddAbilityLine 1,-160,"B LAVA SMELTER","Lava Smelter"; }
 IF ISBUILT(C,BTreeOfLife)>0 THEN { AddAbilityLine 1,-160,"B TREE OF LIFE","Tree of Life"; }
 IF ISBUILT(C,BHiveNetwork)>0 THEN { AddAbilityLine 1,-160,"B UNDERCITY HIVE NETWORK","Undercity Hive Network"; }
 IF ISBUILT(C,BBaray)>0 THEN { AddAbilityLine 1,-160,"B BARAY","Baray"; }
 IF ISBUILT(C,BWitchesConvent)>0 THEN { AddAbilityLine 1,-160,"B WITCHES' CONVENT","Witches' Convent"; }
 IF ISBUILT(C,BAltarOfTheMoon)>0 THEN { AddAbilityLine 1,-160,"B ALTAR OF THE MOON","Altar of the Moon"; }
 IF ISBUILT(C,BAltarOfTheSun)>0 THEN { AddAbilityLine 1,-160,"B ALTAR OF THE SUN","Altar of the Sun"; }
 IF ISBUILT(C,BAltarOfStorm)>0 THEN { AddAbilityLine 1,-160,"B ALTAR OF STORM","Altar of Storm"; }
 IF ISBUILT(C,BBasilica)>0 THEN { AddAbilityLine 1,-160,"B SANCTA BASILICA","Sancta Basilica"; }

!NOTSIEGE!


FOR J=1 to 2;
 IF J=1 THEN { W=D; } ELSE { W=A; }

 IF W<>NeutralplayerID  THEN {
  :Debuglog "Info script W="+STRS(W);:

  IF Retort(W,Specialist) THEN {
   RE=PRIMARYREALM(W);
   IF RE=1 THEN {
    AddAbilityLine J,-53,"Retort Specialist","Nature Specialist";
    IF (SPELLSTATE(W,SGaiaMastery)=2) THEN {
     AddAbilityLine J,-53,"Spell Gaia Mastery","Gaia Mastery";
    }
   }
   IF RE=2 THEN {
    AddAbilityLine J,-53,"Retort Specialist","Sorcery Specialist";
    IF (SPELLSTATE(W,SAetherMastery)=2) THEN {
     AddAbilityLine J,-53,"Spell Aether Mastery","Aether Mastery";
    }
   }
   IF RE=3 THEN {
    AddAbilityLine J,-53,"Retort Specialist","Chaos Specialist";
    IF (SPELLSTATE(W,SChaosMastery)=2) THEN {
     AddAbilityLine J,-53,"Spell Chaos Mastery","Chaos Mastery";
    }
   }
   IF RE=4 THEN {
    AddAbilityLine J,-53,"Retort Specialist","Life Specialist";
    IF (SPELLSTATE(W,SLifeMastery)=2) THEN {
     AddAbilityLine J,-53,"Spell Life Mastery","Life Mastery";
    }
   }
   IF RE=5 THEN {
    AddAbilityLine J,-53,"Retort Specialist","Death Specialist";
    IF (SPELLSTATE(W,SDeathMastery)=2) THEN {
     AddAbilityLine J,-53,"Spell Death Mastery","Death Mastery";
    }
   }
  }

  IF Retort(W,Warlord) THEN { AddAbilityLine J,-53,"Retort Warlord","Warlord"; }
  IF Retort(W,Alchemist) THEN { AddAbilityLine J,-53,"Retort Alchemist","Alchemist"; }
  IF Retort(W,Tactician) THEN { AddAbilityLine J,-53,"Retort Tactician","Tactician"; }
  IF Retort(W,Benefactor) THEN { AddAbilityLine J,-53,"Retort Enchanter","Benefactor"; }
  IF Retort(W,Channeler) THEN { AddAbilityLine J,-53,"Retort Channeler","Channeler"; }
  IF Retort(W,Runemaster) THEN { AddAbilityLine J,-53,"Retort Runemaster","Runemaster"; }
  IF Retort(W,Conjurer) THEN { AddAbilityLine J,-53,"Retort Conjurer","Conjurer"; }
  IF Retort(W,Astrologer) THEN { AddAbilityLine J,-53,"Retort Astrologer","Astrologer"; }
  IF Retort(W,Enchanter) THEN { AddAbilityLine J,-53,"Retort Enchanter","Enchanter"; }
  IF (Retort(W,Guardian)) THEN {
   IF (W=D) THEN {
    IF (C>0) THEN {
     AddAbilityLine J,-53,"Retort Guardian","Guardian";
    } ELSE {
     IF (SPELLSTATE(W,SLordProtector)=2) THEN {
      AddAbilityLine J,-53,"Retort Guardian","Guardian";
      AddAbilityLine J,-53,"Spell Lord Protector","Lord Protector";
     }
    }
   }
   IF (W=A)
    %AND (C>0)
    %AND (CITYRACE(C)=HOMERACE(W))
    %AND (SPELLSTATE(W,SLordLiberator)=2)
   THEN {
    AddAbilityLine J,-53,"Retort Guardian","Guardian";
    AddAbilityLine J,-53,"Spell Lord Liberator","Lord Liberator";
   }
  }

 }

 IF W=NeutralplayerID THEN {
  IF (SCORINGOPTION(SKhanTheConqueror)=1) THEN {
   AddAbilityLine J,-53,"Retort Warlord","Warlord";
   AddAbilityLine J,-53,"Retort Tactician","Tactician";
  }
 }

NEXT J;

IF EventTurn(EvNatureC)>0 THEN {
 AddAbilityLine 3,38,"Nature Conjunction","Nature Conjunction";
}

IF EventTurn(EvChaosC)>0 THEN {
 AddAbilityLine 3,37,"Chaos Conjunction","Chaos Conjunction";
}

IF EventTurn(EvBadMoon)>0 THEN {
 AddAbilityLine 3,34,"Bad Moon","Bad Moon";
}

IF EventTurn(EvGoodMoon)>0 THEN {
 AddAbilityLine 3,35,"Good Moon","Good Moon";
}

IF (SCORINGOPTION(SUphillBattle)=1) THEN {
 AddAbilityLine 3,-53,"OPT UPHILL BATTLE","Uphill Battle";
}

IF (SCORINGOPTION(SGodsPlayDices)=1) THEN {
 AddAbilityLine 3,-53,"OPT GODS PLAY DICES","Gods Play Dices";
}

IF (ICEAGECOUNT=0) %AND (CLIMATE()<>CliFrozen) %AND ( (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTVolcano) %OR (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTChaosNode) ) THEN {
 AddAbilityLine 3,-339,"Volcanic Toxic Smog","Volcanic Toxic Smog";
}

IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTNatureNode) %AND (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)=0) THEN {
 AddAbilityLine 3,-340,"Fairy Maze","Fairy Maze";
}

IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP())=LTSorceryNode) %AND (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)=0) THEN {
 AddAbilityLine 3,-341,"Phantasmal Terrain","Phantasmal Terrain";
}

IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)>0) THEN {
 AddAbilityLine 3,-343,"Spell Corruption","Corruption";
}

OREONTILE=GETTERRAIN(combatX(),combatY(),combatP()+2);

IF (OREONTILE=0) THEN { GOTO "ENDOFORE"; }

 IF (OREONTILE=OreNightshade) THEN { AddAbilityLine 3,-322,"Combat Nightshade","Nightshade Field"; }
 IF (OREONTILE=OreAdamantium) THEN { AddAbilityLine 3,-323,"Combat Adamantium","Adamantium Ore Deposit"; }
 IF (OREONTILE=OreMithril) THEN { AddAbilityLine 3,-324,"Combat Mithril","Mithril Ore Deposit"; }
 IF (OREONTILE=OreOrihalcon) THEN { AddAbilityLine 3,-325,"Combat Orihalcon","Orihalcon Ore Deposit"; }
 IF (OREONTILE=OreIron) THEN { AddAbilityLine 3,-326,"Combat Iron","Iron Ore Deposit"; }
 IF (OREONTILE=OreCoal) THEN { AddAbilityLine 3,-327,"Combat Coal","Coal Deposit"; }
 IF (OREONTILE=OreCrysx) THEN { AddAbilityLine 3,-328,"Combat Crysx","Crysx Crystal Deposit"; }
 IF (OREONTILE=OreQuork) THEN { AddAbilityLine 3,-329,"Combat Quork","Quork Crystal Deposit"; }

!ENDOFORE!

DEBUGLOG "END OF Display Info: ";
HALT;