: Input, Output - None 
Use this script to process effects you want to be applied at the beginning of combat,
such as effects from global enchantments. :

A=ATTACKER();
D=DEFENDER();
C=CITYONTILE(COMBATP(),COMBATX(),COMBATY());
T=GETTERRAIN(COMBATX(),COMBATY(),COMBATP());
NODESUM=COMBATP()+COMBATX()+COMBATY();
TILESUM=COMBATP()+COMBATX()+COMBATY()+BASETURN();

DEBUGLOG "NODE SUM" + STRS(NODESUM);

: Node battle counter :
NODE=0;
IF (T=LTChaosNode)
 %OR (T=LTNatureNode)
 %OR (T=LTSorceryNode) 
THEN { NODE=1; }

DEBUGLOG "ENTER COMBAT, START SCRIPT";
DEBUGLOG "CITY ON TILE = " + STRS(C);
DEBUGLOG "NODE ON TILE = " + STRS(NODE);

MASTERVARSET COMBATTURN = 0;

IF (SCORINGOPTION(SStrategicCombat)=0) %AND ( (A=0) %OR (D=0) ) THEN { MASTERVARSET TACTICALCOMBAT = TACTICALCOMBAT + 1; }

: First turn active side, strategic combat would set to attack side for sake of sake of irresistible charge bonus :
IF (TACTICALCOMBAT>0) THEN { MASTERVARSET COMBATACTIVESIDE = 1; } ELSE { MASTERVARSET COMBATACTIVESIDE = 2; }

: Initiate sneak attack :
SA=0;

IF (RETORT(A,Tactician)=0) %AND ( (SCORINGOPTION(SKhanTheConqueror)=0) %OR (A<NeutralPlayerID) ) THEN { GOTO "NOSNEAKATTACK"; }

 SA=1;

 IF (RETORT(D,Tactician)>0)
  %OR ( (C>0) %AND (ISFORTRESS(C)) )
  %OR ( (D=NeutralPlayerID) %AND ( (SCORINGOPTION(SKhanTheConqueror)=1) %OR (NODE>0) ) )
 THEN {
  SA=0;
 }

!NOSNEAKATTACK!

IF (TACTICALCOMBAT=0) THEN { GOTO "NOTTACTICALCOMBAT"; }

 IF (T=LTHill) THEN { MASTERVARSET ROCKYHILLCOMBAT = ROCKYHILLCOMBAT + 1; }

 IF ( (T=LTVolcano) %OR (T=LTChaosNode) ) THEN {
  IF (ICEAGECOUNT=1)
   %OR (CLIMATE()=CliFrozen)
  THEN {
   MASTERVARSET GREENVOLCANOCOMBAT = GREENVOLCANOCOMBAT + 1;
  } ELSE {
   MASTERVARSET DEADLYVOLCANOCOMBAT = DEADLYVOLCANOCOMBAT + 1;
  }
 }

 IF (CLIMATE()<>CliDry) %AND (T=LTRiver) THEN { MASTERVARSET SWAMPYRIVERCOMBAT = SWAMPYRIVERCOMBAT + 1; }

 IF (CLIMATE()=CliWet) %AND (T=LTGrassland) THEN { MASTERVARSET WETGRASSLANDCOMBAT = WETGRASSLANDCOMBAT + 1; }
 IF (CLIMATE()=CliWet) %AND (T=LTForest) THEN { MASTERVARSET WETFORESTCOMBAT = WETFORESTCOMBAT + 1; }

 IF (ICEAGECOUNT=0) %AND (CLIMATE()<>CliFrozen) THEN { GOTO "NOFROSTMODIFY"; }

  IF (T<LTGrassland) THEN { MASTERVARSET ICYSEACOMBAT = ICYSEACOMBAT + 1; }
  IF (T=LTMountain) THEN { MASTERVARSET ICYMOUNTAINCOMBAT = ICYMOUNTAINCOMBAT + 1; }
  IF ( (T=LTForest) %OR (T=LTNatureNode) ) THEN { MASTERVARSET WINTERFOREST = WINTERFOREST + 1; }

 !NOFROSTMODIFY!

 IF (GETTERRAIN(COMBATX(),COMBATY(),COMBATP()+4)>0) THEN { MASTERVARSET CORRUPTTILECOMBAT = CORRUPTTILECOMBAT + 1; }

 IF (C=0) THEN { GOTO "NOTTACTICALSIEGE"; }
 
  IF (ISBUILT(C,BMoats)=1) THEN { MASTERVARSET MOATCOMBAT = MOATCOMBAT + 1; }
  IF (ISBUILT(C,BHillfort)=1) THEN { MASTERVARSET HILLFORTCOMBAT = HILLFORTCOMBAT + 1; }
  IF (ISBUILT(C,BBaray)=1) THEN { MASTERVARSET BARAYCOMBAT = BARAYCOMBAT + 1; }

 !NOTTACTICALSIEGE!

!NOTTACTICALCOMBAT!

IF (CLIMATE()<>CliWet) THEN { GOTO "NOWETMODIFY"; }
 IF (T>LTForest) %AND (T<LTRiverStart) THEN { GOTO "NOWETMODIFY"; }
  IF (C>0) THEN { GOTO "NOWETMODIFY"; }

   STORM=100 * %F( (OVERLANDTURN()+MAXUNIT()+MAXCITY()+COMBATP()+COMBATX()+COMBATY())/100 );
   DEBUGLOG "STORM VALUE = " + STRS(STORM);

   IF (T<LTGrassland) THEN {
    IF (STORM<20) THEN {
     SETCOMBATGLOBAL(D,CGHurricane,1,1);
     SETCOMBATGLOBAL(D,CGHurricane,2,1);
    }
    IF (STORM<4) THEN {
     SETCOMBATGLOBAL(D,CGCallLightning,1,1);
     SETCOMBATGLOBAL(D,CGCallLightning,2,1);
    }
   } ELSE {
    IF (STORM<10) THEN {
     SETCOMBATGLOBAL(D,CGHurricane,1,1);
     SETCOMBATGLOBAL(D,CGHurricane,2,1);
    }
    IF (STORM<2) THEN {
     SETCOMBATGLOBAL(D,CGCallLightning,1,1);
     SETCOMBATGLOBAL(D,CGCallLightning,2,1);
    }
   }

!NOWETMODIFY!

IF HASGLOBAL(A,GEIceAge) THEN { SETCOMBATGLOBAL(A,CGFreezingRain,1,1); }

IF HASGLOBAL(D,GEIceAge) THEN { SETCOMBATGLOBAL(D,CGFreezingRain,1,1); }

IF (C<1) THEN { GOTO "NOTSIEGE"; }
 IF (CITYOWNER(C)<>D) THEN { GOTO "NOTSIEGE"; }

  IF (CITYENCHANT(C,CEMagicPerimeter)>-1) THEN {
   SETCOMBATGLOBAL(D,CGCounterMagic,1,60);
  }
  IF (CITYENCHANT(C,CEChaosBless)>-1) THEN {
   SETCOMBATGLOBAL(D,CGWarpReality,1,1);
  }
  IF (CITYENCHANT(C,CENecropolis)>-1) THEN {
   SETCOMBATGLOBAL(D,CGGateOfHades,1,1);
  }
  IF ( (CITYENCHANT(C,CEPestilence)>-1)
   %OR ( (EVENTTURN(EvPlague)>0) %AND ((EVENTVAL(EvPlague))=C) ) )
  THEN {
   SETCOMBATGLOBAL(D,CGPLAGUE,1,1);
  }

  IF (ISBUILT(C,BLavaSmelter)=1) %AND (CITYENCHANT(C,CEWallofFire)<>CITYOWNER(C)) THEN {
   SETCITYENCHANTOWNER(C,CEWallofFire,CITYOWNER(C));
  }

  IF (ISBUILT(C,BAltarOfStorm)=1) THEN {
   SETCOMBATGLOBAL(D,CGCallLightning,1,1);
  }

  IF (ISBUILT(C,BAltarOfTheSun)=1) THEN {
   SETCOMBATGLOBAL(D,CGHighPrayer,1,1);
  }

  IF (ISBUILT(C,BBasilica)=1) THEN {
   SETCOMBATGLOBAL(D,CGTrueLight,1,1);
  }

!NOTSIEGE!

: Effect of Nodeborne Soul scoring option on combat enchantment :
IF (SCORINGOPTION(SNodeborneSouls)=0) THEN { GOTO "NODEISSOULESS"; }
 IF (NODE=0) %OR (D<NeutralPlayerID) THEN { GOTO "NODEISSOULESS"; }

  IF (T<>LTChaosNode) THEN { GOTO "NOTSOULCHAOSNODE"; }

   CG=%R( 3 * %F( NODESUM/3 ) );
   IF (CG=0) THEN {
    SETCOMBATGLOBAL(D,CGBreakthrough,1,1);
    GOTO "NODEISSOULESS";
   }
   IF (CG=1) THEN {
    SETCOMBATGLOBAL(D,CGBlazingMarch,1,1);
    GOTO "NODEISSOULESS";
   }
   IF (CG=2) THEN {
    SETCOMBATGLOBAL(D,CGWarpReality,1,1);
    GOTO "NODEISSOULESS";
   }
   GOTO "NODEISSOULESS";

!NOTSOULCHAOSNODE!

  IF (T<>LTNatureNode) THEN { GOTO "NOTSOULNATURENODE"; }

   CG=%R( 2 * %F( NODESUM/2 ) );
   IF (CG=0) THEN {
    SETCOMBATGLOBAL(D,CGFreezingRain,1,1);
    GOTO "NODEISSOULESS";
   }
   IF (CG=1) THEN {
    SETCOMBATGLOBAL(D,CGHurricane,1,1);
    GOTO "NODEISSOULESS";
   }
   GOTO "NODEISSOULESS";

!NOTSOULNATURENODE!

  IF (T<>LTSorceryNode) THEN { GOTO "NOTSOULSORCERYNODE"; }

   CG=%R( 3 * %F( NODESUM/3 ) );
   IF (CG=0) THEN {
    SETCOMBATGLOBAL(D,CGBlur,1,1);
    GOTO "NODEISSOULESS";
   }
   IF (CG=1) THEN {
    SETCOMBATGLOBAL(D,CGAetherSurge,1,1);
    GOTO "NODEISSOULESS";
   }
   IF (CG=2) THEN {
    SETCOMBATGLOBAL(D,CGTemporalTwist,1,1);
    GOTO "NODEISSOULESS";
   }
   GOTO "NODEISSOULESS";

!NOTSOULSORCERYNODE!

!NODEISSOULESS!

: check last unit owner :
NEUTRALUNITINSTACK=0;

: Check stack :
FOR N=1 TO NOFUNITSONTILE(COMBATP(),COMBATX(),COMBATY());

 U=UNITONTILE(COMBATP(),COMBATX(),COMBATY(),N);
 W=GETSTAT(U,SOwner,0);
 OPPONENT=( ATTACKER() + DEFENDER() ) - W;

 IF (W=NeutralPlayerID) THEN { NEUTRALUNITINSTACK=NEUTRALUNITINSTACK+1; }

 DEBUGLOG "UNIT ID " + STRS(U);

 SetCombatEnchantmentFlag(U,EncInCombat,1,1);

 : Effect of score option "Gods Play Dices" roll resistance debuff at the beginning of battle for attacker :
 IF (SCORINGOPTION(SGodsPlayDices)=0) THEN { GOTO "GODSARENOTGAMBLERS"; }

  DICE=%I(100*%F(TILESUM*U/100));
  IF (DICE>89) THEN {
   SETCOMBATENCHANTMENTFLAG(U,EncDICE4,1,1);
   GOTO "GODSARENOTGAMBLERS";
  }
  IF (DICE>69) %AND (DICE<90) THEN {
   SETCOMBATENCHANTMENTFLAG(U,EncDICE3,1,1);
   GOTO "GODSARENOTGAMBLERS";
  }
  IF (DICE<11) THEN {
   SETCOMBATENCHANTMENTFLAG(U,EncDICE2,1,1);
   GOTO "GODSARENOTGAMBLERS";
  }
  IF (DICE>10) %AND (DICE<31) THEN {
   SETCOMBATENCHANTMENTFLAG(U,EncDICE1,1,1);
   GOTO "GODSARENOTGAMBLERS";
  }

 !GODSARENOTGAMBLERS!

 : Tactical combat only effect first turn :
 IF (TACTICALCOMBAT=0) THEN { GOTO "NOTTACTICALFIRSTTURN"; }

  IF (GetStat(U,SRechargeCounter,0)=0)
   %AND (GetStat(U,SSpellRecharge,0)>0)
  THEN {
   SETSTAT(U,SRechargeCounter,1,GetStat(U,SSpellRecharge,0));
  }

 !NOTTACTICALFIRSTTURN!

 : Effect of Great Unbinding :
 IF (HASGLOBAL(OPPONENT,GEGreatUnbinding)=0) THEN { GOTO "NOGREATUNBINDING"; }

  IF (FANTASTIC(U)=0) THEN { GOTO "NOGREATUNBINDING"; }
  IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "NOGREATUNBINDING"; }
 
   CONFUSE=4+%I(10*%F(TILESUM*U/10));
   RE=GETSTAT(U,SResist,0);
   IF (GETENCHANTMENTFLAG(U,EncResistMagic,0)>0) THEN { RE=RE+5; }

   IF (RE<CONFUSE) THEN {
    SETCOMBATENCHANTMENTFLAG(U,EncConfusion,1,1);
   }

 !NOGREATUNBINDING!

 : Strategic combat only effect :
 IF (TACTICALCOMBAT>0) THEN { GOTO "NOTSTRATEGICCOMBAT"; }

  : Strategic combat effect of Death Reckoning, roll effect 4 times at start of combat for defender :
  IF (HASGLOBAL(OPPONENT,GEDeathReckoning)=0) THEN { GOTO "NODEATHRECKONING"; }

   IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "IMMUNEDEBUFFRECKONING"; }

    IF (ISHERO(U)) %OR (BASEFANTASTIC(U)=0) THEN {
     IF ( ( %I( 100*%F( (TILESUM+U)/100 ) ) ) < 13 ) THEN {
      SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
      GOTO "NODEATHRECKONING";
     } ELSE {
      IF ( ( %I( 100*%F( (TILESUM-U)/100 ) ) ) < 13 ) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
       GOTO "NODEATHRECKONING";
      } ELSE {
       IF ( ( %I( 100*%F( (TILESUM*U)/100 ) ) ) < 13 ) THEN {
        SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
        GOTO "NODEATHRECKONING";
       } ELSE {
        IF ( ( %I( 100*%F( (TILESUM/U)/100 ) ) ) < 13 ) THEN {
         SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
         GOTO "NODEATHRECKONING";
        }
       }
      }
     }
    } ELSE {
     IF ( ( %I( 100*%F( (TILESUM+U)/100 ) ) ) < 13 ) THEN {
      SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
      GOTO "NODEATHRECKONING";
     } ELSE {
      IF ( ( %I( 100*%F( (TILESUM-U)/100 ) ) ) < 13 ) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
       GOTO "NODEATHRECKONING";
      } ELSE {
       IF ( ( %I( 100*%F( (TILESUM*U)/100 ) ) ) < 13 ) THEN {
        SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
        GOTO "NODEATHRECKONING";
       } ELSE {
        IF ( ( %I( 100*%F( (TILESUM/U)/100 ) ) ) < 13 ) THEN {
         SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
         GOTO "NODEATHRECKONING";
        }
       }
      }
     }
    }

   !IMMUNEDEBUFFRECKONING!

  !NODEATHRECKONING!

 !NOTSTRATEGICCOMBAT!

 IF (W<>D) THEN { GOTO "NOTDEFENDERONLY"; }


  : These ability prevent sneak attack :
  IF (GETSTAT(U,SCreatePower,1)>10) THEN { SA=0; }
  IF (GETENCHANTMENTFLAG(U,EncDestiny,0)>0) THEN { SA=0; }

  : ability here only effect defender :
  IF (HASGLOBAL(A,GETimeStop)=0) THEN { GOTO "NOTIMESTOP"; }

   STOP=7+%I(10*%F(TILESUM*U/10));
   RE=GETSTAT(U,SResist,0);
   IF (GETENCHANTMENTFLAG(U,EncResistMagic,0)>0) THEN { RE=RE+5; }

   IF (RE<STOP) THEN {
    SETCOMBATENCHANTMENTFLAG(U,EncStasisCombat,1,1);
   }

  !NOTIMESTOP!

  IF (C=0) THEN { GOTO "NOTCITYDEFEND"; }

   IF (ISBUILT(C,BCityWalls)=0) THEN { GOTO "NOTMANTHEWALL"; }

    : Defenders without other Spell Charges can destroy their City Walls with Disrupt to run away :
    IF (GETSTAT(U,SSpellCharges,0)=0) THEN {
     SETSTAT(U,SSpellAbility,1,82);
     SETSTAT(U,SSpellCharges,0,1);
    }

   !NOTMANTHEWALL!

  !NOTCITYDEFEND!

  GOTO "ENDOFUNIT";

 !NOTDEFENDERONLY!

  IF (C=0) THEN { GOTO "NOTCITYATTACK"; }

   IF (ISBUILT(C,BWitchesConvent)=0) THEN { GOTO "NOTCURSEDBYWITCH"; }
    IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "NOTCURSEDBYWITCH"; }

     : Attacker get random curse at chance 1/4 :
     LUCK=%I((100/4)*%F(TILESUM*U/100));
     IF (LUCK>5) THEN { GOTO "NOTCURSEDBYWITCH"; }

     IF (LUCK=5) THEN {
      IF ( (GETSTAT(U,AIllusionImmunity,0)=0) %OR (GETSTAT(U,ADeathImmunity,0)=0) ) THEN {
       SETCOMBATENCHANTMENTFLAG (U,EncMisfortune,1,1);
      }
      GOTO "NOTCURSEDBYWITCH";
     }
     IF (LUCK=4) THEN {
      IF (GETSTAT(U,AIllusionImmunity,0)=0) THEN {
       SETCOMBATENCHANTMENTFLAG (U,EncVertigo,1,1);
      }
      GOTO "NOTCURSEDBYWITCH";
     }
     IF (LUCK=3) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncWeakness,1,1);
      GOTO "NOTCURSEDBYWITCH";
     }
     IF (LUCK=2) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncWarpResist,1,1);
      GOTO "NOTCURSEDBYWITCH";
     }
     IF (LUCK=1) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncWarpDefense,1,1);
      GOTO "NOTCURSEDBYWITCH";
     }
     : In case Luck = 0 :
     SETCOMBATENCHANTMENTFLAG (U,EncWarpAttack,1,1);

   !NOTCURSEDBYWITCH!

   IF (ISBUILT(C,BAltarOfTheMoon)=0) THEN { GOTO "NOTCURSEDBYMOON"; }

    : Attacker get random curse at chance 1/4 :
    LUCK=%I((100/8)*%F(TILESUM*U/100));
    IF (LUCK>5) THEN { GOTO "NOTCURSEDBYMOON"; }

    IF (LUCK=5) THEN {
     IF (ISHERO(U)=0) THEN {
      IF FANTASTIC(U) THEN {
       SETCOMBATENCHANTMENTFLAG (U,EncCreatureBinding,1,1);
      } ELSE {
       SETCOMBATENCHANTMENTFLAG (U,EncPossession,1,1);
      }
     }
     GOTO "NOTCURSEDBYMOON";
    }
    IF (LUCK=4) THEN {
     IF FANTASTIC(U) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncHierophany,1,1);
     } ELSE {
      SETCOMBATENCHANTMENTFLAG (U,EncSoulFlay,1,1);
     }
     GOTO "NOTCURSEDBYMOON";
    }
    IF (LUCK=3) THEN {
     IF (GETSTAT(U,ADeathImmunity,0)=0) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncBlackSleep,1,1);
     }
     GOTO "NOTCURSEDBYMOON";
    }
    IF (LUCK=2) THEN {
     IF (GETSTAT(U,AIllusionImmunity,0)=0) THEN {
      SETCOMBATENCHANTMENTFLAG (U,EncMindStorm,1,1);
     }
     GOTO "NOTCURSEDBYMOON";
    }
    IF (LUCK=1) THEN {
     SETCOMBATENCHANTMENTFLAG (U,EncShatter,1,1);
     GOTO "NOTCURSEDBYMOON";
    }
    : In case Luck = 0 :
    SETCOMBATENCHANTMENTFLAG (U,EncStasisCombat,1,1);

   !NOTCURSEDBYMOON!

  !NOTCITYATTACK!

 !ENDOFUNIT!

NEXT N;

IF (D<NeutralPlayerID) THEN { GOTO "NONEUTRALREAPPLY"; }

 IF (NEUTRALUNITINSTACK>0) THEN { GOTO "NONEUTRALREAPPLY"; }

  FOR U=1 TO MAXUNIT();

   W=GETSTAT(U,SOwner,0);

   IF (INCOMBAT(U)=0) THEN { GOTO "NOTNEUTRALLAIR"; }

    IF ( W < NeutralPlayerID ) THEN { GOTO "NOTNEUTRALLAIR"; }

     SetCombatEnchantmentFlag(U,EncInCombat,1,1);

     : Effect of "Cosmic Chessboard" scoring option on units for defender :
     IF (SCORINGOPTION(SCosmicChessboard)=0) THEN { GOTO "GODABANDONLAIR"; }

      CG=%I((100/7)*%F(TILESUM*U/100));
      BUFF=%I((100/25)*%F(TILESUM*U/100));

      IF (GETSTAT(U,SRace,0)=19) THEN {
       IF (CG=1) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGTrueLight,1,1); }
       IF (CG=2) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGEyeOfHeaven,1,1); }
       IF (CG=7) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGPrayer,1,1); }

       IF (BUFF=0) THEN { SETCOMBATENCHANTMENTFLAG(U,EncEndurance,1,1); }
       IF (BUFF=1) THEN { SETCOMBATENCHANTMENTFLAG(U,EncBless,1,1); }
       IF (BUFF=2) THEN { SETCOMBATENCHANTMENTFLAG(U,EncZeal,1,1); }
       IF (BUFF=3) THEN { SETCOMBATENCHANTMENTFLAG(U,EncDivineProtection,1,1); }

       GOTO "GODABANDONLAIR";
      }

      IF (GETSTAT(U,SRace,0)=20) THEN {
       IF (CG=0) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGDarkness,1,1); }
       IF (CG=9) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGManaLeak,1,1); }
       IF (CG=13) THEN { SETCOMBATGLOBAL( NeutralPlayerID,CGBlackPrayer,1,1); }

       IF (BUFF=0) THEN { SETCOMBATENCHANTMENTFLAG(U,EncCloakofFear,1,1); }
       IF (BUFF=1) THEN { SETCOMBATENCHANTMENTFLAG(U,EncWraithForm,1,1); }
       IF (BUFF=2) THEN { SETCOMBATENCHANTMENTFLAG(U,EncFrenzy,1,1); }
       IF (BUFF=3) THEN { SETCOMBATENCHANTMENTFLAG(U,EncShadowStrike,1,1); }

       GOTO "GODABANDONLAIR";
      }

     !GODABANDONLAIR!

     IF (SCORINGOPTION(SNodeborneSouls)=0) THEN { GOTO "NOTNEUTRALNODEDEFEND"; }
      IF (T<>LTChaosNode) %AND (T<>LTNatureNode) %AND (T<>LTSorceryNode) THEN { GOTO "NOTNEUTRALNODEDEFEND"; }

       BUFF=%I((100/25)*%F(NODESUM*U/100));

       IF (T=LTChaosNode) THEN {
        IF (BUFF=0) THEN { SETCOMBATENCHANTMENTFLAG(U,EncImmolation,1,1); }
        IF (BUFF=1) THEN { SETCOMBATENCHANTMENTFLAG(U,EncInsulation,1,1); }
        IF (BUFF=2) THEN { SETCOMBATENCHANTMENTFLAG(U,EncBerserk,1,1); }
        IF (BUFF=3) THEN { SETCOMBATENCHANTMENTFLAG(U,EncFieryFury,1,1); }
        GOTO "NOTNEUTRALNODEDEFEND";
       }

       IF (T=LTNatureNode) THEN {
        IF (BUFF=0) THEN { SETCOMBATENCHANTMENTFLAG(U,EncResistElements,1,1); }
        IF (BUFF=1) THEN { SETCOMBATENCHANTMENTFLAG(U,EncLandLink,1,1); }
        IF (BUFF=2) THEN { SETCOMBATENCHANTMENTFLAG(U,EncVenom,1,1); }
        IF (BUFF=3) THEN { SETCOMBATENCHANTMENTFLAG(U,EncColossalStrength,1,1); }
        GOTO "NOTNEUTRALNODEDEFEND";
       }

       IF (T=LTSorceryNode) THEN {
        IF (BUFF=0) THEN { SETCOMBATENCHANTMENTFLAG(U,EncResistMagic,1,1); }
        IF (BUFF=1) THEN { SETCOMBATENCHANTMENTFLAG(U,EncGuardianWind,1,1); }
        IF (BUFF=2) THEN { SETCOMBATENCHANTMENTFLAG(U,EncFocusMagic,1,1); }
        IF (BUFF=3) THEN { SETCOMBATENCHANTMENTFLAG(U,EncSpellLock,1,1); }
        GOTO "NOTNEUTRALNODEDEFEND";
       }

     !NOTNEUTRALNODEDEFEND!

     : Effect of score option "Gods Play Dices" roll resistance debuff at the beginning of battle for attacker :
     IF (SCORINGOPTION(SGodsPlayDices)=0) THEN { GOTO "GODSARENOTGAMBLERSLAIR"; }

      DICE=%I(100*%F(TILESUM*U/100));
      IF (DICE>89) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncDICE4,1,1);
       GOTO "GODSARENOTGAMBLERSLAIR";
      }
      IF (DICE>69) %AND (DICE<90) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncDICE3,1,1);
       GOTO "GODSARENOTGAMBLERSLAIR";
      }
      IF (DICE<11) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncDICE2,1,1);
       GOTO "GODSARENOTGAMBLERSLAIR";
      }
      IF (DICE>10) %AND (DICE<31) THEN {
       SETCOMBATENCHANTMENTFLAG(U,EncDICE1,1,1);
       GOTO "GODSARENOTGAMBLERSLAIR";
      }

     !GODSARENOTGAMBLERSLAIR!

     : Effect of Great Unbinding in lair :
     IF (HASGLOBAL(A,GEGreatUnbinding)=0) THEN { GOTO "NOGREATUNBINDINGLAIR"; }

      IF (FANTASTIC(U)=0) THEN { GOTO "NOGREATUNBINDING"; }
      IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "NOGREATUNBINDINGLAIR"; }
 
       CONFUSE=4+%I(10*%F(TILESUM*U/10));
       RE=GETSTAT(U,SResist,0);
       IF (GETENCHANTMENTFLAG(U,EncResistMagic,0)>0) THEN { RE=RE+5; }

       IF (RE<CONFUSE) THEN {
        SETCOMBATENCHANTMENTFLAG(U,EncConfusion,1,1);
       }

     !NOGREATUNBINDINGLAIR!

     : Strategic combat only effect for Lair :
     IF (TACTICALCOMBAT>0) THEN { GOTO "NOTSTRATEGICCOMBATLAIR"; }

      : Strategic combat effect of Death Reckoning, roll effect 4 times at start of combat for defender :
      IF (HASGLOBAL(OPPONENT,GEDeathReckoning)=0) THEN { GOTO "NODEATHRECKONINGLAIR"; }

       IF (GETSTAT(U,AMagicImmunity,0)>0) THEN { GOTO "IMMUNEDEBUFFRECKONINGLAIR"; }

        IF (ISHERO(U)) %OR (BASEFANTASTIC(U)=0) THEN {
         IF ( ( %I( 100*%F( (TILESUM+U)/100 ) ) ) < 13 ) THEN {
          SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
          GOTO "NODEATHRECKONINGLAIR";
         } ELSE {
          IF ( ( %I( 100*%F( (TILESUM-U)/100 ) ) ) < 13 ) THEN {
           SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
           GOTO "NODEATHRECKONINGLAIR";
          } ELSE {
           IF ( ( %I( 100*%F( (TILESUM*U)/100 ) ) ) < 13 ) THEN {
            SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
            GOTO "NODEATHRECKONINGLAIR";
           } ELSE {
            IF ( ( %I( 100*%F( (TILESUM/U)/100 ) ) ) < 13 ) THEN {
             SETCOMBATENCHANTMENTFLAG(U,EncSoulFlay,1,1);
             GOTO "NODEATHRECKONINGLAIR";
            }
           }
          }
         }
        } ELSE {
         IF ( ( %I( 100*%F( (TILESUM+U)/100 ) ) ) < 13 ) THEN {
          SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
          GOTO "NODEATHRECKONINGLAIR";
         } ELSE {
          IF ( ( %I( 100*%F( (TILESUM-U)/100 ) ) ) < 13 ) THEN {
           SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
           GOTO "NODEATHRECKONINGLAIR";
          } ELSE {
           IF ( ( %I( 100*%F( (TILESUM*U)/100 ) ) ) < 13 ) THEN {
            SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
            GOTO "NODEATHRECKONINGLAIR";
           } ELSE {
            IF ( ( %I( 100*%F( (TILESUM/U)/100 ) ) ) < 13 ) THEN {
             SETCOMBATENCHANTMENTFLAG(U,EncWeakness,1,1);
             GOTO "NODEATHRECKONINGLAIR";
            }
           }
          }
         }
        }

       !IMMUNEDEBUFFRECKONINGLAIR!

      !NODEATHRECKONINGLAIR!

     !NOTSTRATEGICCOMBATLAIR!

     : Tactical combat only effect first turn :
     IF (TACTICALCOMBAT=0) THEN { GOTO "NOTTACTICALFIRSTTURNLAIR"; }

      IF (GetStat(U,SRechargeCounter,0)=0)
       %AND (GetStat(U,SSpellRecharge,0)>0)
      THEN {
       SETSTAT(U,SRechargeCounter,1,GetStat(U,SSpellRecharge,0));
      }

     !NOTTACTICALFIRSTTURNLAIR!

   !NOTNEUTRALLAIR!

  NEXT U;

!NONEUTRALREAPPLY!

: Process Variables :
IF (SA=0) THEN {
 MASTERVARSET SNEAKATTACK = 0;
} ELSE {
 MASTERVARSET SNEAKATTACK = 1;
}

DEBUGLOG "END OF ENTER COMBAT SCRIPT";
