  IF (PERSONALITY(W)=Maniacal) %OR (PERSONALITY(W)=Ruthless) THEN {
   AddAISpell(W,SDoomsday);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Doomsday = "+STRS(WasSSpicked(W,SDoomsday));
  } ELSE {
   IF RND(2)=1 THEN {
    AddAISpell(W,SApocalypse);
    DEBUGLOG "AI "+STRS(W)+" picks Spell Apocalypse = "+STRS(WasSSpicked(W,SApocalypse));
   } ELSE {
    AddAISpell(W,SChainLightning);
    DEBUGLOG "AI "+STRS(W)+" picks Spell Chain Lightning = "+STRS(WasSSpicked(W,SChainLightning));
   }
  }
 } ELSE {
  IF (PERSONALITY(W)=Maniacal) %OR (PERSONALITY(W)=Ruthless) THEN {
