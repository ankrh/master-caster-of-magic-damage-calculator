:While this script is running, the variable, W, contains the wizard ID for the active AI player.:

PICKCNATURE=99;
PICKUNATURE=99;
PICKRNATURE=99;
PICKCSORCERY=99;
PICKUSORCERY=99;
PICKRSORCERY=99;
PICKCCHAOS=99;
PICKUCHAOS=99;
PICKRCHAOS=99;
PICKCLIFE=99;
PICKULIFE=99;
PICKRLIFE=99;
PICKCDEATH=99;
PICKUDEATH=99;
PICKRDEATH=99;

IF (SCORINGOPTION(SQueSeraSera)=0) THEN { GOTO "STARTPICKING"; }

 IF BOOKS(W,Nature)>2 THEN {
  PICKCNATURE=0;
  PICKUNATURE=0;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=2 THEN {
  PICKCNATURE=1;
  PICKUNATURE=0;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=3 THEN {
  PICKCNATURE=2;
  PICKUNATURE=0;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=4 THEN {
  PICKCNATURE=3;
  PICKUNATURE=0;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=5 THEN {
  PICKCNATURE=4;
  PICKUNATURE=1;
  PICKRNATURE=0;
 }
 IF (BOOKS(W,Nature)>5) %AND (BOOKS(W,Nature)<9) THEN {
  PICKCNATURE=5;
  PICKUNATURE=2;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=9 THEN {
  PICKCNATURE=6;
  PICKUNATURE=2;
  PICKRNATURE=0;
 }
 IF BOOKS(W,Nature)=10 THEN {
  PICKCNATURE=7;
  PICKUNATURE=2;
  PICKRNATURE=2;
 }

 IF BOOKS(W,Sorcery)>2 THEN {
  PICKCSORCERY=0;
  PICKUSORCERY=0;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=2 THEN {
  PICKCSORCERY=1;
  PICKUSORCERY=0;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=3 THEN {
  PICKCSORCERY=2;
  PICKUSORCERY=0;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=4 THEN {
  PICKCSORCERY=3;
  PICKUSORCERY=0;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=5 THEN {
  PICKCSORCERY=4;
  PICKUSORCERY=1;
  PICKRSORCERY=0;
 }
 IF (BOOKS(W,Sorcery)>5) %AND (BOOKS(W,Sorcery)<9) THEN {
  PICKCSORCERY=5;
  PICKUSORCERY=2;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=9 THEN {
  PICKCSORCERY=6;
  PICKUSORCERY=2;
  PICKRSORCERY=0;
 }
 IF BOOKS(W,Sorcery)=10 THEN {
  PICKCSORCERY=7;
  PICKUSORCERY=2;
  PICKRSORCERY=2;
 }

 IF BOOKS(W,Chaos)>2 THEN {
  PICKCCHAOS=0;
  PICKUCHAOS=0;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=2 THEN {
  PICKCCHAOS=1;
  PICKUCHAOS=0;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=3 THEN {
  PICKCCHAOS=2;
  PICKUCHAOS=0;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=4 THEN {
  PICKCCHAOS=3;
  PICKUCHAOS=0;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=5 THEN {
  PICKCCHAOS=4;
  PICKUCHAOS=1;
  PICKRCHAOS=0;
 }
 IF (BOOKS(W,Chaos)>5) %AND (BOOKS(W,Chaos)<9) THEN {
  PICKCCHAOS=5;
  PICKUCHAOS=2;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=9 THEN {
  PICKCCHAOS=6;
  PICKUCHAOS=2;
  PICKRCHAOS=0;
 }
 IF BOOKS(W,Chaos)=10 THEN {
  PICKCCHAOS=7;
  PICKUCHAOS=2;
  PICKRCHAOS=2;
 }

 IF BOOKS(W,Life)>2 THEN {
  PICKCLIFE=0;
  PICKULIFE=0;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=2 THEN {
  PICKCLIFE=1;
  PICKULIFE=0;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=3 THEN {
  PICKCLIFE=2;
  PICKULIFE=0;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=4 THEN {
  PICKCLIFE=3;
  PICKULIFE=0;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=5 THEN {
  PICKCLIFE=4;
  PICKULIFE=1;
  PICKRLIFE=0;
 }
 IF (BOOKS(W,Life)>5) %AND (BOOKS(W,Life)<9) THEN {
  PICKCLIFE=5;
  PICKULIFE=2;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=9 THEN {
  PICKCLIFE=6;
  PICKULIFE=2;
  PICKRLIFE=0;
 }
 IF BOOKS(W,Life)=10 THEN {
  PICKCLIFE=7;
  PICKULIFE=2;
  PICKRLIFE=2;
 }

 IF BOOKS(W,Death)>2 THEN {
  PICKCDEATH=0;
  PICKUDEATH=0;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=2 THEN {
  PICKCDEATH=1;
  PICKUDEATH=0;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=3 THEN {
  PICKCDEATH=2;
  PICKUDEATH=0;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=4 THEN {
  PICKCDEATH=3;
  PICKUDEATH=0;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=5 THEN {
  PICKCDEATH=4;
  PICKUDEATH=1;
  PICKRDEATH=0;
 }
 IF (BOOKS(W,Death)>5) %AND (BOOKS(W,Death)<9) THEN {
  PICKCDEATH=5;
  PICKUDEATH=2;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=9 THEN {
  PICKCDEATH=6;
  PICKUDEATH=2;
  PICKRDEATH=0;
 }
 IF BOOKS(W,Death)=10 THEN {
  PICKCDEATH=7;
  PICKUDEATH=2;
  PICKRDEATH=2;
 }

!STARTPICKING!

DEBUGLOG "AI "+STRS(W)+" NATURE = "+STRS(BOOKS(W,Nature));
DEBUGLOG "AI "+STRS(W)+" SORCERY = "+STRS(BOOKS(W,Sorcery));
DEBUGLOG "AI "+STRS(W)+" CHAOS = "+STRS(BOOKS(W,Chaos));
DEBUGLOG "AI "+STRS(W)+" LIFE = "+STRS(BOOKS(W,Life));
DEBUGLOG "AI "+STRS(W)+" DEATH = "+STRS(BOOKS(W,Death));

:
=============
COMMON SPELLS
=============
:
IF BOOKS(W,Death)>0 THEN {
 IF (BOOKS(W,Nature)<4) %AND (PICKCDEATH>0) THEN {
  AddAISpell(W,SGhouls);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Ghouls = "+STRS(WasSSpicked(W,SGhouls));
  PICKCDEATH=PICKCDEATH-1;
 }
 IF (PICKCDEATH>0) THEN {
  AddAISpell(W,SWraithForm);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Wraith Form = "+STRS(WasSSpicked(W,SWraithForm));
  PICKCDEATH=PICKCDEATH-1;
 }
 IF (PICKCDEATH>0) THEN {
  AddAISpell(W,SBlackSleep);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Black Sleep = "+STRS(WasSSpicked(W,SBlackSleep));
  PICKCDEATH=PICKCDEATH-1;
 }
 IF (PICKCDEATH>0) THEN {
  AddAISpell(W,SZombies);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Zombies = "+STRS(WasSSpicked(W,SZombies));
  PICKCDEATH=PICKCDEATH-1;
 }
 IF (PICKCDEATH>0) THEN {
  IF BOOKS(W,Nature)<4 THEN {
   AddAISpell(W,SDarkness);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Darkness = "+STRS(WasSSpicked(W,SDarkness));
  } ELSE {
   AddAISpell(W,SMislead);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Liability = "+STRS(WasSSpicked(W,SMislead));
  }
  PICKCDEATH=PICKCDEATH-1;
 }
}
IF BOOKS(W,Nature)>0 THEN {
 IF (MINERALS()=MineralRich) %AND (PICKCNATURE>0) THEN {
  AddAISpell(W,SNaturalSelection);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Natural Selection = "+STRS(WasSSpicked(W,SNaturalSelection));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF ( (WasSSpicked(w,SGhouls)=0) %OR SCORINGOPTION(STreasureImpact) )
  %AND (PICKCNATURE>0)
 THEN {
  AddAISpell(W,SKillerWasps);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Killer Wasps = "+STRS(WasSSpicked(W,SKillerWasps));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (WasSSpicked(w,SWraithForm)=0) %AND (PICKCNATURE>0) THEN {
  AddAISpell(W,SWaterWalking);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Water Walking = "+STRS(WasSSpicked(W,SWaterWalking));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (PICKCNATURE>0) THEN {
  AddAISpell(W,SWarBears);
  DEBUGLOG "AI "+STRS(W)+" picks Spell War Bears = "+STRS(WasSSpicked(W,SWarBears));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (PICKCNATURE>0) THEN {
  AddAISpell(W,SWeb);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Web = "+STRS(WasSSpicked(W,SWeb));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF ( (BOOKS(W,Sorcery)>4) %OR (BOOKS(W,Chaos)>4) ) %AND (PICKCNATURE>0) THEN {
  AddAISpell(W,SNaturesEye);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Nature Witness = "+STRS(WasSSpicked(W,SNaturesEye));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (PICKCNATURE>0) THEN {
  AddAISpell(W,SWildBoars);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Wild Boars = "+STRS(WasSSpicked(W,SWildBoars));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (PICKCNATURE>0) THEN {
  AddAISpell(W,SEarthToMud);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Earth to Mud = "+STRS(WasSSpicked(W,SEarthToMud));
  PICKCNATURE=PICKCNATURE-1;
 }
 IF (PICKCNATURE>0) THEN {
  AddAISpell(W,SResistElements);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Resist Elements = "+STRS(WasSSpicked(W,SResistElements));
  PICKCNATURE=PICKCNATURE-1;
 }
}
IF (BOOKS(W,Chaos)>0) %AND (PICKCCHAOS>0) THEN {
 AddAISpell(W,SFireBolt);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Fire Bolt = "+STRS(WasSSpicked(W,SFireBolt));
 PICKCCHAOS=PICKCCHAOS-1;
}
IF BOOKS(W,Death)>0 THEN {
 IF (WasSSpicked(W,SFireBolt)=0) %AND (PICKCDEATH>0) THEN {
  AddAISpell(W,SLifeDrain);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Life Drain = "+STRS(WasSSpicked(W,SLifeDrain));
  PICKCDEATH=PICKCDEATH-1;
 }
 IF (PICKCDEATH>0) THEN {
  AddAISpell(W,SWeakness);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Weakness = "+STRS(WasSSpicked(W,SWeakness));
  PICKCDEATH=PICKCDEATH-1;
 }
}
IF BOOKS(W,Chaos)>0 THEN {
 IF (WasSSpicked(w,SWarBears)=0) %AND (WasSSpicked(w,SGhouls)=0) %AND (PICKCCHAOS>0) THEN {
  AddAISpell(W,SHellHounds);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Hell Hounds = "+STRS(WasSSpicked(W,SHellHounds));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF (WasSSpicked(w,SZombies)=0) %AND (PICKCCHAOS>0) THEN {
  AddAISpell(W,SFireElemental);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Fire Elemental = "+STRS(WasSSpicked(W,SFireElemental));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF ((BOOKS(W,Sorcery)+BOOKS(W,Death))>3) %AND (PICKCCHAOS>0) THEN {
  AddAISpell(W,SBreakthrough);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Breakthrough = "+STRS(WasSSpicked(W,SBreakthrough));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF (PICKCCHAOS>0) THEN {
  IF (PERSONALITY(W)<>Peaceful) %AND (PERSONALITY(W)<>Lawful) THEN {
   AddAISpell(W,SCorruption);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Corruption = "+STRS(WasSSpicked(W,SCorruption));
  } ELSE {
   AddAISpell(W,SWallofFire);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Wall of Fire = "+STRS(WasSSpicked(W,SWallofFire));
  }
  PICKCCHAOS=PICKCCHAOS-1;
 }
}
IF (BOOKS(W,Sorcery)>0) %AND (PICKCSORCERY>0) THEN {
 AddAISpell(W,SConfusion);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Confusion = "+STRS(WasSSpicked(W,SConfusion));
 PICKCSORCERY=PICKCSORCERY-1;
}
IF BOOKS(W,Chaos)>0 THEN {
 IF (WasSSpicked(w,SBlackSleep)=0) %AND (WasSSpicked(w,SConfusion)=0) %AND (PICKCCHAOS>0) THEN {
  AddAISpell(w,SRust);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Rust = "+STRS(WasSSpicked(W,SRust));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF (PICKCCHAOS>0) THEN {
  AddAISpell(W,SAnimateAmmo);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Animate Ammo = "+STRS(WasSSpicked(W,SAnimateAmmo));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF (PICKCCHAOS>0) THEN {
  AddAISpell(W,SFieryFury);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Fiery Fury = "+STRS(WasSSpicked(W,SFieryFury));
  PICKCCHAOS=PICKCCHAOS-1;
 }
 IF (PICKCCHAOS>0) THEN {
  AddAISpell(W,SWarpCreature);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Warp Creature = "+STRS(WasSSpicked(W,SWarpCreature));
  PICKCCHAOS=PICKCCHAOS-1;
 }
}
IF BOOKS(W,Sorcery)>0 THEN {
 IF (WasSSpicked(w,SWaterWalking)=0) %AND (WasSSpicked(w,SWraithForm)=0) %AND (PICKCSORCERY>0) THEN {
  AddAISpell(W,SFloatingIsland);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Floating Island = "+STRS(WasSSpicked(W,SFloatingIsland));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (WasSSpicked(w,SKillerWasps)=0) %AND (PICKCSORCERY>0) THEN {
  AddAISpell(W,SNagas);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Nagas = "+STRS(WasSSpicked(W,SNagas));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (WasSSpicked(w,SFireBolt)=0) %AND (PICKCSORCERY>0) THEN {
  AddAISpell(W,SPsionicBlast);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Psionic Blast = "+STRS(WasSSpicked(W,SPsionicBlast));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (PICKCSORCERY>0) THEN {
  AddAISpell(W,SResistMagic);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Resist Magic = "+STRS(WasSSpicked(W,SResistMagic));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (WasSSpicked(w,SAnimateAmmo)=0) %AND (PICKCSORCERY>0) THEN {
  AddAISpell(W,SGuardianWind);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Guardian Wind = "+STRS(WasSSpicked(W,SGuardianWind));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (PICKCSORCERY>0) THEN {
  AddAISpell(W,SPhantomWarriors);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Phantom Warriors = "+STRS(WasSSpicked(W,SPhantomWarriors));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF (PICKCSORCERY>0) THEN {
  AddAISpell(W,SBlur);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Blur = "+STRS(WasSSpicked(W,SBlur));
  PICKCSORCERY=PICKCSORCERY-1;
 }
 IF ( ( (BOOKS(W,Sorcery)>7) %AND (PERSONALITY(W)<>Chaotic) ) %OR (PERSONALITY(W)=Lawful) )
  %AND (PICKCSORCERY>0)
 THEN {
  AddAISpell(W,SAuraofMajesty);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Aura of Majesty = "+STRS(WasSSpicked(W,SAuraofMajesty));
  PICKCSORCERY=PICKCSORCERY-1;
 }
}
IF BOOKS(W,Life)>0 THEN {
 IF (PICKCLIFE>0) THEN {
  AddAISpell(W,SHeroism);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Heroism = "+STRS(WasSSpicked(W,SHeroism));
  PICKCLIFE=PICKCLIFE-1;
 }
 IF (PICKCLIFE>0)
  %AND ( WasSSpicked(w,SKillerWasps)
   %OR WasSSpicked(w,SNagas)
   %OR WasSSpicked(w,SHellHounds)
   %OR WasSSpicked(w,SGhouls) )
 THEN {
  AddAISpell(W,SSpiritOfCommunity);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Spirit Of Community = "+STRS(WasSSpicked(W,SSpiritOfCommunity));
  PICKCLIFE=PICKCLIFE-1;
 }
 IF (PICKCLIFE>0) THEN {
  AddAISpell(W,SHeavenlyLight);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Heavenly Light = "+STRS(WasSSpicked(W,SHeavenlyLight));
  PICKCLIFE=PICKCLIFE-1;
 }
 IF (PICKCLIFE>0) THEN {
  AddAISpell(W,SHealing);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Healing = "+STRS(WasSSpicked(W,SHealing));
  PICKCLIFE=PICKCLIFE-1;
 }
 IF (PICKCLIFE>0) THEN {
  AddAISpell(W,SHolyArmor);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Holy Armor = "+STRS(WasSSpicked(W,SHolyArmor));
  PICKCLIFE=PICKCLIFE-1;
 }
 IF (PICKCLIFE>0) THEN {
  AddAISpell(W,SHolyWeapon);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Holy Weapon = "+STRS(WasSSpicked(W,SHolyWeapon));
  PICKCLIFE=PICKCLIFE-1;
 }
}

:
--------------
 UNCOMMONS
--------------
:
IF BOOKS(W,Death)>7 THEN {
 IF (PICKUDEATH>0) THEN {
  AddAISpell(W,SLycanthropy);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Lycanthropy = "+STRS(WasSSpicked(W,SLycanthropy));
  PICKUDEATH=PICKUDEATH-1;
 }
 IF (PICKUDEATH>0) THEN {
  AddAISpell(W,SFrenzy);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Bloodlust = "+STRS(WasSSpicked(W,SFrenzy));
  PICKUDEATH=PICKUDEATH-1;
 }
}
IF (PICKUDEATH>0) THEN {
 AddAISpell(W,SBlackPrayer);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Black Prayer = "+STRS(WasSSpicked(W,SBlackPrayer));
 PICKUDEATH=PICKUDEATH-1;
}
IF (PICKUDEATH>0) THEN {
 AddAISpell(W,SShadowDemons);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Shadow Demons = "+STRS(WasSSpicked(W,SShadowDemons));
 PICKUDEATH=PICKUDEATH-1;
}
IF ( (PERSONALITY(W)=Peaceful) %OR (PERSONALITY(W)=Lawful) %OR (OBJECTIVE(W)=Perfectionist) ) %AND (PICKUDEATH>0) THEN {
 AddAISpell(W,SWallofDarkness);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Wall of Darkness = "+STRS(WasSSpicked(W,SWallofDarkness));
 PICKUDEATH=PICKUDEATH-1;
}
IF WasSSpicked(W,SWraithForm) %AND (PICKUNATURE>0) THEN {
 AddAISpell(W,SCockatrices);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Cockatrices = "+STRS(WasSSpicked(W,SCockatrices));
 PICKUNATURE=PICKUNATURE-1;
}
IF ( RETORT(W,Warlord) %OR RETORT(W,Myrran) )
 %AND (RETORT(W,Alchemist)=0)
 %AND (MINERALS()<>MineralRich)
 %AND (PICKUNATURE>0)
THEN {
 AddAISpell(W,STransmute);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Transmute = "+STRS(WasSSpicked(W,STransmute));
 PICKUNATURE=PICKUNATURE-1;
}
IF (WasSSpicked(w,SCockatrices)=0)
 %AND (RETORT(W,Myrran)=0)
 %AND (RETORT(0,Myrran)=0)
 %AND (PICKUNATURE>0)
THEN {
 AddAISpell(W,SGiantSpiders);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Giant Spiders = "+STRS(WasSSpicked(W,SGiantSpiders));
 PICKUNATURE=PICKUNATURE-1;
}
IF BOOKS(W,Nature)<8 THEN {
 IF (BOOKS(W,Chaos)<2) %AND (BOOKS(W,Death)<2) %AND (PICKUNATURE>0) THEN {
  AddAISpell(W,SCracksCall);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Cracks Call = "+STRS(WasSSpicked(W,SCracksCall));
  PICKUNATURE=PICKUNATURE-1;
 }
 IF (WasSSpicked(w,SShadowDemons)=0) %AND (PICKUNATURE>0) THEN {
  AddAISpell(W,SGreatLizard);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Great Lizard = "+STRS(WasSSpicked(W,SGreatLizard));
  PICKUNATURE=PICKUNATURE-1;
 }
}
IF RETORT(W,Enchanter) THEN {
 IF (PICKUNATURE>0) THEN {
  AddAISpell(W,SColossalStrength);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Colossal Strength = "+STRS(WasSSpicked(W,SColossalStrength));
  PICKUNATURE=PICKUNATURE-1;
 }
 IF (PICKUCHAOS>0) THEN {
  AddAISpell(W,SInsulation);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Insulation = "+STRS(WasSSpicked(W,SInsulation));
  PICKUCHAOS=PICKUCHAOS-1;
 }
}
IF (PICKUNATURE>0) THEN {
 AddAISpell(W,SLandLinking);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Nature Link = "+STRS(WasSSpicked(W,SLandLinking));
 PICKUNATURE=PICKUNATURE-1;
}
