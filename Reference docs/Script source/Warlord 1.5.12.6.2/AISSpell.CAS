}

IF (BOOKS(W,Death)>3) THEN {
 IF WasSSPicked(w,SMindStorm) THEN {
  AddAISpell(W,SAnnihilate);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Annihilate = "+STRS(WasSSpicked(W,SAnnihilate));
 }
 IF (OBJECTIVE(W)=Militarist)
  %OR (OBJECTIVE(W)=Expansionist)
 THEN {
  AddAISpell(W,SDeathReckoning);
