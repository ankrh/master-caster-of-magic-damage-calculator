 } ELSE {
  AddAISpell(W,SGreatUnbinding);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Great Unbinding = "+STRS(WasSSpicked(W,SGreatUnbinding));
 }
}

IF (BOOKS(W,Chaos)>3) THEN {
 IF (WasSSpicked(w,SSurvivalInstinct)) %OR (BOOKS(W,Life)>4) THEN {
  AddAISpell(W,SDoomMastery);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Doom Mastery = "+STRS(WasSSpicked(W,SDoomMastery));
 }
