 %AND (WasSSpicked(w,SUranusBlessing)=0)
 %AND (PICKRSORCERY>0)
THEN {
 AddAISpell(W,SUranusBlessing);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Uranus' Blessing = "+STRS(WasSSpicked(W,SUranusBlessing));
 PICKRSORCERY=PICKRSORCERY-1;
}
IF ( (PERSONALITY(W)=Maniacal) %OR (PERSONALITY(W)=Ruthless) )
 %AND (WasSSpicked(w,SAetherSink)=0)
 %AND (PICKRSORCERY>0)
THEN {
 AddAISpell(W,SAetherSink);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Aether Sink = "+STRS(WasSSpicked(W,SAetherSink));
