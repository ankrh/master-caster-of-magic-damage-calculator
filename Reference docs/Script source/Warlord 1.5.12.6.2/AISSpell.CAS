:
//-----------------------------------------------------------------
// VERY RARES
//-----------------------------------------------------------------
:
IF (BOOKS(W,Nature)>3) THEN {
 AddAISpell(W,SCallLightning);
 ROLL=RND(3);
 IF ROLL=1 THEN {
  AddAISpell(W,SGreatWyrm);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Great Wyrm = "+STRS(WasSSpicked(W,SGreatWyrm));
 } ELSE {
  IF ROLL=2 THEN {
   AddAISpell(W,SColossus);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Colossus = "+STRS(WasSSpicked(W,SColossus));
  } ELSE {
   AddAISpell(W,SBehemoth);
   DEBUGLOG "AI "+STRS(W)+" picks Spell Behemoth = "+STRS(WasSSpicked(W,SBehemoth));
  }
 }
