   DEBUGLOG "AI "+STRS(W)+" picks Spell Chaos Embrace = "+STRS(WasSSpicked(W,SBlazingEyes));
  } ELSE {
   IF (WasSSpicked(w,SChaosSurge)=0) THEN {
    AddAISpell(W,SChaosSurge);
    DEBUGLOG "AI "+STRS(W)+" picks Spell Chaos Surge = "+STRS(WasSSpicked(W,SChaosSurge));
   }
  }
 }
 AddAISpell(W,SGreatDrake);
 DEBUGLOG "AI "+STRS(W)+" picks Spell Great Drake = "+STRS(WasSSpicked(W,SGreatDrake));
 IF RETORT(W,Conjurer) THEN {
  AddAISpell(W,SHydra);
  DEBUGLOG "AI "+STRS(W)+" picks Spell Hydra = "+STRS(WasSSpicked(W,SHydra));
 }
}

