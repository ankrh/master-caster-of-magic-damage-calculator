 IF (MIL>85) %AND (ISBUILT(C,BDock) %AND (ISBUILT(C,BShipYard)=0) %AND (RACE<>RCLizard) %AND (RACE<>RCHawkmen) THEN {
  IF (ISBUILT(C,BSawmill)=0) THEN {
   CHOSEN=BSawmill;
   HALT;
  } ELSE {
   CHOSEN=BShipYard;
   HALT;
  }
 }

