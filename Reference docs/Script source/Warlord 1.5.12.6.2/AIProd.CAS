: INPUT C - The city being processed 
		AIOwncities - how many cities are owned by the owner of this city.
		ISBESTRACE - 1 if the current city is the best race the AI has access to, and the only such city, 0 otherwise.
		SETTLERWANTED - 0 when the AI is not allowed to build a settler in this town for reasons not covered in the script, 1 otherwise
		SHIPYARDWANTED - 1 if the AI has no way to cross the sea and needs to be forced to build their first naval building, 0 otherwise. The first tier naval access building must be in the slot of Ship Yard for this to function correctly.
		SETTLERCONT - Number of settlers owned on the same continent as the city.
		SETTLERPLANE - Same for the entire plane. Both of these values include settlers currently being produced in the AI's other cities.
		AIEnemyCities - Number of cities on the AI's continent owned by other players
 OUTPUT - SETTLERWANTED - 0 if the AI shouldn't build a settler. 1 if they are allowed to.
		CHOSEN - The ID of the building the AI should build, 
		or zero if no mandatory building was chosen in which case...
		BBUILDING - Set to 1 if you want the AI to build a building, and 0 to build a unit.
		if building was chosen building priority scripts will be run to pick one of the buildings.
		units have no script and rely on the priority value in units.ini and some simple hardcoded rules for now.
:

CHOSEN=0; BBUILDING=1;

W=CITYOWNER(C);
POP=POPUNITS(C);
RACE=CITYRACE(C);
GARR=GARRISON(C);
HAVEIRON=OREINRANGE(C,OreIron);
HAVECOAL=OREINRANGE(C,OreCoal);
HAVEMITHRIL=OREINRANGE(C,OreMithril);
HAVEADAMANT=OREINRANGE(C,OreAdamantium);
HAVEORIHALCON=OREINRANGE(C,OreOrihalcon);

MAGICIANSAVAILABLE=1;
IF (RACE=RCBarbarian)
 %OR (RACE=RCDwarf)
 %OR (RACE=RCGnoll)
 %OR (RACE=RCTroll)
 %OR (RACE=RCGoblin)
 THEN {MAGICIANSAVAILABLE=0; }

MILITARYVALUE=0;
IF ISBUILT(C,BLavaSmelter)
 %OR ISBUILT(C,BCaravanserai)
 %OR ISBUILT(C,BBaray)
 %OR ISBUILT(C,BMilitaryWorkshop)
 %OR ISBUILT(C,BIdolOfHeavenlyBull)
 %OR ISBUILT(C,BTreeOfMagic)
 %OR ISBUILT(C,BPoolOfRepentance)
 %OR ISBUILT(C,BDragonMound)
 %OR ISBUILT(C,BAltarOfStorm)
 %OR ISBUILT(C,BAgoge)
 %OR ISBUILT(C,BPoolOfRepentance)
 %OR ISBUILT(C,BAltarOfTheSun)
 %OR ISBUILT(C,BAltarOfTheMoon)
 %OR ISBUILT(C,BFrostClub)
 %OR ISBUILT(C,BBasilica)
 %OR ISBUILT(C,BMotherFungus)
 THEN {
  MILITARYVALUE=MILITARYVALUE+4;
 }
IF (RACE=RCBarbarian) THEN {
 IF (CITYENCHANT(C,CESorcererStone)>-1) THEN {
  MILITARYVALUE=MILITARYVALUE+( (1*HAVEIRON)+(2*HAVECOAL)+(3*HAVEMITHRIL)+(4*HAVEADAMANT)+(5*HAVEORIHALCON) );
 } ELSE {
  MILITARYVALUE=MILITARYVALUE+( (1*HAVEIRON)+(2*HAVECOAL) );
 }
} ELSE {
 MILITARYVALUE=MILITARYVALUE+( (1*HAVEIRON)+(2*HAVECOAL)+(3*HAVEMITHRIL)+(4*HAVEADAMANT)+(5*HAVEORIHALCON) );
}

: Decide if we need more settlers :
IF SETTLERWANTED=0 THEN { GOTO "NONEEDSETTLER"; }

 IF ((ISFORTRESS(C)) %AND (OVERLANDTURN()<=60) %AND (AIOWNCITIES>=4))
  %OR (POP<3) THEN { SETTLERWANTED=0; }
 ELSE {
  I=1;
  IF LANDSIZE()>LandTiny THEN {
   I=2;
   IF (LANDSIZE()>LandSmall) %AND (DIFFICULTY()>=DiffMaster) 
    %AND (SCORINGOPTION(SEqualizer)=0)
    %AND (SCORINGOPTION(SLoner)=0)
    %AND (SCORINGOPTION(SInvertedStart)=0)
    %AND ((RETORT(W,Myrran)) %XOR (RETORT(0,Myrran))) %AND (OVERLANDTURN()<100)
    THEN { I=4; }
   }
  IF (SETTLERCONT<I) %AND (SETTLERPLANE<(I+2)) THEN { SETTLERWANTED=1; }
 ELSE { SETTLERWANTED=0; }
 }
 
!NONEEDSETTLER!


: Mandatory buildings to build before anything else :
IF (ISBUILT(C,BSmithy)=0) THEN {
 CHOSEN=BSmithy;
 HALT;
}

: build Mill in prepare for garrison build up, especially early bowmen :
IF (ISBUILT(C,BSawmill)=0) THEN {
 CHOSEN=BSawmill;
 HALT;
}

: if need ship for naval expansion, build it at this point :
IF (RACE<>RCHawkmen) THEN {
 IF (SHIPYARDWANTED=1) THEN {

  COASTAL=0;

  FOR X=(GETCITYDATA(C,CDCOLX)-1) TO (GETCITYDATA(C,CDCOLX)+1);
  FOR Y=(GETCITYDATA(C,CDCOLY)-1) TO (GETCITYDATA(C,CDCOLY)+1);

   IF ( ( X <> GETCITYDATA(C,CDCOLX) ) %OR ( Y <> GETCITYDATA(C,CDCOLY) ) )
    %AND ( (GETTERRAIN(X,Y,GETCITYDATA(C,CDCOLP))<LTLake)
     %OR (GETTERRAIN(X,Y,GETCITYDATA(C,CDCOLP))=LTRiverMouth) )
   THEN {
    COASTAL=1;
   }

  NEXT Y;
  NEXT X;

  IF (COASTAL=1) THEN {
   CHOSEN=BDock;
   HALT;
  }

 }
} 

IF (ISBUILT(C,BBuilderHall)=0) THEN {
 CHOSEN=BBuilderHall;
 HALT;
}

: everyone except Dwarves, Klackons, Trolls build stable at this point :
IF (RACE=RCBarbarian)
 %OR (RACE=RCBeastmen)
 %OR (RACE=RCDarkElf)
 %OR (RACE=RCDraconian)
 %OR (RACE=RCGnoll)
 %OR (RACE=RCHalfling)
 %OR (RACE=RCHighElf)
 %OR (RACE=RCHighMen)
 %OR (RACE=RCLizard)
 %OR (RACE=RCNomad)
 %OR (RACE=RCOrc)
 %OR (RACE=RCXuanyuan)
 %OR (RACE=RCRakhshasa)
 %OR (RACE=RCHawkmen)
 %OR (RACE=RCGoblin)
 THEN {
 IF (ISBUILT(C,BStables)=0) THEN { 
  CHOSEN=BStables;
  HALT;
 }
}

: everyone except Nomads build granery :
IF (RACE=RCBarbarian)
 %OR (RACE=RCBeastmen)
 %OR (RACE=RCDarkElf)
 %OR (RACE=RCDwarf)
 %OR (RACE=RCDraconian)
 %OR (RACE=RCGnoll)
 %OR (RACE=RCHalfling)
 %OR (RACE=RCHighElf)
 %OR (RACE=RCHighMen)
 %OR (RACE=RCKlackon)
 %OR (RACE=RCLizard)
 %OR (RACE=RCOrc)
 %OR (RACE=RCTroll)
 %OR (RACE=RCXuanyuan)
 %OR (RACE=RCRakhshasa)
 %OR (RACE=RCHawkmen)
 %OR (RACE=RCGoblin)
 THEN {
 IF (ISBUILT(C,BGranary)=0) THEN {
  CHOSEN=BGranary;
  HALT;
 }
}

: High elf and Rakhshasa build forester guild early :
IF (ISBUILT(C,BForesterGuild)=0) %AND (TERRAININRANGE(C,LTForest)>0) THEN {
 IF (RACE=RCHighElf) %OR (RACE=RCRakhshasa) THEN {
  CHOSEN=BForesterGuild;
  HALT;
 } ELSE {
  IF (RND(5)=0) THEN {
   CHOSEN=BForesterGuild;
   HALT;
  }
 }
}

: Early economic buildings :
IF (ISBUILT(C,BMarketplace)=0) THEN {
 CHOSEN=BMarketplace;
 HALT;
}

: everyone except Dwarf build magic market :
IF (RACE=RCBarbarian)
 %OR (RACE=RCBeastmen)
 %OR (RACE=RCDarkElf)
 %OR (RACE=RCDraconian)
 %OR (RACE=RCGnoll)
 %OR (RACE=RCHalfling)
 %OR (RACE=RCHighElf)
 %OR (RACE=RCHighMen)
 %OR (RACE=RCKlackon)
 %OR (RACE=RCLizard)
 %OR (RACE=RCNomad)
 %OR (RACE=RCOrc)
 %OR (RACE=RCTroll)
 %OR (RACE=RCXuanyuan)
 %OR (RACE=RCRakhshasa)
 %OR (RACE=RCHawkmen)
 %OR (RACE=RCGoblin)
 THEN {
 IF (ISBUILT(C,BMarketplace)) %AND (ISBUILT(C,BMagicMarket)=0) THEN {
  CHOSEN=BMagicMarket;
  HALT;
 }
}

: When nolonger want to expand empire with settler, start seriously think about buildings in city :
IF (SETTLERPLANE<2) THEN { GOTO "DONTDEVELOPYET"; }
 IF GARR<4 THEN {
  SETTLERWANTED=0;
  GOTO "DONTDEVELOPYET";
 }
: Alchemist's guild with Philosopher's Stone for low gold :
  IF (CITYENCHANT(C,CESorcererStone)>-1) %AND (GOLD(W)<250) %AND (ISBUILT(C,BLibrary)) %AND (ISBUILT(C,BAlchemistguild)=0) THEN {
   CHOSEN=BAlchemistguild;
   HALT;		
  }

: Monument to prepare for human invasion :
  IF (ISBUILT(C,BMonument)=0) %AND (Difficulty()>=DiffFair) THEN { 
   IF (CONTACT(W,0)) %AND (TREATY(W,0)<>TSPact) %AND (TREATY(W,0)<>TSAlliance)
    %AND (RACE<>RCDwarf) %AND (RACE<>RCHalfling) THEN {
    CHOSEN=BMonument;
    HALT;		
   }
  }

: Value to evaluate game progression :
I=(POPULATION(C)/100)+(DIFFICULTY()*4)+OVERLANDTURN();


: Start of economy section :
  IF Objective(W)=Militarist THEN { ECO=I+10; }
  IF Objective(W)=Expansionist THEN { ECO=I-10; }
  IF Objective(W)=Pragmatist THEN { ECO=I+5; }
  IF Objective(W)=Theurgist THEN { ECO=I+10; }
  IF Objective(W)=Perfectionist THEN { ECO=I+20; }
  IF Objective(W)=Narcissist THEN { ECO=I+10; }
  IF Retort(W,Guardian) THEN { ECO=ECO+10; }
  IF Retort(W,Procurator) THEN { ECO=ECO+5; }

: Start of research section :
  IF Objective(W)=Militarist THEN { RES=I-5; }
  IF Objective(W)=Expansionist THEN { RES=I-10; }
  IF Objective(W)=Pragmatist THEN { RES=I+10; }
  IF Objective(W)=Theurgist THEN { RES=I+40; }
  IF Objective(W)=Perfectionist THEN { RES=I+30; }
  IF Objective(W)=Narcissist THEN { RES=I+20; }
  IF Retort(W,SageMaster) THEN { RES=RES+10; }
  IF Retort(W,Procurator) THEN { RES=RES+5; }

: Start of religion section :
  IF Objective(W)=Militarist THEN { REL=I+10; }
  IF Objective(W)=Expansionist THEN { REL=I+20; }
  IF Objective(W)=Pragmatist THEN { REL=I+5; }
  IF Objective(W)=Theurgist THEN { REL=I-20; }
  IF Objective(W)=Perfectionist THEN { REL=I+15; }
  IF Objective(W)=Narcissist THEN { REL=I+10; }
  IF Retort(W,CultLeader) THEN { REL=REL+10; }
  IF Retort(W,Procurator) THEN { REL=REL+5; }

: Start of military section :
  IF Objective(W)=Militarist THEN { MIL=I+20; }
  IF Objective(W)=Expansionist THEN { MIL=I+10; }
  IF Objective(W)=Pragmatist THEN { MIL=I+0; }
  IF Objective(W)=Theurgist THEN { MIL=I-5; }
  IF Objective(W)=Perfectionist THEN { MIL=I-10; }
  IF Objective(W)=Narcissist THEN { MIL=I-20; }
  IF Retort(W,Warlord) THEN { MIL=MIL+10; }
  IF Retort(W,Tactician) THEN { MIL=MIL+5; }


: Universal religion condition :
  IF (REL>58) %AND (ISBUILT(C,BShrine)=0) THEN {
   CHOSEN=BShrine;
   HALT;
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
  THEN {
   IF (REL>78) %AND (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BShrine)) %AND (ISBUILT(C,BParthenon)=0) THEN {
    CHOSEN=BParthenon;
    HALT;
   }
  }
  IF (RACE=RCBarbarian)
   %OR (RACE=RCGnoll)
   %OR (RACE=RCOrc)
   %OR (RACE=RCTroll)
   %OR (RACE=RCHawkmen)
   %OR (RACE=RCGoblin)
  THEN {
   IF ((REL>81) %OR (MIL>81)) %AND (ISBUILT(C,BMagicMarket)) %AND (ISBUILT(C,BShrine)) %AND (ISBUILT(C,BWitchesConvent)=0) THEN {
    CHOSEN=BWitchesConvent;
    HALT;
   }
  }
  IF (RACE=RCDraconian)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
  THEN {
   IF (REL>108) %AND (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BParthenon)) %AND (ISBUILT(C,BCathedral)=0) THEN {
    CHOSEN=BCathedral;
    HALT;
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
  THEN {
   IF (REL>108) %AND (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BParthenon)) %AND (ISBUILT(C,BTemple)=0) THEN {
    CHOSEN=BTemple;
    HALT;
   }
  }

: Universal research condition :
  IF (RES>60) %AND (ISBUILT(C,BLibrary)=0) THEN {
   CHOSEN=BLibrary;
   HALT;
  }
  IF (RACE=RCBarbarian)
   %OR (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCLizard)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
   %OR (RACE=RCGoblin)
  THEN {
   IF (RES>80) %OR (ECO>70) %OR (MIL>145) THEN {
    IF (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BLibrary)) %AND (ISBUILT(C,BUniversity)=0) THEN {
     CHOSEN=BUniversity;
     HALT;
    }
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCLizard)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
   %OR (RACE=RCGoblin)
  THEN {
   IF (RES>100) %OR (MIL>120) THEN {
    IF (ISBUILT(C,BLibrary)) %AND (ISBUILT(C,BAlchemistguild)=0) THEN {
     CHOSEN=BAlchemistguild;
     HALT;
    }
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCLizard)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
   %OR (RACE=RCGoblin)
  THEN {
   IF (RES>120) %OR (MIL>150) THEN {
    IF (ISBUILT(C,BUniversity)) %AND (ISBUILT(C,BAlchemistguild)) %AND (ISBUILT(C,BSagesGuild)=0) THEN {
     CHOSEN=BSagesGuild;
     HALT;
    }
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCLizard)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
  THEN {
   IF (HASTREE(W)>0) %AND (ISBUILT(C,BMagicMarket)) %AND (ISBUILT(C,BSagesGuild)) %AND (ISBUILT(C,BWizardsGuild)=0) THEN {
    IF (HASGLOBAL(W,GEMagocracy)>0) %AND (ECO>80) THEN {
     CHOSEN=BWizardsGuild;
     HALT;
    } ELSE {
     IF (RES>140) %OR (MIL>165) THEN {
      CHOSEN=BWizardsGuild;
      HALT;
     }
    }
   }
  }


: Universal economy condition :
  IF (RACE<>RCNomad)
   %AND (RACE<>RCGoblin)
  THEN {
   IF (ECO>60) %AND (ISBUILT(C,BMarketplace)) %AND (ISBUILT(C,BGranary)) %AND (ISBUILT(C,BFarmerMarket)=0) THEN {
    CHOSEN=BFarmerMarket;
    HALT;
   }
  }
  IF (RACE=RCBarbarian)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCGnoll)
   %OR (RACE=RCTroll)
  THEN {
   IF (ECO>80) %AND (ISBUILT(C,BAnimistGuild)) %AND (ISBUILT(C,BFarmerMarket)) %AND (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BBrewery)=0) THEN {
    CHOSEN=BBrewery;
    HALT;
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCGoblin)
  THEN {
   IF (ECO>90) %AND (ISBUILT(C,BMarketplace)) %AND (ISBUILT(C,BUniversity)) %AND (ISBUILT(C,BBank)=0) THEN {
    CHOSEN=BBank;
    HALT;
   }
  }
  IF (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCHalfling)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
  THEN {
   IF (ECO>110) %AND (ISBUILT(C,BBank)) %AND (ISBUILT(C,BMerchantGuild)=0) THEN {
    IF (ISBUILT(C,BDock)) %AND (ISBUILT(C,BShipyard)=0) THEN {
     CHOSEN=BShipyard;
     HALT;
    } ELSE {
     IF (ISBUILT(C,BShipyard)) THEN {
      CHOSEN=BMerchantGuild;
      HALT;
     }
    }
   }
  }


: Universal military condition :
  IF (MIL>55) %AND (ISBUILT(C,BArmory)=0) THEN {
   CHOSEN=BArmory;
   HALT;
  }
  IF (MIL>75) %AND (ISBUILT(C,BArmory)) %AND (ISBUILT(C,BFighterGuild)=0) THEN {
   CHOSEN=BFighterGuild;
   HALT;
  }
  IF (RACE=RCBarbarian)
   %OR (RACE=RCBeastmen)
   %OR (RACE=RCDarkElf)
   %OR (RACE=RCDwarf)
   %OR (RACE=RCDraconian)
   %OR (RACE=RCGnoll)
   %OR (RACE=RCHighElf)
   %OR (RACE=RCHighMen)
   %OR (RACE=RCKlackon)
   %OR (RACE=RCLizard)
   %OR (RACE=RCNomad)
   %OR (RACE=RCOrc)
   %OR (RACE=RCTroll)
   %OR (RACE=RCXuanyuan)
   %OR (RACE=RCRakhshasa)
   %OR (RACE=RCHawkmen)
   %OR (RACE=RCGoblin)
  THEN {
   IF (MIL>95) %AND (ISBUILT(C,BArmory)) %AND (ISBUILT(C,BBarracks)=0) THEN {
    CHOSEN=BBarracks;
    HALT;
   }
   IF (MILITARYVALUE>0) %AND (MIL>125) %AND (ISBUILT(C,BBarracks)) %AND (ISBUILT(C,BFighterGuild)) %AND (ISBUILT(C,BWarCollege)=0) THEN {
    CHOSEN=BWarCollege;
    HALT;
   }
  }
  IF (RACE=RCBarbarian)
   %OR (RACE=RCGnoll)
   %OR (RACE=RCTroll)
   %OR (RACE=RCGoblin)
  THEN {
   IF (MILITARYVALUE>0) %AND (MIL>135) %AND (ISBUILT(C,BWarCollege)) %AND (ISBUILT(C,BBuilderHall)) %AND (ISBUILT(C,BWarlordHold)=0) THEN {
    CHOSEN=BWarlordHold;
    HALT;
   }
  }
  IF (HASTREE(W)=0) THEN { GOTO "NOTREE"; }
   IF (RACE=RCBeastmen)
    %OR (RACE=RCDarkElf)
    %OR (RACE=RCDwarf)
    %OR (RACE=RCDraconian)
    %OR (RACE=RCHighElf)
    %OR (RACE=RCHighMen)
    %OR (RACE=RCKlackon)
    %OR (RACE=RCLizard)
    %OR (RACE=RCNomad)
    %OR (RACE=RCOrc)
    %OR (RACE=RCTroll)
    %OR (RACE=RCXuanyuan)
    %OR (RACE=RCRakhshasa)
    %OR (RACE=RCHawkmen)
   THEN {
    IF (MILITARYVALUE>0) %AND (MIL>115) %AND (ISBUILT(C,BFighterGuild)) %AND (ISBUILT(C,BSmithy)) %AND (ISBUILT(C,BArmorerGuild)=0) THEN {
     CHOSEN=BArmorerGuild;
     HALT;
    }
   }
   IF (RACE=RCBeastmen)
    %OR (RACE=RCDarkElf)
    %OR (RACE=RCHalfling)
    %OR (RACE=RCHighElf)
    %OR (RACE=RCNomad)
    %OR (RACE=RCOrc)
    %OR (RACE=RCXuanyuan)
    %OR (RACE=RCRakhshasa)
   THEN {
