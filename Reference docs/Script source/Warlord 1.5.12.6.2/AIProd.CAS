   IF (ISBUILT(C,BShrine)) %AND (ISBUILT(C,BMagicMarket)) %AND (ISBUILT(C,BWitchesConvent)=0) THEN {
    CHOSEN=BWitchesConvent;
    HALT;
   }
   IF (HASTREE(W)=0) THEN { GOTO "GOBLINNOTREE"; }
: Build unique building :
    IF (TERRAININRANGE(C,LTSwamp)>0) %AND (ISBUILT(C,BWitchesConvent)) %AND (ISBUILT(C,BMotherFungus)=0) THEN {
     CHOSEN=BMotherFungus
     HALT;
    }
: Allow Doom Wheels and Gliders :
    IF (ISBUILT(C,BUniversity)) %AND (ISBUILT(C,BMinerGuild)) %AND (ISBUILT(C,BMechaGuild)=0) THEN {
     CHOSEN=BMechaGuild;
     HALT;
    }
    IF (ISBUILT(C,BSagesGuild)) %AND (ISBUILT(C,BMechaGuild)) %AND (ISBUILT(C,BHangar)=0) THEN {
     CHOSEN=BHangar;
     HALT;
    }
: Allow Midget Submarines :
    IF (ISBUILT(C,BSawmill)=0) THEN {
     CHOSEN=BSawmill;
     HALT;
    }
    IF (ISBUILT(C,BDock)) %AND (ISBUILT(C,BSawmill)) %AND (ISBUILT(C,BShipyard)=0) THEN {
     CHOSEN=BShipyard;
     HALT;
    }
   !GOBLINNOTREE!
  !NOTGOBLIN!

 !NOTMILITARYCITY!

!DONTDEVELOPYET!

: City Wall for Fortress :

IF (ISFORTRESS(C)=0) THEN { GOTO "NOTFORTRESS"; }

 IF DIFFICULTY()>=DiffExpert THEN {

  IF (RACE=RCHawkmen)
   %AND (ISBUILT(C,BHillfort)=0)
   %AND OVERLANDTURN()>=40
  THEN {

   IF (ISBUILT(C,BStables)=0) THEN {
    CHOSEN=BStables;
    HALT;
   } ELSE {
    IF (ISBUILT(C,BMinerGuild)=0) THEN {
     CHOSEN=BMinerGuild;
     HALT;
    } ELSE {
     CHOSEN=BHillfort;
     HALT;
    }
   }

  } ELSE {

   IF (ISBUILT(C,BCityWalls)=0)
    %AND OVERLANDTURN()>=40
   THEN {
    CHOSEN=BCityWalls;
    HALT;
   }

  }

 }

!NOTFORTRESS!

: Decision for producing a unit or a building :

UPRIO=0;

IF CITYENCHANT(C,CEAltarOfBattle)>-1 THEN {
 UPRIO=UPRIO+8; 
} ELSE {
 IF CITYENCHANT(C,CEEvilPresence)=-1 THEN {
  IF ISBUILT(C,BWarCollege) THEN {
   UPRIO=UPRIO+4;
  } ELSE {
   IF ISBUILT(C,BBarracks) THEN { UPRIO=UPRIO+2; }
  }
 }
}

If ISBUILT(C,BSmithy) THEN {
 UPRIO=UPRIO+1;
}

: High elf should train a lot of longbowmen :
IF (RACE=RCHighElf) %AND ISBUILT(C,BForesterGuild) THEN { UPRIO=UPRIO+2; }

: Hawkman should train a lot of Sky Lantern if has Altar of the Sun :
IF (RACE=RCHawkmen) %AND ISBUILT(C,BHangar) %AND ISBUILT(C,BAltarOfTheSun) THEN {
 IF HASGLOBAL(W,GEMarinerMastery) THEN {
  UPRIO=UPRIO+18;
 } ELSE {
  UPRIO=UPRIO+(9-GARR)*2;
 }
}

IF ISBUILT(C,BStables) THEN {
 UPRIO=UPRIO+1;
 IF (RACE=RCGnoll) %OR (RACE=RCNomad) THEN { UPRIO=UPRIO+2; }
}

IF ISBUILT(C,BArmory) THEN {
 UPRIO=UPRIO+2;
}

IF ISBUILT(C,BFighterGuild) THEN {
 UPRIO=UPRIO+2;
 IF RACE=RCDarkElf THEN { UPRIO=UPRIO+2; }
 IF RACE=RCGnoll THEN { UPRIO=UPRIO+3; }
 IF RACE=RCBarbarian THEN { UPRIO=UPRIO+6; }
}

IF ISBUILT(C,BArmorerGuild) THEN {
 UPRIO=UPRIO+6;
}
IF ISBUILT(C,BFantasticStables) THEN {
 UPRIO=UPRIO+6;
}

IF ISBUILT(C,BLavaSmelter)
 %OR ISBUILT(C,BCaravanserai)
 %OR ISBUILT(C,BBaray)
 %OR ISBUILT(C,BMilitaryWorkshop)
 %OR ISBUILT(C,BIdolOfHeavenlyBull)
 %OR ISBUILT(C,BTreeOfMagic)
 %OR ISBUILT(C,BPoolOfRepentance)
 %OR ISBUILT(C,BDragonMound)
 %OR ISBUILT(C,BAltarOfStorm)
 %OR ISBUILT(C,BAgoge)
 %OR ISBUILT(C,BPoolOfRepentance)
 %OR ISBUILT(C,BAltarOfTheSun)
 %OR ISBUILT(C,BAltarOfTheMoon)
 %OR ISBUILT(C,BFrostClub)
 %OR ISBUILT(C,BBasilica)
 %OR ISBUILT(C,BMotherFungus)
THEN {
 UPRIO=UPRIO+4;
} ELSE {
 UPRIO=UPRIO-2;
}

IF (CITYENCHANT(C,CEPillarOfFaith)>-1) THEN {
 FAITH=0;
 IF (CITYENCHANT(C,CEHeavenlyLight)>-1) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BShrine) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BParthenon) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BWitchesConvent) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BCathedral) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BTemple) THEN { FAITH=FAITH+1; }
 IF HASGLOBAL(W,GEKingOfUnderworld) %AND ISBUILT(C,BOracle) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BAltarOfStorm) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BAltarOfTheSun) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BAltarOfTheMoon) THEN { FAITH=FAITH+1; }
 IF ISBUILT(C,BBasilica) THEN { FAITH=FAITH+1; }
 UPRIO=UPRIO+FAITH;
} ELSE {
 IF (SPELLSTATE(W,SPillarOfFaith)>0) THEN {
  WAIT=1;
  : In book :
  IF (SPELLSTATE(W,SPillarOfFaith)=1) THEN { WAIT=WAIT+1; }
  : On research page :
  IF (SPELLSTATE(W,SPillarOfFaith)=3) THEN { WAIT=WAIT+2; }
  : already researched :
  IF (SPELLSTATE(W,SPillarOfFaith)=2) THEN { WAIT=WAIT+3; }
  UPRIO=UPRIO-WAIT;
 }
}

IF (MILITARYVALUE<1) THEN {
 UPRIO=UPRIO-4;
}

IF PERSONALITY(W)=Militarist THEN {UPRIO=UPRIO+4;}
IF OBJECTIVE(W)=Perfectionist THEN {UPRIO=UPRIO-3;}

IF UPRIO<0 THEN { UPRIO=0; }
UPRIO=UPRIO+7;

IF DIFFICULTY()<=DiffNormal THEN { UPRIO=UPRIO-1; }
IF DIFFICULTY()<=DiffEasy THEN { UPRIO=UPRIO-2; }

IF (SCORINGOPTION(SEqualizer)=0)
 %AND (SCORINGOPTION(SLoner)=0)
 %AND (SCORINGOPTION(SInvertedStart)=0)
THEN {
 IF ( ( (RETORT(0,Myrran)=0) %AND (RETORT(W,Myrran)) )
  %OR ( (RETORT(0,Myrran)) %AND (RETORT(W,Myrran)=0) ) )
 THEN {
  UPRIO=UPRIO+3;
 }
}

IF GARR<6 THEN { UPRIO=UPRIO+(6-GARR)*2; }

BBUILDING=((RND(UPRIO)+1)<=GARRISON(C));

IF (DIFFICULTY()<DiffAdvanced) THEN { GOTO "LESSTHANADVANCED"; }

 IF (CITYENCHANT(C,CEEvilPresence)=-1) %AND ISBUILT(C,BAlchemistGuild)) THEN {
  UPRIO=UPRIO+3;
  IF HaveAdamant>0 THEN {UPRIO=UPRIO*2 ;}
  ELSE { IF HaveMithril>0 THEN {UPRIO=%I(UPRIO*1.5);}}
  IF HaveOrihalcon>0 THEN {
   UPRIO=UPRIO+3;
   IF (MagiciansAvailable>0) %AND (ISBUILT(C,BWizardsGuild)) THEN { UPRIO=UPRIO+4; }
  }
 }
 IF (MagiciansAvailable>0) %AND (ISBUILT(C,BWizardsGuild)) THEN { UPRIO=UPRIO+2; }

 I=(HaveIron+2*HaveCoal); If I>6 THEN {I=6;}
 UPRIO=UPRIO+I;

 IF (AIEnemyCities>=AIOwncities) %OR (ISBUILT(C,BWarlordHold)) THEN { UPRIO=UPRIO*2;}

 IF (AIenemycities>=AIowncities*2) %and (ISBUILT(C,BFighterGuild)) THEN {
  IF (Race<>RCBarbarian) %AND (ISBUILT(C,BAlchemistGuild)=0) %AND (ISBUILT(C,BLibrary)) THEN {
   CHOSEN=BAlchemistGuild;
   HALT;
  }
 BBUILDING=0;
 IF (Race<>RCBarbarian) %AND (ISBUILT(C,BAlchemistGuild)=0) THEN { BBUILDING=1; }
 }

!LESSTHANADVANCED!

IF GARR<4 THEN {
 BBUILDING=0;
} ELSE {
 : If city has low military value and not very need of troops, it would go for trade goods instead of excess unit :
 IF (MILITARYVALUE<4)
  %AND (ISFORTRESS(C)=0)
  %AND (AISTRATEGY(W,4)>0)
  %AND (BBUILDING=0)
  %AND (ISBUILT(C,BWarlordHold)=0)
 THEN {
  CHOSEN=BTradeGoods;
  HALT;
 }
}

DEBUGLOG "BBUILDING=" + STRS(BBUILDING); 

 